---
const steps = [
  {
    step: '01',
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>`,
    title: 'Cuéntanos tu equipo',
    desc: 'Dinos si usarás TV Box, Fire Stick, Android TV, celular o tablet. Con eso te indicamos el camino correcto.',
  },
  {
    step: '02',
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="4" width="22" height="16" rx="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>`,
    title: 'Confirma plan y pago',
    desc: 'Elige mensual o anual, paga con PayPal o tarjeta de crédito/débito y compártenos la confirmación por el mismo chat.',
  },
  {
    step: '03',
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="5 3 19 12 5 21 5 3"/></svg>`,
    title: 'Déjalo instalado',
    desc: 'Recibes tus datos de acceso y te acompañamos hasta que la app quede lista en tu pantalla.',
  },
];
---
<section class="how" id="ventajas">
  <div class="inner">
    <h2 class="section-title reveal">Lo activamos <em>contigo por chat</em></h2>
    <p class="section-sub reveal">Sin visita técnica, sin formularios largos, sin adivinar qué instalar</p>

    <div class="how-grid">
      {steps.map(s => (
        <div class="how-card reveal" data-step={s.step}>
          <div class="how-icon" aria-hidden="true">
            <Fragment set:html={s.icon} />
          </div>
          <h4>{s.title}</h4>
          <p>{s.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>
