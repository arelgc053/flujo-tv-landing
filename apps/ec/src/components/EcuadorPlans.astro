---
interface Plan {
  id: string;
  label: string;
  price: string;
  badge?: string;
  bonus?: string;
  featured?: boolean;
}

interface Props {
  currency: string;
  plans: Plan[];
  whatsapp: string;
  brand: string;
  features: string[];
  paymentMethods: string[];
}

const { currency, plans, whatsapp, brand, features, paymentMethods } = Astro.props;

const checkIcon = `<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>`;
const waIcon = `<svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>`;
const badgeIcon = `<svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"/></svg>`;
---
<section class="plans" id="planes">
  <div class="inner">
    <h2 class="section-title reveal">Elige cómo <em>quieres verlo</em></h2>
    <p class="section-sub reveal">Un plan para cada forma de disfrutarlo — mismo contenido en los 4</p>

    <div class="plans-grid plans-grid-4">
      {plans.map(plan => {
        const waText = `Hola, quiero el plan ${plan.label} de ${brand} (${currency}${plan.price})`;
        const wa = `https://wa.me/${whatsapp}?text=${encodeURIComponent(waText)}`;
        return (
          <div class:list={['plan-card', 'reveal', { featured: plan.featured }]}>
            {plan.badge && (
              <div class="plan-badge">
                <Fragment set:html={badgeIcon} />
                {plan.badge}
              </div>
            )}
            <p class="plan-name">{plan.label}</p>
            <p class="plan-offer"><sup>{currency}</sup>{plan.price}</p>
            {plan.bonus && <p class="plan-saving">{plan.bonus}</p>}
            <ul class="plan-features">
              {features.map(f => (
                <li class="plan-feature">
                  <Fragment set:html={checkIcon} />{f}
                </li>
              ))}
            </ul>
            <a href={wa} target="_blank" rel="noopener noreferrer" class="plan-btn">
              <Fragment set:html={waIcon} />
              Elegir {plan.label}
            </a>
          </div>
        );
      })}
    </div>

    <p class="plans-note reveal">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
      Todos los planes incluyen el mismo contenido — solo cambia la duración.
    </p>
    <div class="plans-payment reveal">
      <span style="font-size:0.78rem;color:var(--text-muted);">Pagos disponibles en Ecuador:</span>
      {paymentMethods.map(m => <span class="payment-badge">{m}</span>)}
    </div>
  </div>
</section>
