---
import                          '../global.css';
import BaseLayout          from '../layouts/BaseLayout.astro';
import FAQ                 from '@shared/components/FAQ.astro';
import Footer              from '@shared/components/Footer.astro';
import EcuadorNavbar       from '../components/EcuadorNavbar.astro';
import EcuadorHero         from '../components/EcuadorHero.astro';
import EcuadorPlans        from '../components/EcuadorPlans.astro';
import ActivationStrip     from '../components/ActivationStrip.astro';
import EcuadorShowcase     from '../components/EcuadorShowcase.astro';
import EcuadorDevices      from '../components/EcuadorDevices.astro';
import BeforePaying         from '@shared/components/BeforePaying.astro';
import EcuadorHowItWorks   from '../components/EcuadorHowItWorks.astro';
import EcuadorCTAFinal     from '../components/EcuadorCTAFinal.astro';
import EcuadorWhatsAppFloat from '../components/EcuadorWhatsAppFloat.astro';
import EcuadorStickyMobileCTA from '../components/EcuadorStickyMobileCTA.astro';
import EcuadorInternalSeoLinks from '../components/EcuadorInternalSeoLinks.astro';
import { internalSeoLinks } from '../internalLinks';
import { STELLA_EC } from '../stella.config';
import SellerNotice from '@shared/components/SellerNotice.astro';
import Downloads from '@shared/components/Downloads.astro';
import { waTag } from '@shared/lib/wa';
import { EC_FOOTER_PAGES, EC_SITE_LINKS } from '../site';

const TAG = waTag('EC', 'DEPORTES');
const monthly = STELLA_EC.plans[0];

const faqItems = [
  {
    q: '¿Qué deportes puedo ver por internet con Stella TV en Ecuador?',
    a: 'Partidos y competencias de distintas disciplinas en vivo, directamente desde tu TV Box, Fire TV, celular o tablet. Sin cable ni antena, solo conexión a internet.',
  },
  {
    q: '¿Puedo consultar si un partido o evento está disponible?',
    a: 'Sí. Escríbenos por WhatsApp antes de contratar y te confirmamos si el evento que buscas está en la programación.',
  },
  {
    q: '¿La señal aguanta bien en partidos importantes?',
    a: 'Con una conexión de al menos 10 Mbps la señal se mantiene estable. La mayoría de usuarios en Ecuador tienen buena experiencia viendo deportes en vivo; si hay algún problema, soporte responde por WhatsApp en minutos.',
  },
  {
    q: '¿Qué internet necesito para ver deportes en HD o 4K?',
    a: 'Recomendamos mínimo 10 Mbps para HD y 25 Mbps para 4K. Funciona con cualquier proveedor de internet de Ecuador. Si tu señal es inestable, el servicio se adapta para reducir cortes.',
  },
  {
    q: '¿Puedo ver deportes desde mi celular si estoy fuera de casa?',
    a: 'Sí. Stella TV es compatible con celulares y tablets Android, así que puedes seguir tus partidos favoritos con datos móviles o WiFi estés donde estés.',
  },
  {
    q: '¿Cuánto cuesta ver deportes por internet en Ecuador?',
    a: `Desde $${monthly.price} al mes con el plan mensual, o desde $${STELLA_EC.plans[3].price} al año si prefieres ahorrar viendo deportes todo el año.`,
  },
  {
    q: '¿Debo activar algo especial antes de un partido importante?',
    a: 'No, pero te recomendamos probar tu dispositivo con anticipación. Si tienes dudas, escríbenos por WhatsApp antes del partido y revisamos contigo la señal y la instalación.',
  },
  {
    q: '¿Funciona en TV Box, Fire Stick y Android TV?',
    a: 'Sí. Stella TV es compatible con TV Box Android, Amazon Fire Stick y Android TV. Te guiamos por WhatsApp para dejarlo listo antes del próximo partido.',
  },
];

const productSchema = {
  name: 'Stella TV — Deportes y Fútbol por Internet en Ecuador',
  description: 'Ve fútbol y otros deportes en vivo por internet en Ecuador, sin cable, desde $9 al mes. Pago en USD, activación por WhatsApp.',
  price: monthly.price,
  priceCurrency: 'USD',
};


const breadcrumb = [
  { name: 'Inicio', url: 'https://ec.oleadatvplus.com/' },
  { name: 'Deportes por Internet', url: 'https://ec.oleadatvplus.com/ver-deportes-por-internet-ecuador' },
];
---
<BaseLayout
  title={`Ver Deportes por Internet en Ecuador — ${STELLA_EC.brand} | Fútbol en Vivo`}
  description="Ve fútbol y otros deportes en vivo por internet en Ecuador, sin cable. Desde $9 al mes, pago en USD y activación guiada por WhatsApp."
  keywords="ver deportes por internet ecuador, futbol en vivo ecuador, deportes en vivo ecuador, ver futbol ecuatoriano online, deportes online quito, deportes online guayaquil, tv deportiva por internet ecuador, ver liga pro ecuador online"
  canonical="https://ec.oleadatvplus.com/ver-deportes-por-internet-ecuador"
  country="EC"
  whatsapp={STELLA_EC.whatsapp}
  themeColor="#00C853"
  lang="es-EC"
  locale="es_EC"
  geoRegion="EC"
  geoPlacename="Ecuador"
  geoPosition="-1.8312;-78.1834"
  faqSchema={faqItems}
  productSchema={productSchema}
  organization={{ telephone: `+${STELLA_EC.whatsapp}`, areaServed: STELLA_EC.areaServed }}
  breadcrumb={breadcrumb}
/>

<SellerNotice country="Ecuador" />
<EcuadorNavbar whatsapp={STELLA_EC.whatsapp} waTag={TAG} />

<main>
  <EcuadorHero
    whatsapp={STELLA_EC.whatsapp}
    waTag={TAG}
    country="Ecuador"
    currency={STELLA_EC.currency}
    monthlyOffer={monthly.price}
    badge="Deportes en vivo en tu pantalla"
    headlineTop="Tus deportes en vivo,"
    headlineEm="sin cable ni antena"
    sub="Partidos y competencias en vivo desde tu TV Box, Fire TV, celular o tablet. Activación guiada por WhatsApp y pago en dólares."
    waText="Hola, quiero ver deportes y fútbol en vivo con Stella TV en Ecuador"
  />

  <ActivationStrip
    whatsapp={STELLA_EC.whatsapp}
    waTag={TAG}
    paymentMethods={STELLA_EC.paymentMethods}
  />

  <EcuadorPlans
    currency={STELLA_EC.currency}
    plans={STELLA_EC.plans}
    whatsapp={STELLA_EC.whatsapp}
    waTag={TAG}
    brand={STELLA_EC.brand}
    features={STELLA_EC.planFeatures}
    paymentMethods={STELLA_EC.paymentMethods}
  />

  <EcuadorShowcase />

  <EcuadorDevices />

  <BeforePaying whatsapp={STELLA_EC.whatsapp} waTag={TAG} paymentText={STELLA_EC.beforePayingText} />

  <EcuadorHowItWorks />

  <Downloads whatsapp={STELLA_EC.whatsapp} waTag={TAG} guideHref="/instalar-stella-tv" />

  <FAQ items={faqItems} />

  <EcuadorCTAFinal
    whatsapp={STELLA_EC.whatsapp}
    waTag={TAG}
    currency={STELLA_EC.currency}
    monthlyOffer={monthly.price}
  />

  <EcuadorInternalSeoLinks links={internalSeoLinks.verDeportesPorInternetEcuador} />
</main>

<Footer whatsapp={STELLA_EC.whatsapp} waTag={TAG} country="Ecuador" pageLinks={EC_FOOTER_PAGES} siteLinks={EC_SITE_LINKS} />

<EcuadorWhatsAppFloat whatsapp={STELLA_EC.whatsapp} waTag={TAG} />

<EcuadorStickyMobileCTA
  whatsapp={STELLA_EC.whatsapp}
  waTag={TAG}
  currency={STELLA_EC.currency}
  monthlyOffer={monthly.price}
/>
