---
import                          '../global.css';
import BaseLayout          from '../layouts/BaseLayout.astro';
import FAQ                 from '@shared/components/FAQ.astro';
import Footer              from '@shared/components/Footer.astro';
import EcuadorNavbar       from '../components/EcuadorNavbar.astro';
import EcuadorHero         from '../components/EcuadorHero.astro';
import EcuadorPlans        from '../components/EcuadorPlans.astro';
import ActivationStrip     from '../components/ActivationStrip.astro';
import EcuadorShowcase     from '../components/EcuadorShowcase.astro';
import EcuadorDevices      from '../components/EcuadorDevices.astro';
import BeforePaying         from '@shared/components/BeforePaying.astro';
import EcuadorHowItWorks   from '../components/EcuadorHowItWorks.astro';
import EcuadorCTAFinal     from '../components/EcuadorCTAFinal.astro';
import EcuadorWhatsAppFloat from '../components/EcuadorWhatsAppFloat.astro';
import EcuadorStickyMobileCTA from '../components/EcuadorStickyMobileCTA.astro';
import EcuadorInternalSeoLinks from '../components/EcuadorInternalSeoLinks.astro';
import { internalSeoLinks } from '../internalLinks';
import { STELLA_EC } from '../stella.config';
import SellerNotice from '@shared/components/SellerNotice.astro';
import Downloads from '@shared/components/Downloads.astro';
import { waTag } from '@shared/lib/wa';
import { EC_FOOTER_PAGES, EC_SITE_LINKS } from '../site';

const TAG = waTag('EC', 'TV-POR-INTERNET');
const monthly = STELLA_EC.plans[0];

const faqItems = [
  {
    q: '¿En qué se diferencia la TV por internet del cable tradicional en Ecuador?',
    a: 'No tiene contrato mínimo, se activa el mismo día por WhatsApp y funciona en TV, celular y tablet Android. El cable tradicional suele exigir permanencia y visita técnica.',
  },
  {
    q: '¿Cuánto se ahorra al cambiar a Stella TV en Ecuador?',
    a: `Con Stella TV pagas desde $${monthly.price} al mes, y con el plan de 12 meses ($${STELLA_EC.plans[3].price} con 2 meses gratis) el mes sale más barato. Cuánto ahorras depende de lo que pagas hoy por tu cable: compara tu factura con estos precios.`,
  },
  {
    q: '¿TV por internet funciona en todo Ecuador?',
    a: 'Sí. Stella TV funciona en Quito, Guayaquil, Cuenca, Ambato, Manta, Portoviejo, Loja, Esmeraldas y cualquier ciudad de Ecuador que tenga internet. Solo necesitas una conexión estable.',
  },
  {
    q: '¿Incluye deportes en vivo?',
    a: 'Sí, incluye partidos y competencias de distintas disciplinas en vivo desde tu TV Box, Fire TV o celular. Si buscas un evento específico, consúltanos por WhatsApp antes de contratar.',
  },
  {
    q: '¿Incluye contenido para toda la familia?',
    a: 'Sí. Stella TV incluye canales de entretenimiento infantil, series, películas y deportes. Toda la familia encuentra algo que ver en una sola cuenta.',
  },
  {
    q: '¿Cómo pago desde Ecuador?',
    a: 'Por transferencia bancaria desde Banco Pichincha o Banco Guayaquil. Te enviamos los datos de pago por WhatsApp y, en cuanto se confirma, continuamos con la activación por el mismo chat.',
  },
  {
    q: '¿Necesito contratar un técnico para instalarlo?',
    a: 'No. La activación es 100% remota por WhatsApp. Te guiamos paso a paso para instalarlo en tu TV Box, Fire Stick, Android TV o celular sin visitas técnicas.',
  },
  {
    q: '¿Qué pasa si quiero dejar de usarlo?',
    a: 'No hay contrato ni permanencia. Simplemente no renuevas el mes siguiente. Puedes volver a activarlo cuando quieras.',
  },
  {
    q: '¿Funciona bien fuera de Quito o Guayaquil?',
    a: 'Sí. En cualquier ciudad o cantón de Ecuador con internet de al menos 10 Mbps, Stella TV funciona sin problema.',
  },
];

const productSchema = {
  name: 'Stella TV — Alternativa al Cable en Ecuador',
  description: 'TV por internet en Ecuador como alternativa al cable tradicional, con activación guiada por WhatsApp y pagos en USD. Desde $9 al mes.',
  price: monthly.price,
  priceCurrency: 'USD',
};


const breadcrumb = [
  { name: 'Inicio', url: 'https://ec.oleadatvplus.com/' },
  { name: 'TV por Internet en Ecuador', url: 'https://ec.oleadatvplus.com/tv-por-internet-ecuador' },
];
---
<BaseLayout
  title={`TV por Internet en Ecuador — ${STELLA_EC.brand} | Alternativa al Cable desde $9`}
  description="Cambia el cable por TV por internet en Ecuador. Canales, cine, series y deportes en vivo desde $9 al mes. Pago en USD, activación por WhatsApp."
  keywords="tv por internet ecuador, alternativa cable tv ecuador, tv online ecuador, canales por internet ecuador, tv sin cable ecuador, dejar el cable ecuador, tv internet quito, tv internet guayaquil, tv internet cuenca, oleada tv ecuador precio"
  canonical="https://ec.oleadatvplus.com/tv-por-internet-ecuador"
  country="EC"
  whatsapp={STELLA_EC.whatsapp}
  themeColor="#00C853"
  lang="es-EC"
  locale="es_EC"
  geoRegion="EC"
  geoPlacename="Ecuador"
  geoPosition="-1.8312;-78.1834"
  faqSchema={faqItems}
  productSchema={productSchema}
  organization={{ telephone: `+${STELLA_EC.whatsapp}`, areaServed: STELLA_EC.areaServed }}
  breadcrumb={breadcrumb}
/>

<SellerNotice country="Ecuador" />
<EcuadorNavbar whatsapp={STELLA_EC.whatsapp} waTag={TAG} />

<main>
  <EcuadorHero
    whatsapp={STELLA_EC.whatsapp}
    waTag={TAG}
    country="Ecuador"
    currency={STELLA_EC.currency}
    monthlyOffer={monthly.price}
    badge="La alternativa al cable en todo Ecuador"
    headlineTop="Deja el cable y paga"
    headlineEm="menos por más entretenimiento"
    sub="TV por internet en Ecuador sin contrato ni visitas técnicas: canales, cine, series y deportes en vivo desde tu TV Box, Fire TV o Android."
    waText="Hola, quiero cambiar el cable por Stella TV en Ecuador"
  />

  <ActivationStrip
    whatsapp={STELLA_EC.whatsapp}
    waTag={TAG}
    paymentMethods={STELLA_EC.paymentMethods}
  />

  <EcuadorPlans
    currency={STELLA_EC.currency}
    plans={STELLA_EC.plans}
    whatsapp={STELLA_EC.whatsapp}
    waTag={TAG}
    brand={STELLA_EC.brand}
    features={STELLA_EC.planFeatures}
    paymentMethods={STELLA_EC.paymentMethods}
  />

  <EcuadorShowcase />

  <EcuadorDevices />

  <BeforePaying whatsapp={STELLA_EC.whatsapp} waTag={TAG} paymentText={STELLA_EC.beforePayingText} />

  <EcuadorHowItWorks />

  <Downloads whatsapp={STELLA_EC.whatsapp} waTag={TAG} guideHref="/instalar-stella-tv" />

  <FAQ items={faqItems} />

  <EcuadorCTAFinal
    whatsapp={STELLA_EC.whatsapp}
    waTag={TAG}
    currency={STELLA_EC.currency}
    monthlyOffer={monthly.price}
  />

  <EcuadorInternalSeoLinks links={internalSeoLinks.tvPorInternetEcuador} />
</main>

<Footer whatsapp={STELLA_EC.whatsapp} waTag={TAG} country="Ecuador" pageLinks={EC_FOOTER_PAGES} siteLinks={EC_SITE_LINKS} />

<EcuadorWhatsAppFloat whatsapp={STELLA_EC.whatsapp} waTag={TAG} />

<EcuadorStickyMobileCTA
  whatsapp={STELLA_EC.whatsapp}
  waTag={TAG}
  currency={STELLA_EC.currency}
  monthlyOffer={monthly.price}
/>
