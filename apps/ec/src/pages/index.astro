---
import                          '../global.css';
import BaseLayout          from '../layouts/BaseLayout.astro';
import FAQ                 from '@shared/components/FAQ.astro';
import Footer              from '@shared/components/Footer.astro';
import EcuadorNavbar       from '../components/EcuadorNavbar.astro';
import EcuadorHero         from '../components/EcuadorHero.astro';
import EcuadorPlans        from '../components/EcuadorPlans.astro';
import ActivationStrip     from '../components/ActivationStrip.astro';
import EcuadorShowcase     from '../components/EcuadorShowcase.astro';
import EcuadorDevices      from '../components/EcuadorDevices.astro';
import EcuadorTestimonials from '../components/EcuadorTestimonials.astro';
import EcuadorHowItWorks   from '../components/EcuadorHowItWorks.astro';
import EcuadorCTAFinal     from '../components/EcuadorCTAFinal.astro';
import EcuadorWhatsAppFloat from '../components/EcuadorWhatsAppFloat.astro';
import EcuadorStickyMobileCTA from '../components/EcuadorStickyMobileCTA.astro';
import EcuadorInternalSeoLinks from '../components/EcuadorInternalSeoLinks.astro';
import { internalSeoLinks } from '../internalLinks';
import { STELLA_EC } from '../stella.config';

const COUNTRY = {
  brand:           'Oleada TV',
  whatsapp:        '51940405911',
  currency:        '$',
  monthlyOriginal: '6',
  monthlyOffer:    '4.99',
  annualOriginal:  '65',
  annualOffer:     '49.99',
  annualSaving:    '9.89',
  paymentMethods:  ['PayPal', 'Tarjeta de crédito/débito'],
};

const faqItems = [
  {
    q: '¿Qué necesito para empezar en Ecuador?',
    a: 'Necesitas internet estable y un dispositivo compatible: TV Box, Android TV, Fire Stick, celular o tablet Android. Primero revisamos tu caso por WhatsApp y luego te guiamos con la instalación.',
  },
  {
    q: '¿Cuánto tarda recibir mi acceso?',
    a: 'Después de confirmar el pago, enviamos tus datos de acceso por WhatsApp en pocos minutos. Si es tu primera vez, también te acompañamos hasta dejar la app funcionando.',
  },
  {
    q: '¿Puedo cambiar de dispositivo?',
    a: 'Sí. La cuenta permite 1 dispositivo activo simultáneo, pero puedes usarla en otro equipo cuando lo necesites. Lo importante es que solo reproduzca una pantalla a la vez.',
  },
  {
    q: '¿Cómo pago desde Ecuador?',
    a: 'Aceptamos PayPal y tarjeta de crédito o débito. Te enviamos el enlace de pago seguro por WhatsApp y, en cuanto se confirma, continuamos con la activación por el mismo chat.',
  },
  {
    q: '¿Tengo que quedarme varios meses?',
    a: 'No. Puedes empezar mensual y renovar solo cuando quieras continuar. El anual conviene si ya sabes que lo vas a usar durante todo el año.',
  },
  {
    q: '¿Qué puedo ver con Oleada TV en Ecuador?',
    a: 'TV en vivo, películas, series, eventos deportivos y contenido familiar. Si buscas algo específico, escríbenos y te confirmamos disponibilidad antes de activar.',
  },
  {
    q: '¿Me ayudan si uso Amazon Fire Stick?',
    a: 'Sí. Te guiamos con Downloader y con los permisos necesarios para instalar la app. No tienes que buscar tutoriales: lo hacemos paso a paso por WhatsApp.',
  },
  {
    q: '¿Funciona en Android TV o TV Box?',
    a: 'Sí. Son los equipos más cómodos para usar Oleada TV en la pantalla principal. Te enviamos el método de instalación adecuado para tu dispositivo.',
  },
  {
    q: '¿Qué pasa si necesito actualizar la app?',
    a: 'Si ya eres cliente y necesitas una actualización, nos escribes por WhatsApp y te enviamos el enlace o código vigente. También te guiamos si tu equipo pide reinstalar.',
  },
  {
    q: '¿Qué pasa si algo no me funciona?',
    a: 'Nos escribes por WhatsApp y revisamos contigo el dispositivo, la conexión y la instalación. La idea es que no te quedes solo después de pagar.',
  },
  {
    q: '¿Qué internet necesito en casa?',
    a: 'Para una experiencia estable recomendamos desde 10 Mbps. Si vas a usar HD o 4K, mientras más estable sea tu red, mejor se verá.',
  },
  {
    q: '¿Puedo empezar solo por un mes?',
    a: 'Sí. El plan mensual sirve para probar el servicio sin comprometerte a largo plazo. Si luego quieres ahorrar, puedes pasar al plan anual.',
  },
  {
    q: '¿Puedo ver el Mundial 2026 y los partidos de Ecuador con Oleada TV?',
    a: 'Sí. Con tu acceso a Oleada TV puedes seguir el Mundial 2026 y todos los partidos de la Selección de Ecuador en vivo, sin depender del cable ni de instalaciones adicionales. Solo necesitas tu dispositivo y conexión a internet.',
  },
  {
    q: '¿Necesito un plan especial para ver el Mundial 2026?',
    a: 'No. Cualquiera de nuestros planes (mensual o anual) te permite ver el Mundial 2026 en vivo. Si te preocupa la estabilidad de la señal durante los partidos, te ayudamos a revisar tu conexión antes de que arranque el torneo.',
  },
];

const productSchema = {
  name: 'Plan Mensual Oleada TV Ecuador',
  description: 'Plan mensual de TV por internet para Ecuador con acceso guiado por WhatsApp, pagos en USD y soporte para TV Box, Fire Stick y Android.',
  price: COUNTRY.monthlyOffer,
  priceCurrency: 'USD',
  availability: 'https://schema.org/InStock',
};

const localBusiness = {
  siteName: 'Oleada TV',
  telephone: '+51940405911',
  priceRange: `$ ${COUNTRY.monthlyOffer} - $ ${COUNTRY.annualOffer}`,
  currenciesAccepted: 'USD',
  paymentAccepted: 'PayPal, Tarjeta de Crédito, Tarjeta de Débito',
  areaServed: ['Ecuador', 'Quito', 'Guayaquil', 'Cuenca', 'Ambato', 'Manta', 'Portoviejo', 'Loja', 'Esmeraldas'],
};

const breadcrumb = [
  { name: 'Inicio', url: 'https://ec.oleadatvplus.com/' },
  { name: 'Planes', url: 'https://ec.oleadatvplus.com/#planes' },
];
---
<BaseLayout
  title={`${STELLA_EC.brand} Ecuador | Fútbol y Deportes en Vivo, Series y Cine 4K — Activación Inmediata desde $${STELLA_EC.plans[0].price}`}
  description={`${STELLA_EC.brand} en Ecuador: +1,000 canales, fútbol y deportes en vivo, cine y series. Activación inmediata por WhatsApp, pago en USD desde $${STELLA_EC.plans[0].price} al mes.`}
  keywords="stella tv, stella tv ecuador, stella tv precio, stella tv dolares, stella tv instalación, stella tv descarga, stella tv apk android, instalar stella tv con downloader, instalar stella tv fire stick, stella tv tv box, stella tv android, tv por internet ecuador, tv online ecuador, canales por internet ecuador, ver tv online ecuador, deportes en vivo ecuador, fútbol en vivo ecuador, series hd ecuador, cine hd ecuador, tv sin cable ecuador, canales online ecuador, stella tv soporte whatsapp, alternativa cable tv ecuador, ver mundial 2026 ecuador en vivo, partidos de ecuador mundial 2026, donde ver el mundial 2026 ecuador, la tri mundial 2026, transmision mundial 2026 ecuador, ver mundial 2026 por internet, mundial 2026 tv en vivo ecuador, tv online quito mundial 2026, tv online guayaquil mundial 2026"
  canonical="https://ec.oleadatvplus.com/"
  brand={STELLA_EC.brand}
  author={STELLA_EC.brand}
  themeColor="#00C853"
  lang="es-EC"
  locale="es_EC"
  geoRegion="EC"
  geoPlacename="Quito, Ecuador"
  geoPosition="-0.1807;-78.4678"
  alternates={[
    { hreflang: 'es-EC', href: 'https://ec.oleadatvplus.com/' },
    { hreflang: 'es-PE', href: 'https://oleadatvplus.com/' },
    { hreflang: 'es-AR', href: 'https://ar.oleadatvplus.com/' },
    { hreflang: 'x-default', href: 'https://oleadatvplus.com/' },
  ]}
  faqSchema={faqItems}
  productSchema={productSchema}
  aggregateRating={{ ratingValue: STELLA_EC.rating.value, reviewCount: STELLA_EC.rating.count }}
  localBusiness={localBusiness}
  breadcrumb={breadcrumb}
/>

<EcuadorNavbar whatsapp={COUNTRY.whatsapp} />

<main>
  <EcuadorHero
    whatsapp={COUNTRY.whatsapp}
    country="Ecuador"
    currency={COUNTRY.currency}
    monthlyOffer={COUNTRY.monthlyOffer}
  />

  <ActivationStrip
    whatsapp={COUNTRY.whatsapp}
    paymentMethods={COUNTRY.paymentMethods}
  />

  <EcuadorPlans
    currency={STELLA_EC.currency}
    plans={STELLA_EC.plans}
    whatsapp={STELLA_EC.whatsapp}
    brand={STELLA_EC.brand}
    features={STELLA_EC.planFeatures}
    paymentMethods={STELLA_EC.paymentMethods}
  />

  <EcuadorShowcase />

  <EcuadorDevices />

  <EcuadorTestimonials />

  <EcuadorHowItWorks />

  <FAQ items={faqItems} />

  <EcuadorCTAFinal
    whatsapp={COUNTRY.whatsapp}
    currency={COUNTRY.currency}
    monthlyOffer={COUNTRY.monthlyOffer}
  />

  <EcuadorInternalSeoLinks links={internalSeoLinks.home} />
</main>

<Footer brand={COUNTRY.brand} whatsapp={COUNTRY.whatsapp} />

<EcuadorWhatsAppFloat whatsapp={COUNTRY.whatsapp} />

<EcuadorStickyMobileCTA
  whatsapp={COUNTRY.whatsapp}
  currency={COUNTRY.currency}
  monthlyOffer={COUNTRY.monthlyOffer}
/>