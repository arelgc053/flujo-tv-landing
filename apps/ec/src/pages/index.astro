---
import                          '../global.css';
import BaseLayout          from '../layouts/BaseLayout.astro';
import FAQ                 from '@shared/components/FAQ.astro';
import Footer              from '@shared/components/Footer.astro';
import EcuadorNavbar       from '../components/EcuadorNavbar.astro';
import EcuadorHero         from '../components/EcuadorHero.astro';
import EcuadorPlans        from '../components/EcuadorPlans.astro';
import ActivationStrip     from '../components/ActivationStrip.astro';
import EcuadorShowcase     from '../components/EcuadorShowcase.astro';
import EcuadorDevices      from '../components/EcuadorDevices.astro';
import BeforePaying         from '@shared/components/BeforePaying.astro';
import EcuadorHowItWorks   from '../components/EcuadorHowItWorks.astro';
import EcuadorCTAFinal     from '../components/EcuadorCTAFinal.astro';
import EcuadorWhatsAppFloat from '../components/EcuadorWhatsAppFloat.astro';
import EcuadorStickyMobileCTA from '../components/EcuadorStickyMobileCTA.astro';
import EcuadorInternalSeoLinks from '../components/EcuadorInternalSeoLinks.astro';
import { internalSeoLinks } from '../internalLinks';
import { STELLA_EC } from '../stella.config';
import SellerNotice from '@shared/components/SellerNotice.astro';
import Downloads from '@shared/components/Downloads.astro';
import { waTag } from '@shared/lib/wa';
import { EC_FOOTER_PAGES, EC_SITE_LINKS } from '../site';
import { homeAlternates } from '@shared/data/sites';
import { DOWNLOADS } from '@shared/data/stella';

const TAG = waTag('EC', 'HOME');
const monthly = STELLA_EC.plans[0];

const faqItems = [
  {
    q: '¿Qué necesito para empezar en Ecuador?',
    a: 'Necesitas internet estable y un dispositivo compatible: TV Box, Android TV, Fire Stick, celular o tablet Android. Primero revisamos tu caso por WhatsApp y luego te guiamos con la instalación.',
  },
  {
    q: '¿Cuánto tarda recibir mi acceso?',
    a: 'Después de confirmar el pago, enviamos tus datos de acceso por WhatsApp en pocos minutos. Si es tu primera vez, también te acompañamos hasta dejar la app funcionando.',
  },
  {
    q: '¿Puedo cambiar de dispositivo?',
    a: 'Sí. Cada cuenta permite 3 pantallas a la vez, y puedes cambiar de equipo cuando lo necesites.',
  },
  {
    q: '¿Cómo pago desde Ecuador?',
    a: 'Por transferencia bancaria desde Banco Pichincha o Banco Guayaquil. Te enviamos los datos de pago por WhatsApp y, en cuanto se confirma, continuamos con la activación por el mismo chat.',
  },
  {
    q: '¿Tengo que quedarme varios meses?',
    a: 'No. Puedes empezar mensual y renovar solo cuando quieras continuar. Los planes de 6 y 12 meses convienen si ya sabes que lo vas a usar más tiempo: traen 1 y 2 meses gratis.',
  },
  {
    q: '¿Qué puedo ver con Stella TV en Ecuador?',
    a: 'TV en vivo, películas, series, eventos deportivos y contenido familiar. Si buscas algo específico, escríbenos y te confirmamos disponibilidad antes de activar.',
  },
  {
    q: '¿Me ayudan si uso Amazon Fire Stick?',
    a: 'Sí. Te guiamos con Downloader y con los permisos necesarios para instalar la app. No tienes que buscar tutoriales: lo hacemos paso a paso por WhatsApp.',
  },
  {
    q: '¿Funciona en Android TV o TV Box?',
    a: 'Sí. Son los equipos más cómodos para usar Stella TV en la pantalla principal. Te enviamos el método de instalación adecuado para tu dispositivo.',
  },
  {
    q: '¿Qué pasa si necesito actualizar la app?',
    a: 'Si ya eres cliente y necesitas una actualización, nos escribes por WhatsApp y te enviamos el enlace o código vigente. También te guiamos si tu equipo pide reinstalar.',
  },
  {
    q: '¿Qué pasa si algo no me funciona?',
    a: 'Nos escribes por WhatsApp y revisamos contigo el dispositivo, la conexión y la instalación. La idea es que no te quedes solo después de pagar.',
  },
  {
    q: '¿Qué internet necesito en casa?',
    a: 'Para una experiencia estable recomendamos desde 10 Mbps. Si vas a usar HD o 4K, mientras más estable sea tu red, mejor se verá.',
  },
  {
    q: '¿Puedo empezar solo por un mes?',
    a: 'Sí. El plan mensual sirve para probar el servicio sin comprometerte a largo plazo. Si luego quieres ahorrar, puedes pasar a un plan de 6 o 12 meses.',
  },
  {
    q: '¿Cuánto cuesta Stella TV en Ecuador?',
    a: `1 mes $${STELLA_EC.plans[0].price}, 3 meses $${STELLA_EC.plans[1].price}, 6 meses $${STELLA_EC.plans[2].price} (con 1 mes gratis) y 12 meses $${STELLA_EC.plans[3].price} (con 2 meses gratis), en dólares y sin conversiones. Los cuatro planes incluyen lo mismo.`,
  },
  {
    q: '¿Cuál es el código de Stella TV para Downloader?',
    a: `Para televisores el código vigente es ${DOWNLOADS.tv.downloaderCode}. El ${DOWNLOADS.legacyCodes.join(' / ')} es un código anterior. En el celular basta con el APK directo (versión ${DOWNLOADS.mobile.version}).`,
  },
];

const productSchema = {
  name: 'Plan Mensual Stella TV Ecuador',
  description: 'Plan mensual de TV por internet para Ecuador con acceso guiado por WhatsApp, pagos en USD y soporte para TV Box, Fire Stick y Android.',
  price: monthly.price,
  priceCurrency: 'USD',
  availability: 'https://schema.org/InStock',
};


const breadcrumb = [
  { name: 'Inicio', url: 'https://ec.oleadatvplus.com/' },
  { name: 'Planes', url: 'https://ec.oleadatvplus.com/#planes' },
];
---
<BaseLayout
  title={`Stella TV Ecuador desde $${monthly.price}/mes: planes, instalación y código`}
  description={`Contrata Stella TV en Ecuador con Oleada TV: desde $${monthly.price} al mes en dólares, pago por transferencia, APK y código Downloader ${DOWNLOADS.tv.downloaderCode}. Soporte por WhatsApp.`}
  keywords="stella tv, stella tv ecuador, stella tv precio, stella tv dolares, stella tv instalación, stella tv descarga, stella tv apk android, instalar stella tv con downloader, instalar stella tv fire stick, stella tv tv box, stella tv android, tv por internet ecuador, tv online ecuador, canales por internet ecuador, ver tv online ecuador, deportes en vivo ecuador, fútbol en vivo ecuador, series hd ecuador, cine hd ecuador, tv sin cable ecuador, canales online ecuador, stella tv soporte whatsapp, alternativa cable tv ecuador"
  canonical="https://ec.oleadatvplus.com/"
  country="EC"
  whatsapp={STELLA_EC.whatsapp}
  themeColor="#00C853"
  lang="es-EC"
  locale="es_EC"
  geoRegion="EC"
  geoPlacename="Quito, Ecuador"
  geoPosition="-0.1807;-78.4678"
  alternates={homeAlternates('ec')}
  faqSchema={faqItems}
  productSchema={productSchema}
  organization={{ telephone: `+${STELLA_EC.whatsapp}`, areaServed: STELLA_EC.areaServed }}
  breadcrumb={breadcrumb}
/>

<SellerNotice country="Ecuador" />
<EcuadorNavbar whatsapp={STELLA_EC.whatsapp} waTag={TAG} />

<main>
  <EcuadorHero
    whatsapp={STELLA_EC.whatsapp}
    waTag={TAG}
    country="Ecuador"
    badge="Oleada TV · Stella TV en Ecuador"
    headlineTop="Stella TV en Ecuador"
    headlineEm={`planes desde $${monthly.price} al mes`}
    sub="Más de 1,000 canales, deportes en vivo, cine y series. Pagas en dólares por transferencia bancaria y te guiamos por WhatsApp hasta dejarlo listo en tu TV Box, Fire TV o Android."
    currency={STELLA_EC.currency}
    monthlyOffer={monthly.price}
  />

  <ActivationStrip
    whatsapp={STELLA_EC.whatsapp}
    waTag={TAG}
    paymentMethods={STELLA_EC.paymentMethods}
  />

  <EcuadorPlans
    currency={STELLA_EC.currency}
    plans={STELLA_EC.plans}
    whatsapp={STELLA_EC.whatsapp}
    waTag={TAG}
    brand={STELLA_EC.brand}
    features={STELLA_EC.planFeatures}
    paymentMethods={STELLA_EC.paymentMethods}
  />

  <EcuadorShowcase />

  <EcuadorDevices />

  <BeforePaying whatsapp={STELLA_EC.whatsapp} waTag={TAG} paymentText={STELLA_EC.beforePayingText} />

  <EcuadorHowItWorks />

  <Downloads whatsapp={STELLA_EC.whatsapp} waTag={TAG} guideHref="/instalar-stella-tv" />

  <FAQ items={faqItems} />

  <EcuadorCTAFinal
    whatsapp={STELLA_EC.whatsapp}
    waTag={TAG}
    currency={STELLA_EC.currency}
    monthlyOffer={monthly.price}
  />

  <EcuadorInternalSeoLinks links={internalSeoLinks.home} />
</main>

<Footer whatsapp={STELLA_EC.whatsapp} waTag={TAG} country="Ecuador" pageLinks={EC_FOOTER_PAGES} siteLinks={EC_SITE_LINKS} />

<EcuadorWhatsAppFloat whatsapp={STELLA_EC.whatsapp} waTag={TAG} />

<EcuadorStickyMobileCTA
  whatsapp={STELLA_EC.whatsapp}
  waTag={TAG}
  currency={STELLA_EC.currency}
  monthlyOffer={monthly.price}
/>