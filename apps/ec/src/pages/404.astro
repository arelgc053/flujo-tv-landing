---
import '../global.css';
import BaseLayout          from '../layouts/BaseLayout.astro';
import EcuadorNavbar       from '../components/EcuadorNavbar.astro';
import Footer              from '@shared/components/Footer.astro';
import EcuadorWhatsAppFloat from '../components/EcuadorWhatsAppFloat.astro';
import { STELLA_EC } from '../stella.config';
import { EC_FOOTER_PAGES } from '../site';
import { waHref, waTag } from '@shared/lib/wa';

const TAG = waTag('EC', '404');
const waLink = waHref(STELLA_EC.whatsapp, `Hola, quiero información sobre ${STELLA_EC.brand}.`, TAG);
---
<BaseLayout
  title="Página no encontrada — Oleada TV"
  description="La página que buscas no existe o fue movida. Vuelve al inicio o escríbenos por WhatsApp."
  preloadHero={false}
  canonical="https://ec.oleadatvplus.com/404"
  country="EC"
  whatsapp={STELLA_EC.whatsapp}
  lang="es-EC"
  locale="es_EC"
  geoRegion="EC"
  geoPlacename="Quito, Ecuador"
  noindex
/>

<EcuadorNavbar whatsapp={STELLA_EC.whatsapp} waTag={TAG} anchorBase="/" />

<main>
  <section class="not-found">
    <div class="inner">
      <p class="not-found-code">404</p>
      <h1>Esta página no existe</h1>
      <p class="not-found-sub">
        Puede que el enlace esté roto o que la página se haya movido. Vuelve al inicio o escríbenos por WhatsApp y te ayudamos directamente.
      </p>
      <div class="not-found-actions">
        <a href="/" class="btn-ghost">Volver al inicio</a>
        <a href={waLink} target="_blank" rel="noopener noreferrer" class="btn-wa">Escribir por WhatsApp</a>
      </div>
    </div>
  </section>
</main>

<Footer whatsapp={STELLA_EC.whatsapp} waTag={TAG} country="Ecuador" sectionLinks={[{ href: "/", label: "Inicio" }]} pageLinks={EC_FOOTER_PAGES.slice(1)} />
<EcuadorWhatsAppFloat whatsapp={STELLA_EC.whatsapp} waTag={TAG} />

<style>
  .not-found {
    min-height: 60vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 120px 20px 80px;
  }
  .not-found .inner {
    max-width: 560px;
  }
  .not-found-code {
    font-family: 'Syne', sans-serif;
    font-size: 5rem;
    font-weight: 900;
    line-height: 1;
    margin: 0 0 8px;
    color: var(--orange, #00C853);
  }
  .not-found h1 {
    font-size: 1.75rem;
    margin: 0 0 12px;
  }
  .not-found-sub {
    color: var(--text-muted, #9aa0a6);
    line-height: 1.6;
    margin: 0 0 28px;
  }
  .not-found-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    justify-content: center;
  }
</style>
