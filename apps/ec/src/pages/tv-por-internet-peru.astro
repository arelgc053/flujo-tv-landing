---
import BaseLayout     from '@shared/layouts/BaseLayout.astro';
import Navbar         from '@shared/components/Navbar.astro';
import Hero           from '@shared/components/Hero.astro';
import StatsBar       from '@shared/components/StatsBar.astro';
import HowItWorks     from '@shared/components/HowItWorks.astro';
import Plans          from '@shared/components/Plans.astro';
import Comparison     from '@shared/components/Comparison.astro';
import Testimonials   from '@shared/components/Testimonials.astro';
import Devices        from '@shared/components/Devices.astro';
import FAQ            from '@shared/components/FAQ.astro';
import CTAFinal       from '@shared/components/CTAFinal.astro';
import Footer         from '@shared/components/Footer.astro';
import WhatsAppFloat  from '@shared/components/WhatsAppFloat.astro';
import StickyMobileCTA from '@shared/components/StickyMobileCTA.astro';

const COUNTRY = {
  brand:           'Oleada TV',
  whatsapp:        '51940405911',
  currency:        'S/',
  monthlyOriginal: '15',
  monthlyOffer:    '11.99',
  annualOriginal:  '130',
  annualOffer:     '119.99',
  annualSaving:    '23.89',
  paymentMethods:  ['Yape', 'Plin'],
};

const faqItems = [
  {
    q: '¿Qué necesito para tener TV por internet en casa?',
    a: 'Solo necesitas un dispositivo Android (TV Box, Fire Stick, celular o tablet) y conexión a internet de al menos 10 Mbps. Nada más. Sin técnicos, sin instalaciones, sin antenas.',
  },
  {
    q: '¿La TV por internet es mejor que el cable?',
    a: 'En casi todos los aspectos sí: cuesta mucho menos, no tiene contrato mínimo, se activa el mismo día y funciona en cualquier dispositivo. El cable cobra desde S/ 80 al mes y te amarra a un contrato de un año o más.',
  },
  {
    q: '¿Cuánto ahorro al cambiar de cable a TV por internet?',
    a: `Con Oleada TV pagas desde S/ ${COUNTRY.monthlyOffer} al mes. El cable tradicional en Perú cuesta desde S/ 80 hasta S/ 200 mensuales. El ahorro anual puede superar los S/ 800.`,
  },
  {
    q: '¿TV por internet funciona en todo el Perú?',
    a: 'Sí. Oleada TV funciona en Lima, Arequipa, Trujillo, Cusco, Piura, Iquitos, Huancayo y cualquier ciudad del Perú que tenga internet. Solo necesitas una conexión estable.',
  },
  {
    q: '¿Mis hijos pueden ver sus canales favoritos?',
    a: 'Sí. Oleada TV incluye canales de entretenimiento infantil, series, películas y más. Toda la familia encuentra algo que ver en una sola cuenta.',
  },
  {
    q: '¿Funciona en mi Smart TV?',
    a: 'Si tu Smart TV tiene Android TV integrado, sí. Si tiene un sistema propio (Samsung Tizen, LG webOS), necesitas conectarle un TV Box Android o un Fire Stick — te asesoramos por WhatsApp sobre qué comprar.',
  },
  {
    q: '¿Hay contrato mínimo o permanencia?',
    a: 'No. Puedes elegir el plan mensual sin ningún compromiso. Renuevas cuando quieres o cancelas sin penalidades. Sin letras pequeñas.',
  },
  {
    q: '¿Puedo ver canales de señal abierta peruana por internet?',
    a: 'Sí. Oleada TV incluye canales nacionales en vivo para que no te pierdas noticias, entretenimiento local ni eventos importantes del país.',
  },
  {
    q: '¿Cómo pago la TV por internet?',
    a: 'Aceptamos Yape y Plin. Yapeas o plineas el monto, nos envías el comprobante por WhatsApp, y en minutos tienes tu acceso activado. Sin tarjetas ni trámites.',
  },
  {
    q: '¿Cuánto tiempo tarda la instalación y activación?',
    a: 'La activación toma menos de 5 minutos. La instalación en tu dispositivo la hacemos contigo por WhatsApp — en promedio 10 minutos para usuarios nuevos.',
  },
];

const productSchema = {
  name: 'Oleada TV — TV por Internet en Perú sin Cable',
  description: 'TV por internet en todo el Perú desde S/ 11.99 al mes. Sin cable, sin contratos. Actívate el mismo día pagando con Yape o Plin.',
  price: COUNTRY.monthlyOffer,
  priceCurrency: 'PEN',
};

const localBusiness = {
  siteName: 'Oleada TV',
  telephone: '+51940405911',
  priceRange: `S/ ${COUNTRY.monthlyOffer} - S/ ${COUNTRY.annualOffer}`,
  currenciesAccepted: 'PEN',
  paymentAccepted: 'Yape, Plin',
  areaServed: ['Perú', 'Lima', 'Arequipa', 'Trujillo', 'Cusco', 'Piura', 'Iquitos', 'Huancayo'],
};

const breadcrumb = [
  { name: 'Inicio', url: 'https://oleadatvplus.com/' },
  { name: 'TV por Internet Perú', url: 'https://oleadatvplus.com/tv-por-internet-peru' },
];
---
<BaseLayout
  title="TV por Internet en Perú sin Cable — Oleada TV | Desde S/ 11.99 al mes"
  description="TV por internet en todo el Perú sin cable ni contratos desde S/ 11.99. Más de 5,000 familias ya dejaron el cable. Actívate hoy con Yape o Plin."
  keywords="tv por internet peru, canales por internet peru, television por internet peru, tv sin cable peru, reemplazar cable peru, canales online peru, tv digital peru, ver tv online peru, tv por internet barata peru, dejar el cable peru, tv por internet yape"
  canonical="https://oleadatvplus.com/tv-por-internet-peru"
  lang="es-PE"
  locale="es_PE"
  geoRegion="PE"
  geoPlacename="Lima, Perú"
  geoPosition="-12.0464;-77.0428"
  faqSchema={faqItems}
  productSchema={productSchema}
  localBusiness={localBusiness}
  breadcrumb={breadcrumb}
/>

<Navbar brand={COUNTRY.brand} whatsapp={COUNTRY.whatsapp} />

<main>
  <Hero
    brand={COUNTRY.brand}
    whatsapp={COUNTRY.whatsapp}
    currency={COUNTRY.currency}
    monthlyOffer={COUNTRY.monthlyOffer}
    headlineTop="TV por internet en todo el Perú"
    headlineEm="sin cable, sin contratos"
    sub="Más de 5,000 familias ya dejaron el cable. Paga con Yape o Plin y actívate el mismo día — sin técnicos, sin esperas, sin letra pequeña."
    badge="La alternativa al cable más popular"
    waText="Hola, quiero cambiar de cable a TV por internet con Oleada TV"
  />

  <StatsBar />
  <HowItWorks whatsapp={COUNTRY.whatsapp} />

  <Plans
    currency={COUNTRY.currency}
    monthlyOriginal={COUNTRY.monthlyOriginal}
    monthlyOffer={COUNTRY.monthlyOffer}
    annualOriginal={COUNTRY.annualOriginal}
    annualOffer={COUNTRY.annualOffer}
    annualSaving={COUNTRY.annualSaving}
    whatsapp={COUNTRY.whatsapp}
    paymentMethods={COUNTRY.paymentMethods}
  />

  <Comparison currency={COUNTRY.currency} monthlyOffer={COUNTRY.monthlyOffer} />

  <Testimonials />
  <Devices />
  <FAQ items={faqItems} />

  <CTAFinal
    whatsapp={COUNTRY.whatsapp}
    currency={COUNTRY.currency}
    monthlyOffer={COUNTRY.monthlyOffer}
  />
</main>

<Footer brand={COUNTRY.brand} whatsapp={COUNTRY.whatsapp} />
<WhatsAppFloat whatsapp={COUNTRY.whatsapp} />
<StickyMobileCTA
  whatsapp={COUNTRY.whatsapp}
  currency={COUNTRY.currency}
  monthlyOffer={COUNTRY.monthlyOffer}
/>
