---
import                          '../global.css';
import BaseLayout          from '../layouts/BaseLayout.astro';
import FAQ                 from '@shared/components/FAQ.astro';
import Footer              from '@shared/components/Footer.astro';
import EcuadorNavbar       from '../components/EcuadorNavbar.astro';
import EcuadorHero         from '../components/EcuadorHero.astro';
import EcuadorPlans        from '../components/EcuadorPlans.astro';
import ActivationStrip     from '../components/ActivationStrip.astro';
import EcuadorShowcase     from '../components/EcuadorShowcase.astro';
import EcuadorDevices      from '../components/EcuadorDevices.astro';
import BeforePaying         from '@shared/components/BeforePaying.astro';
import EcuadorHowItWorks   from '../components/EcuadorHowItWorks.astro';
import EcuadorCTAFinal     from '../components/EcuadorCTAFinal.astro';
import EcuadorWhatsAppFloat from '../components/EcuadorWhatsAppFloat.astro';
import EcuadorStickyMobileCTA from '../components/EcuadorStickyMobileCTA.astro';
import EcuadorInternalSeoLinks from '../components/EcuadorInternalSeoLinks.astro';
import { internalSeoLinks } from '../internalLinks';
import { STELLA_EC } from '../stella.config';
import SellerNotice from '@shared/components/SellerNotice.astro';
import Downloads from '@shared/components/Downloads.astro';
import { waTag } from '@shared/lib/wa';
import { EC_FOOTER_PAGES, EC_SITE_LINKS } from '../site';

const TAG = waTag('EC', 'QUITO-GUAYAQUIL');
const monthly = STELLA_EC.plans[0];

const faqItems = [
  {
    q: '¿Stella TV funciona bien en Quito y Guayaquil?',
    a: 'Sí, con cualquier proveedor de internet en Quito o Guayaquil. Lo importante es tener una conexión estable: te ayudamos a revisarla por WhatsApp antes de activar.',
  },
  {
    q: '¿Funciona también en Cuenca, Ambato o Manta?',
    a: 'Sí. Stella TV funciona en Cuenca, Ambato, Manta, Portoviejo, Loja, Esmeraldas y cualquier ciudad de Ecuador con internet estable.',
  },
  {
    q: '¿Cómo activo Stella TV en Quito o Guayaquil hoy mismo?',
    a: 'Escríbenos por WhatsApp, elige tu plan, paga por transferencia desde Banco Pichincha o Banco Guayaquil y te enviamos tus credenciales. Te guiamos en la instalación paso a paso.',
  },
  {
    q: '¿Tienen soporte local en Quito o Guayaquil?',
    a: 'Nuestro soporte es 100% por WhatsApp — eso nos permite atenderte rápido sin importar tu distrito o sector. Respondemos en minutos durante el día.',
  },
  {
    q: '¿Cuánto internet necesito en mi casa de Quito o Guayaquil?',
    a: 'Funciona con cualquier WiFi doméstico. Recomendamos mínimo 10 Mbps para HD. Si no sabes cuántos Mbps tienes, te ayudamos a revisarlo por WhatsApp.',
  },
  {
    q: '¿Puedo ver canales ecuatorianos en vivo desde Quito o Guayaquil?',
    a: 'Sí. Stella TV incluye canales nacionales en vivo para que veas noticias, programas locales y eventos deportivos sin perderte nada.',
  },
  {
    q: '¿Puedo ver deportes en vivo desde Quito o Guayaquil?',
    a: 'Sí. Stella TV incluye deportes en vivo y funciona en cualquier ciudad con internet estable. Si buscas un evento específico, consúltanos por WhatsApp antes de contratar.',
  },
  {
    q: '¿Qué dispositivo necesito para usar Stella TV en mi ciudad?',
    a: 'Un TV Box Android, Amazon Fire Stick, celular Android o tablet. Si no tienes ninguno, te asesoramos cuál comprar según tu presupuesto.',
  },
];

const productSchema = {
  name: 'Stella TV Quito y Guayaquil — TV Online sin Cable',
  description: 'TV online en Quito, Guayaquil y el resto de Ecuador, sin cable ni contratos, desde $9. Pago en USD, activación guiada por WhatsApp.',
  price: monthly.price,
  priceCurrency: 'USD',
};


const breadcrumb = [
  { name: 'Inicio', url: 'https://ec.oleadatvplus.com/' },
  { name: 'TV Online en Quito y Guayaquil', url: 'https://ec.oleadatvplus.com/tv-online-quito-guayaquil' },
];
---
<BaseLayout
  title={`TV Online en Quito y Guayaquil — ${STELLA_EC.brand} | Actívate sin Cable en Minutos`}
  description="TV online en Quito, Guayaquil y todo Ecuador, sin cable ni contratos, desde $9. Canales, series y deportes en vivo. Pago en USD por transferencia."
  keywords="tv online quito, tv online guayaquil, tv por internet quito, tv por internet guayaquil, canales en vivo quito, canales en vivo guayaquil, tv online cuenca, tv online ambato, tv online manta, alternativa cable tv quito, alternativa cable tv guayaquil"
  canonical="https://ec.oleadatvplus.com/tv-online-quito-guayaquil"
  country="EC"
  whatsapp={STELLA_EC.whatsapp}
  themeColor="#00C853"
  lang="es-EC"
  locale="es_EC"
  geoRegion="EC"
  geoPlacename="Quito y Guayaquil, Ecuador"
  geoPosition="-0.1807;-78.4678"
  faqSchema={faqItems}
  productSchema={productSchema}
  organization={{ telephone: `+${STELLA_EC.whatsapp}`, areaServed: STELLA_EC.areaServed }}
  breadcrumb={breadcrumb}
/>

<SellerNotice country="Ecuador" />
<EcuadorNavbar whatsapp={STELLA_EC.whatsapp} waTag={TAG} />

<main>
  <EcuadorHero
    whatsapp={STELLA_EC.whatsapp}
    waTag={TAG}
    country="Quito y Guayaquil"
    currency={STELLA_EC.currency}
    monthlyOffer={monthly.price}
    badge="Cobertura confirmada en Quito, Guayaquil y más"
    headlineTop="TV online en Quito y Guayaquil,"
    headlineEm="activación el mismo día"
    sub="Escríbenos por WhatsApp, confirma tu pago en dólares y recibe el acceso guiado para ver desde tu TV Box, Fire Stick o Android, sin visitas técnicas en tu sector."
    waText="Hola, quiero activar Stella TV en Quito/Guayaquil"
  />

  <ActivationStrip
    whatsapp={STELLA_EC.whatsapp}
    waTag={TAG}
    paymentMethods={STELLA_EC.paymentMethods}
  />

  <EcuadorPlans
    currency={STELLA_EC.currency}
    plans={STELLA_EC.plans}
    whatsapp={STELLA_EC.whatsapp}
    waTag={TAG}
    brand={STELLA_EC.brand}
    features={STELLA_EC.planFeatures}
    paymentMethods={STELLA_EC.paymentMethods}
  />

  <EcuadorShowcase />

  <EcuadorDevices />

  <BeforePaying whatsapp={STELLA_EC.whatsapp} waTag={TAG} paymentText={STELLA_EC.beforePayingText} />

  <EcuadorHowItWorks />

  <Downloads whatsapp={STELLA_EC.whatsapp} waTag={TAG} guideHref="/instalar-stella-tv" />

  <FAQ items={faqItems} />

  <EcuadorCTAFinal
    whatsapp={STELLA_EC.whatsapp}
    waTag={TAG}
    currency={STELLA_EC.currency}
    monthlyOffer={monthly.price}
  />

  <EcuadorInternalSeoLinks links={internalSeoLinks.tvOnlineQuitoGuayaquil} />
</main>

<Footer whatsapp={STELLA_EC.whatsapp} waTag={TAG} country="Ecuador" pageLinks={EC_FOOTER_PAGES} siteLinks={EC_SITE_LINKS} />

<EcuadorWhatsAppFloat whatsapp={STELLA_EC.whatsapp} waTag={TAG} />

<EcuadorStickyMobileCTA
  whatsapp={STELLA_EC.whatsapp}
  waTag={TAG}
  currency={STELLA_EC.currency}
  monthlyOffer={monthly.price}
/>
