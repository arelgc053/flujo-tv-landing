---
import                          '../global.css';
import BaseLayout          from '../layouts/BaseLayout.astro';
import FAQ                 from '@shared/components/FAQ.astro';
import Footer              from '@shared/components/Footer.astro';
import EcuadorNavbar       from '../components/EcuadorNavbar.astro';
import EcuadorHero         from '../components/EcuadorHero.astro';
import EcuadorPlans        from '../components/EcuadorPlans.astro';
import ActivationStrip     from '../components/ActivationStrip.astro';
import EcuadorShowcase     from '../components/EcuadorShowcase.astro';
import EcuadorDevices      from '../components/EcuadorDevices.astro';
import BeforePaying         from '@shared/components/BeforePaying.astro';
import EcuadorHowItWorks   from '../components/EcuadorHowItWorks.astro';
import EcuadorCTAFinal     from '../components/EcuadorCTAFinal.astro';
import EcuadorWhatsAppFloat from '../components/EcuadorWhatsAppFloat.astro';
import EcuadorStickyMobileCTA from '../components/EcuadorStickyMobileCTA.astro';
import EcuadorInternalSeoLinks from '../components/EcuadorInternalSeoLinks.astro';
import { internalSeoLinks } from '../internalLinks';
import { STELLA_EC } from '../stella.config';
import SellerNotice from '@shared/components/SellerNotice.astro';
import Downloads from '@shared/components/Downloads.astro';
import { waTag } from '@shared/lib/wa';
import { EC_FOOTER_PAGES, EC_SITE_LINKS } from '../site';

const TAG = waTag('EC', 'SIN-CORTES');
const monthly = STELLA_EC.plans[0];

const faqItems = [
  {
    q: '¿Por qué mi TV por internet se corta constantemente?',
    a: 'Los cortes suelen venir de servidores inestables o sobrecargados del proveedor que usas. Con Stella TV monitoreamos nuestros servidores para resolver cualquier incidencia antes de que la notes.',
  },
  {
    q: '¿Cuánto internet necesito para que no se corte la señal?',
    a: 'Recomendamos mínimo 10 Mbps para HD y 25 Mbps para 4K. Si tu internet cumple eso y el servicio sigue cortándose, el problema es el proveedor de TV, no tu internet.',
  },
  {
    q: '¿Stella TV realmente no tiene cortes en Ecuador?',
    a: 'Buscamos la mayor disponibilidad posible. Ningún servicio puede garantizar cero incidencias, pero si algo falla nuestro soporte responde rápido por WhatsApp y lo resuelve al momento.',
  },
  {
    q: '¿Qué pasa si hay un corte justo en un partido importante?',
    a: 'Escríbenos por WhatsApp y revisamos contigo la conexión, el equipo y el servicio. Para partidos importantes, te recomendamos probar la señal con anticipación.',
  },
  {
    q: '¿Puedo cambiar de mi servicio actual a Stella TV sin complicaciones?',
    a: 'Sí. Solo escríbenos por WhatsApp y en minutos tienes tus nuevas credenciales. No necesitas desinstalar nada antes — te guiamos paso a paso en tu mismo dispositivo.',
  },
  {
    q: '¿Funciona en el mismo TV Box o Fire Stick que ya tengo?',
    a: 'Sí. Stella TV es compatible con TV Box Android, Amazon Fire Stick, celulares y tablets Android. Usas el dispositivo que ya tienes, sin comprar nada nuevo.',
  },
  {
    q: '¿Cuánto cuesta cambiarse a Stella TV en Ecuador?',
    a: `Desde $${monthly.price} al mes. Sin permanencia ni contratos — si decides que no es lo que buscas, simplemente no renuevas.`,
  },
  {
    q: '¿Cómo pago desde Ecuador?',
    a: 'Por transferencia bancaria desde Banco Pichincha o Banco Guayaquil. Te enviamos los datos de pago por WhatsApp y, en cuanto se confirma, continuamos con la activación por el mismo chat.',
  },
  {
    q: '¿Funciona bien en provincia o solo en Quito y Guayaquil?',
    a: 'En todo Ecuador. Quito, Guayaquil, Cuenca, Ambato, Manta — donde tengas internet de al menos 10 Mbps, Stella TV funciona.',
  },
];

const productSchema = {
  name: 'Stella TV — TV por Internet Estable sin Cortes en Ecuador',
  description: 'Servicio de TV por internet estable y sin cortes para Ecuador. Soporte por WhatsApp. Pago en USD. Desde $9 al mes.',
  price: monthly.price,
  priceCurrency: 'USD',
};


const breadcrumb = [
  { name: 'Inicio', url: 'https://ec.oleadatvplus.com/' },
  { name: 'TV por Internet sin Cortes', url: 'https://ec.oleadatvplus.com/tv-sin-cortes-ecuador' },
];
---
<BaseLayout
  title={`TV por Internet sin Cortes en Ecuador — ${STELLA_EC.brand} | Cómo Evitar Cortes`}
  description="¿Tu TV por internet se corta todo el tiempo? Velocidad recomendada, consejos de WiFi y soporte por WhatsApp con Stella TV en Ecuador. Desde $9, pago en USD."
  keywords="tv por internet sin cortes ecuador, tv online estable ecuador, servicio tv internet que no falla ecuador, tv por internet confiable ecuador, por que se corta mi tv por internet, tv sin interrupciones ecuador, mejor servicio tv online ecuador"
  canonical="https://ec.oleadatvplus.com/tv-sin-cortes-ecuador"
  country="EC"
  whatsapp={STELLA_EC.whatsapp}
  themeColor="#00C853"
  lang="es-EC"
  locale="es_EC"
  geoRegion="EC"
  geoPlacename="Ecuador"
  geoPosition="-1.8312;-78.1834"
  faqSchema={faqItems}
  productSchema={productSchema}
  organization={{ telephone: `+${STELLA_EC.whatsapp}`, areaServed: STELLA_EC.areaServed }}
  breadcrumb={breadcrumb}
/>

<SellerNotice country="Ecuador" />
<EcuadorNavbar whatsapp={STELLA_EC.whatsapp} waTag={TAG} />

<main>
  <EcuadorHero
    whatsapp={STELLA_EC.whatsapp}
    waTag={TAG}
    country="Ecuador"
    currency={STELLA_EC.currency}
    monthlyOffer={monthly.price}
    badge="Revisamos tu conexión antes de activar"
    headlineTop="¿Tu TV por internet se corta"
    headlineEm="todo el tiempo? Prueba Stella TV"
    sub="Te ayudamos a revisar tu WiFi y tu equipo antes de activar, y si notas cortes te atendemos por WhatsApp."
    waText="Hola, quiero un servicio de TV por internet sin cortes con Stella TV en Ecuador"
  />

  <ActivationStrip
    whatsapp={STELLA_EC.whatsapp}
    waTag={TAG}
    paymentMethods={STELLA_EC.paymentMethods}
  />

  <EcuadorPlans
    currency={STELLA_EC.currency}
    plans={STELLA_EC.plans}
    whatsapp={STELLA_EC.whatsapp}
    waTag={TAG}
    brand={STELLA_EC.brand}
    features={STELLA_EC.planFeatures}
    paymentMethods={STELLA_EC.paymentMethods}
  />

  <EcuadorShowcase />

  <EcuadorDevices />

  <BeforePaying whatsapp={STELLA_EC.whatsapp} waTag={TAG} paymentText={STELLA_EC.beforePayingText} />

  <EcuadorHowItWorks />

  <Downloads whatsapp={STELLA_EC.whatsapp} waTag={TAG} guideHref="/instalar-stella-tv" />

  <FAQ items={faqItems} />

  <EcuadorCTAFinal
    whatsapp={STELLA_EC.whatsapp}
    waTag={TAG}
    currency={STELLA_EC.currency}
    monthlyOffer={monthly.price}
  />

  <EcuadorInternalSeoLinks links={internalSeoLinks.tvSinCortesEcuador} />
</main>

<Footer whatsapp={STELLA_EC.whatsapp} waTag={TAG} country="Ecuador" pageLinks={EC_FOOTER_PAGES} siteLinks={EC_SITE_LINKS} />

<EcuadorWhatsAppFloat whatsapp={STELLA_EC.whatsapp} waTag={TAG} />

<EcuadorStickyMobileCTA
  whatsapp={STELLA_EC.whatsapp}
  waTag={TAG}
  currency={STELLA_EC.currency}
  monthlyOffer={monthly.price}
/>
