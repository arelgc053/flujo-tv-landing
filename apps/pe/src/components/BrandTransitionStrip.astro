---
interface Props {
  previousBrand: string;
  brand: string;
}
const { previousBrand, brand } = Astro.props;
---
<div class="brand-transition">
  <p><strong>{previousBrand}</strong> evoluciona a <strong>{brand}</strong> — mismo equipo, mejor experiencia.</p>
</div>

<style>
  .brand-transition {
    background: #0a0a0a;
    border-bottom: 1px solid var(--border);
    padding: 8px 20px;
    text-align: center;
  }
  .brand-transition p {
    margin: 0;
    font-size: 0.76rem;
    color: rgba(255, 255, 255, 0.55);
    letter-spacing: 0.01em;
  }
  .brand-transition strong {
    color: rgba(255, 255, 255, 0.82);
    font-weight: 600;
  }
  @media (max-width: 480px) {
    .brand-transition p { font-size: 0.7rem; }
  }
</style>
