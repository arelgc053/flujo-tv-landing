---
import BaseLayout     from '@shared/layouts/BaseLayout.astro';
import Navbar         from '@shared/components/Navbar.astro';
import Hero           from '@shared/components/Hero.astro';
import StatsBar       from '@shared/components/StatsBar.astro';
import HowItWorks     from '@shared/components/HowItWorks.astro';
import Plans          from '@shared/components/Plans.astro';
import Comparison     from '@shared/components/Comparison.astro';
import BeforePaying from '@shared/components/BeforePaying.astro';
import Devices        from '@shared/components/Devices.astro';
import Downloads      from '@shared/components/Downloads.astro';
import FAQ            from '@shared/components/FAQ.astro';
import CTAFinal       from '@shared/components/CTAFinal.astro';
import Footer         from '@shared/components/Footer.astro';
import WhatsAppFloat  from '@shared/components/WhatsAppFloat.astro';
import StickyMobileCTA from '@shared/components/StickyMobileCTA.astro';
import SellerNotice from '@shared/components/SellerNotice.astro';
import { waTag } from '@shared/lib/wa';
import { PE_FOOTER_PAGES, PE_SITE_LINKS, PE_SUBPAGE_NAV, PE_INSTALL_PATH } from '../site';
import InternalSeoLinks from '../components/InternalSeoLinks.astro';
import { internalSeoLinks, seoContent } from '../seoContent';
import { STELLA } from '../stella.config';
import { USD_PLANS, effectiveMonthly } from '@shared/data/stella';

const pageSeo = seoContent.tvPorInternetPeru;
const monthly = STELLA.plans[0];
const TAG = waTag('PE', 'TV-POR-INTERNET');
const priceFrom = `${STELLA.currency}${monthly.price}`;

const faqItems = [
  {
    q: '¿Qué necesito para tener TV por internet en casa?',
    a: 'Solo necesitas un dispositivo Android (TV Box, Fire Stick, celular o tablet) y conexión a internet de al menos 10 Mbps. Nada más. Sin técnicos, sin instalaciones, sin antenas.',
  },
  {
    q: '¿La TV por internet es mejor que el cable?',
    a: 'Para muchos hogares sí: no tiene contrato mínimo, se activa el mismo día por WhatsApp y funciona en TV, celular y tablet Android. El cable suele exigir permanencia y visita técnica.',
  },
  {
    q: '¿Cuánto ahorro al cambiar de cable a Stella TV?',
    a: `Stella TV cuesta desde ${priceFrom} al mes, y con el plan de 12 meses (${STELLA.currency}${USD_PLANS[3].price} con 2 meses gratis) el mes sale en ${STELLA.currency}${effectiveMonthly(USD_PLANS[3])}. Cuánto ahorras depende de lo que pagas hoy por tu cable: compara tu recibo con estos precios. El monto en soles te lo confirmamos antes de pagar.`,
  },
  {
    q: '¿TV por internet funciona en todo el Perú?',
    a: 'Sí. Stella TV funciona en Lima, Arequipa, Trujillo, Cusco, Piura, Iquitos, Huancayo y cualquier ciudad del Perú que tenga internet. Solo necesitas una conexión estable.',
  },
  {
    q: '¿Mis hijos pueden ver sus canales favoritos?',
    a: 'Sí. Stella TV incluye canales de entretenimiento, series, películas y más — con 3 pantallas simultáneas, toda la familia encuentra algo que ver a la vez.',
  },
  {
    q: '¿Funciona en mi Smart TV?',
    a: 'Si tu Smart TV tiene Android TV o Google TV integrado, sí. Si tiene un sistema propio (Samsung Tizen, LG webOS), necesitas conectarle un TV Box Android o un Fire Stick — te asesoramos por WhatsApp sobre qué comprar.',
  },
  {
    q: '¿Hay contrato mínimo o permanencia?',
    a: 'No. Puedes elegir el plan de 1, 3, 6 o 12 meses sin ningún compromiso. Renuevas cuando quieres o cancelas sin penalidades. Sin letras pequeñas.',
  },
  {
    q: '¿Puedo ver canales de señal abierta peruana por internet?',
    a: 'Sí. Stella TV incluye canales nacionales en vivo para que no te pierdas noticias, entretenimiento local ni eventos importantes del país.',
  },
  {
    q: '¿Cómo pago la TV por internet?',
    a: 'Aceptamos Yape y Plin. Yapeas o plineas el monto, nos envías el comprobante por WhatsApp, y en minutos tienes tu acceso activado. Sin tarjetas ni trámites.',
  },
  {
    q: '¿Cuánto tiempo tarda la instalación y activación?',
    a: 'Después de validar el pago te enviamos tus datos de acceso por WhatsApp. La instalación la hacemos contigo por el mismo chat; el tiempo depende de tu equipo y de tu conexión.',
  },
];

const productSchema = {
  name: `${STELLA.brand} — TV por Internet en Perú sin Cable`,
  description: `TV por internet en todo el Perú desde ${priceFrom} al mes. Sin cable, sin contratos. Actívate el mismo día pagando con Yape o Plin.`,
  price: monthly.price,
  priceCurrency: 'USD',
};


const breadcrumb = [
  { name: 'Inicio', url: 'https://oleadatvplus.com/' },
  { name: 'TV por Internet Perú', url: 'https://oleadatvplus.com/tv-por-internet-peru/' },
];
---
<BaseLayout
  title={`TV por Internet en Perú sin Cable — ${STELLA.brand} | Desde ${priceFrom} al mes`}
  description={`TV por internet en todo el Perú sin cable ni contratos desde ${priceFrom}. Activate hoy con Yape o Plin.`}
  keywords="tv por internet peru, canales por internet peru, television por internet peru, tv sin cable peru, reemplazar cable peru, canales online peru, tv digital peru, ver tv online peru, tv por internet barata peru, dejar el cable peru, tv por internet yape, stella tv peru"
  canonical="https://oleadatvplus.com/tv-por-internet-peru/"
  country="PE"
  whatsapp={STELLA.whatsapp}
  lang="es-PE"
  locale="es_PE"
  geoRegion="PE"
  geoPlacename="Lima, Perú"
  geoPosition="-12.0464;-77.0428"
  faqSchema={faqItems}
  productSchema={productSchema}
  organization={{ telephone: `+${STELLA.whatsapp}`, areaServed: STELLA.areaServed }}
  breadcrumb={breadcrumb}
/>

<SellerNotice country="Perú" />
<Navbar whatsapp={STELLA.whatsapp} waTag={TAG} links={PE_SUBPAGE_NAV} />

<main>
  <Hero
    brand={STELLA.brand}
    whatsapp={STELLA.whatsapp}
    waTag={TAG}
    currency={STELLA.currency}
    monthlyOffer={monthly.price}
    headlineTop="TV por internet en todo el Perú"
    headlineEm="sin cable, sin contratos"
    sub={`Paga con Yape o Plin y actívate el mismo día — sin técnicos, sin esperas, sin letra pequeña. Con ${STELLA.brand} desde ${priceFrom} al mes.`}
    badge="La alternativa al cable"
    waText={`Hola, quiero cambiar de cable a TV por internet con ${STELLA.brand}`}
  />

  <StatsBar />
  <HowItWorks whatsapp={STELLA.whatsapp} {...pageSeo.howItWorks} />

  <Plans
    currency={STELLA.currency}
    plans={STELLA.plans}
    whatsapp={STELLA.whatsapp}
    waTag={TAG}
    brand={STELLA.brand}
    features={STELLA.planFeatures}
    paymentMethods={STELLA.paymentMethods}
    paymentNote={STELLA.paymentNote}
  />

  <Comparison currency={STELLA.currency} monthlyOffer={monthly.price} brand={STELLA.brand} />

  <BeforePaying whatsapp={STELLA.whatsapp} waTag={TAG} paymentText={STELLA.beforePayingText} />
  <Devices />
  <Downloads whatsapp={STELLA.whatsapp} waTag={TAG} guideHref={PE_INSTALL_PATH} />
  <FAQ items={faqItems} />

  <CTAFinal
    whatsapp={STELLA.whatsapp}
    waTag={TAG}
    currency={STELLA.currency}
    monthlyOffer={monthly.price}
    brand={STELLA.brand}
  />

  <InternalSeoLinks links={internalSeoLinks.tvPorInternetPeru} />
</main>

<Footer whatsapp={STELLA.whatsapp} waTag={TAG} country="Perú" pageLinks={PE_FOOTER_PAGES} siteLinks={PE_SITE_LINKS} />
<WhatsAppFloat whatsapp={STELLA.whatsapp} waTag={TAG} brand={STELLA.brand} />
<StickyMobileCTA
  whatsapp={STELLA.whatsapp}
  waTag={TAG}
  currency={STELLA.currency}
  monthlyOffer={monthly.price}
  brand={STELLA.brand}
/>
