---
import BaseLayout     from '@shared/layouts/BaseLayout.astro';
import Navbar         from '@shared/components/Navbar.astro';
import Hero           from '@shared/components/Hero.astro';
import StatsBar       from '@shared/components/StatsBar.astro';
import HowItWorks     from '@shared/components/HowItWorks.astro';
import Plans          from '@shared/components/Plans.astro';
import BeforePaying from '@shared/components/BeforePaying.astro';
import Devices        from '@shared/components/Devices.astro';
import Downloads      from '@shared/components/Downloads.astro';
import FAQ            from '@shared/components/FAQ.astro';
import CTAFinal       from '@shared/components/CTAFinal.astro';
import Footer         from '@shared/components/Footer.astro';
import WhatsAppFloat  from '@shared/components/WhatsAppFloat.astro';
import StickyMobileCTA from '@shared/components/StickyMobileCTA.astro';
import SellerNotice from '@shared/components/SellerNotice.astro';
import { waTag } from '@shared/lib/wa';
import { PE_FOOTER_PAGES, PE_SITE_LINKS, PE_SUBPAGE_NAV, PE_INSTALL_PATH } from '../site';
import InternalSeoLinks from '../components/InternalSeoLinks.astro';
import { internalSeoLinks, seoContent } from '../seoContent';
import { STELLA } from '../stella.config';

const pageSeo = seoContent.verDeportesPorInternet;
const monthly = STELLA.plans[0];
const TAG = waTag('PE', 'DEPORTES');
const priceFrom = `${STELLA.currency}${monthly.price}`;

const faqItems = [
  {
    q: '¿Qué deportes puedo ver por internet con Stella TV?',
    a: 'Fútbol nacional e internacional, básquet, tenis, vóley y mucho más — todo en vivo y en Full HD. Para saber exactamente qué eventos incluye el servicio actualmente, escríbenos por WhatsApp y te informamos al detalle.',
  },
  {
    q: '¿Puedo ver el fútbol peruano en vivo por internet?',
    a: 'Sí. Con Stella TV puedes ver partidos de fútbol en vivo directamente desde tu TV Box, celular o tablet. Sin necesidad de cable ni antena, solo conexión a internet.',
  },
  {
    q: '¿La señal de deportes se corta o tiene lag?',
    a: 'Recomendamos al menos 10 Mbps estables para HD. La calidad también depende de tu WiFi y de tu equipo; si notas cortes, te ayudamos a revisarlo por WhatsApp.',
  },
  {
    q: '¿Cuánto internet necesito para ver deportes en HD?',
    a: 'Recomendamos mínimo 10 Mbps para HD y 25 Mbps para 4K. Funciona con cualquier proveedor de internet del Perú.',
  },
  {
    q: '¿Puedo ver deportes en vivo desde mi celular?',
    a: 'Sí. Stella TV es compatible con celulares y tablets Android. Puedes ver tus deportes favoritos desde donde estés, mientras tengas internet móvil o WiFi.',
  },
  {
    q: '¿Cuánto cuesta ver deportes por internet en Perú?',
    a: `Con Stella TV pagas desde ${priceFrom} al mes. Los precios están en dólares y el monto en soles te lo confirmamos antes de pagar con Yape o Plin. Sin contrato ni permanencia.`,
  },
  {
    q: '¿Puedo ver más de un deporte al mismo tiempo?',
    a: 'Cada cuenta incluye 3 pantallas simultáneas — puedes ver distintos contenidos a la vez en distintos dispositivos.',
  },
  {
    q: '¿Cómo activo el servicio para empezar a ver deportes hoy?',
    a: 'Escríbenos por WhatsApp, elige tu plan, paga con Yape o Plin, y en minutos tienes tus credenciales y empiezas a ver. Nuestro soporte te guía en la instalación.',
  },
  {
    q: '¿Necesito comprar algún dispositivo especial?',
    a: 'Si ya tienes un TV Box, Fire Stick, Google TV o Android TV, con eso es suficiente. También funciona en celulares y tablets Android. Si no tienes, te asesoramos qué comprar.',
  },
  {
    q: '¿Puedo ver deportes si estoy en provincia?',
    a: 'Sí. Stella TV funciona en todo el Perú — Lima, Arequipa, Trujillo, Cusco, Piura, Iquitos y cualquier ciudad con internet. No importa dónde estés.',
  },
];

const productSchema = {
  name: `${STELLA.brand} — Ver Deportes por Internet en Perú`,
  description: `Servicio de TV por internet para ver deportes en vivo en Full HD. Fútbol, básquet y más. Actívate hoy pagando con Yape o Plin desde ${priceFrom} al mes.`,
  price: monthly.price,
  priceCurrency: 'USD',
};


const breadcrumb = [
  { name: 'Inicio', url: 'https://oleadatvplus.com/' },
  { name: 'Ver Deportes por Internet', url: 'https://oleadatvplus.com/ver-deportes-por-internet/' },
];
---
<BaseLayout
  title={`Ver Deportes por Internet en Perú — ${STELLA.brand} | Fútbol en vivo desde ${priceFrom}`}
  description={`Ve fútbol y deportes en vivo por internet en Full HD desde ${priceFrom} al mes. Sin cable, sin contratos. Paga con Yape o Plin y actívate en minutos.`}
  keywords="ver deportes por internet peru, futbol en vivo por internet peru, deportes online peru, ver futbol online peru, futbol en vivo hd peru, deportes en vivo sin cable, ver partidos por internet, futbol por internet yape, tv deportes peru, stella tv deportes"
  canonical="https://oleadatvplus.com/ver-deportes-por-internet/"
  country="PE"
  whatsapp={STELLA.whatsapp}
  lang="es-PE"
  locale="es_PE"
  geoRegion="PE"
  geoPlacename="Lima, Perú"
  geoPosition="-12.0464;-77.0428"
  faqSchema={faqItems}
  productSchema={productSchema}
  organization={{ telephone: `+${STELLA.whatsapp}`, areaServed: STELLA.areaServed }}
  breadcrumb={breadcrumb}
/>

<SellerNotice country="Perú" />
<Navbar whatsapp={STELLA.whatsapp} waTag={TAG} links={PE_SUBPAGE_NAV} />

<main>
  <Hero
    brand={STELLA.brand}
    whatsapp={STELLA.whatsapp}
    waTag={TAG}
    currency={STELLA.currency}
    monthlyOffer={monthly.price}
    headlineTop="Ve deportes en vivo por internet"
    headlineEm={`desde ${priceFrom} al mes`}
    sub="Fútbol, básquet y más en Full HD — desde tu TV, celular o tablet. Sin cable, sin contratos, sin esperar técnicos. Actívate hoy."
    badge="Deportes en vivo en Full HD"
    waText={`Hola, quiero ver deportes en vivo por internet con ${STELLA.brand}`}
  />

  <StatsBar />
  <HowItWorks whatsapp={STELLA.whatsapp} {...pageSeo.howItWorks} />

  <Plans
    currency={STELLA.currency}
    plans={STELLA.plans}
    whatsapp={STELLA.whatsapp}
    waTag={TAG}
    brand={STELLA.brand}
    features={STELLA.planFeatures}
    paymentMethods={STELLA.paymentMethods}
    paymentNote={STELLA.paymentNote}
  />

  <BeforePaying whatsapp={STELLA.whatsapp} waTag={TAG} paymentText={STELLA.beforePayingText} />
  <Devices />
  <Downloads whatsapp={STELLA.whatsapp} waTag={TAG} guideHref={PE_INSTALL_PATH} />
  <FAQ items={faqItems} />

  <CTAFinal
    whatsapp={STELLA.whatsapp}
    waTag={TAG}
    currency={STELLA.currency}
    monthlyOffer={monthly.price}
    brand={STELLA.brand}
  />

  <InternalSeoLinks links={internalSeoLinks.verDeportesPorInternet} />
</main>

<Footer whatsapp={STELLA.whatsapp} waTag={TAG} country="Perú" pageLinks={PE_FOOTER_PAGES} siteLinks={PE_SITE_LINKS} />
<WhatsAppFloat whatsapp={STELLA.whatsapp} waTag={TAG} brand={STELLA.brand} />
<StickyMobileCTA
  whatsapp={STELLA.whatsapp}
  waTag={TAG}
  currency={STELLA.currency}
  monthlyOffer={monthly.price}
  brand={STELLA.brand}
/>
