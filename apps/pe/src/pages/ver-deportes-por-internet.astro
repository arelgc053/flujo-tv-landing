---
import BaseLayout     from '@shared/layouts/BaseLayout.astro';
import Navbar         from '@shared/components/Navbar.astro';
import Hero           from '@shared/components/Hero.astro';
import StatsBar       from '@shared/components/StatsBar.astro';
import HowItWorks     from '@shared/components/HowItWorks.astro';
import Plans          from '@shared/components/Plans.astro';
import Testimonials   from '@shared/components/Testimonials.astro';
import Devices        from '@shared/components/Devices.astro';
import FAQ            from '@shared/components/FAQ.astro';
import CTAFinal       from '@shared/components/CTAFinal.astro';
import Footer         from '@shared/components/Footer.astro';
import WhatsAppFloat  from '@shared/components/WhatsAppFloat.astro';
import StickyMobileCTA from '@shared/components/StickyMobileCTA.astro';
import InternalSeoLinks from '../components/InternalSeoLinks.astro';
import { internalSeoLinks, seoContent } from '../seoContent';

const COUNTRY = {
  brand:           'Oleada TV',
  whatsapp:        '51940405911',
  currency:        'S/',
  monthlyOriginal: '15',
  monthlyOffer:    '11.99',
  annualOriginal:  '130',
  annualOffer:     '119.99',
  annualSaving:    '23.89',
  paymentMethods:  ['Yape', 'Plin'],
};

const pageSeo = seoContent.verDeportesPorInternet;

const faqItems = [
  {
    q: '¿Qué deportes puedo ver por internet con Oleada TV?',
    a: 'Fútbol nacional e internacional, básquet, tenis, vóley y mucho más — todo en vivo y en HD. Para saber exactamente qué eventos incluye el servicio actualmente, escríbenos por WhatsApp y te informamos al detalle.',
  },
  {
    q: '¿Puedo ver el fútbol peruano en vivo por internet?',
    a: 'Sí. Con Oleada TV puedes ver partidos de fútbol en vivo directamente desde tu TV Box, celular o tablet. Sin necesidad de cable ni antena, solo conexión a internet.',
  },
  {
    q: '¿La señal de deportes se corta o tiene lag?',
    a: 'Con una conexión de al menos 10 Mbps la señal es estable y sin cortes. La mayoría de nuestros usuarios en Perú tienen excelente experiencia viendo deportes en vivo. Si en algún momento hay algún problema, el soporte responde en minutos.',
  },
  {
    q: '¿Cuánto internet necesito para ver deportes en HD?',
    a: 'Recomendamos mínimo 10 Mbps para HD y 25 Mbps para 4K. Funciona con cualquier proveedor de internet del Perú. Si tu señal es inestable, el servicio se adapta automáticamente para reducir cortes.',
  },
  {
    q: '¿Puedo ver deportes en vivo desde mi celular?',
    a: 'Sí. Oleada TV es compatible con celulares y tablets Android. Puedes ver tus deportes favoritos desde donde estés, mientras tengas internet móvil o WiFi.',
  },
  {
    q: '¿Cuánto cuesta ver deportes por internet en Perú?',
    a: `Con Oleada TV pagas desde S/ ${COUNTRY.monthlyOffer} al mes — mucho menos que el cable tradicional que cobra S/ 80 o más solo por canales deportivos. Sin contrato ni permanencia.`,
  },
  {
    q: '¿Puedo ver más de un deporte al mismo tiempo?',
    a: 'Cada cuenta permite 1 dispositivo activo simultáneo. Si tu familia quiere ver dos cosas a la vez, puedes tener una cuenta adicional. Consúltanos por WhatsApp.',
  },
  {
    q: '¿Cómo activo el servicio para empezar a ver deportes hoy?',
    a: 'Escríbenos por WhatsApp, elige tu plan, paga con Yape o Plin, y en menos de 5 minutos tienes tus credenciales y empiezas a ver. Nuestro soporte te guía en la instalación.',
  },
  {
    q: '¿Necesito comprar algún dispositivo especial?',
    a: 'Si ya tienes un TV Box Android o Amazon Fire Stick, con eso es suficiente. También funciona en celulares y tablets Android. Si no tienes, te asesoramos qué comprar según tu presupuesto.',
  },
  {
    q: '¿Puedo ver deportes si estoy en provincia?',
    a: 'Sí. Oleada TV funciona en todo el Perú — Lima, Arequipa, Trujillo, Cusco, Piura, Iquitos y cualquier ciudad con internet. No importa donde estés.',
  },
];

const productSchema = {
  name: 'Oleada TV — Ver Deportes por Internet en Perú',
  description: 'Servicio de TV por internet para ver deportes en vivo en HD y 4K. Fútbol, básquet y más. Actívate hoy pagando con Yape o Plin desde S/ 11.99 al mes.',
  price: COUNTRY.monthlyOffer,
  priceCurrency: 'PEN',
};

const localBusiness = {
  siteName: 'Oleada TV',
  telephone: '+51940405911',
  priceRange: `S/ ${COUNTRY.monthlyOffer} - S/ ${COUNTRY.annualOffer}`,
  currenciesAccepted: 'PEN',
  paymentAccepted: 'Yape, Plin',
  areaServed: ['Perú', 'Lima', 'Arequipa', 'Trujillo', 'Cusco', 'Piura'],
};

const breadcrumb = [
  { name: 'Inicio', url: 'https://oleadatvplus.com/' },
  { name: 'Ver Deportes por Internet', url: 'https://oleadatvplus.com/ver-deportes-por-internet' },
];
---
<BaseLayout
  title="Ver Deportes por Internet en Perú — Oleada TV | Fútbol en vivo desde S/ 11.99"
  description="Ve fútbol y deportes en vivo por internet en HD y 4K desde S/ 11.99 al mes. Sin cable, sin contratos. Paga con Yape o Plin y actívate en 5 minutos."
  keywords="ver deportes por internet peru, futbol en vivo por internet peru, deportes online peru, ver futbol online peru, futbol en vivo hd peru, deportes en vivo sin cable, ver partidos por internet, futbol por internet yape, tv deportes peru, ver deporte desde celular peru"
  canonical="https://oleadatvplus.com/ver-deportes-por-internet"
  lang="es-PE"
  locale="es_PE"
  geoRegion="PE"
  geoPlacename="Lima, Perú"
  geoPosition="-12.0464;-77.0428"
  faqSchema={faqItems}
  productSchema={productSchema}
  localBusiness={localBusiness}
  breadcrumb={breadcrumb}
/>

<Navbar brand={COUNTRY.brand} whatsapp={COUNTRY.whatsapp} />

<main>
  <Hero
    brand={COUNTRY.brand}
    whatsapp={COUNTRY.whatsapp}
    currency={COUNTRY.currency}
    monthlyOffer={COUNTRY.monthlyOffer}
    headlineTop="Ve deportes en vivo por internet"
    headlineEm="desde S/ 11.99 al mes"
    sub="Fútbol, básquet y más en HD y 4K — desde tu TV, celular o tablet. Sin cable, sin contratos, sin esperar técnicos. Actívate hoy."
    badge="Deportes en vivo en HD y 4K"
    waText="Hola, quiero ver deportes en vivo por internet con Oleada TV"
  />

  <StatsBar />
  <HowItWorks whatsapp={COUNTRY.whatsapp} {...pageSeo.howItWorks} />

  <Plans
    currency={COUNTRY.currency}
    monthlyOriginal={COUNTRY.monthlyOriginal}
    monthlyOffer={COUNTRY.monthlyOffer}
    annualOriginal={COUNTRY.annualOriginal}
    annualOffer={COUNTRY.annualOffer}
    annualSaving={COUNTRY.annualSaving}
    whatsapp={COUNTRY.whatsapp}
    paymentMethods={COUNTRY.paymentMethods}
    {...pageSeo.plans}
  />

  <Testimonials {...pageSeo.testimonials} />
  <Devices {...pageSeo.devices} />
  <FAQ items={faqItems} />

  <CTAFinal
    whatsapp={COUNTRY.whatsapp}
    currency={COUNTRY.currency}
    monthlyOffer={COUNTRY.monthlyOffer}
  />

  <InternalSeoLinks links={internalSeoLinks.verDeportesPorInternet} />
</main>

<Footer brand={COUNTRY.brand} whatsapp={COUNTRY.whatsapp} />
<WhatsAppFloat whatsapp={COUNTRY.whatsapp} />
<StickyMobileCTA
  whatsapp={COUNTRY.whatsapp}
  currency={COUNTRY.currency}
  monthlyOffer={COUNTRY.monthlyOffer}
/>
