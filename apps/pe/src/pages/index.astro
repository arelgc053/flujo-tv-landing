---
import BaseLayout          from '@shared/layouts/BaseLayout.astro';
import Navbar               from '@shared/components/Navbar.astro';
import Hero                  from '@shared/components/Hero.astro';
import StatsBar               from '@shared/components/StatsBar.astro';
import HowItWorks              from '@shared/components/HowItWorks.astro';
import ContentGrid              from '@shared/components/ContentGrid.astro';
import Plans                     from '@shared/components/Plans.astro';
import Comparison                 from '@shared/components/Comparison.astro';
import Testimonials                from '@shared/components/Testimonials.astro';
import Devices                      from '@shared/components/Devices.astro';
import Installation                  from '@shared/components/Installation.astro';
import FAQ                            from '@shared/components/FAQ.astro';
import CTAFinal                        from '@shared/components/CTAFinal.astro';
import Footer                           from '@shared/components/Footer.astro';
import WhatsAppFloat                     from '@shared/components/WhatsAppFloat.astro';
import StickyMobileCTA                    from '@shared/components/StickyMobileCTA.astro';
import BrandTransitionStrip from '../components/BrandTransitionStrip.astro';
import InternalSeoLinks     from '../components/InternalSeoLinks.astro';
import { internalSeoLinks, seoContent, stellaTestimonials } from '../seoContent';
import { STELLA } from '../stella.config';

const pageSeo = seoContent.home;
const monthly = STELLA.plans[0];
const longest = STELLA.plans[STELLA.plans.length - 1];

const faqItems = [
  {
    q: '¿Qué es Stella TV?',
    a: 'Un servicio de streaming por internet con más de 1,000 canales, deportes en vivo, cine de estreno y series en Full HD. Se activa por WhatsApp, sin instalación técnica ni contratos de permanencia.',
  },
  {
    q: '¿Qué dispositivos son compatibles?',
    a: 'Android TV, Google TV, TV Box, Fire Stick, Fire TV Cube, celulares y tablets Android — es un servicio pensado para el ecosistema Android.',
  },
  {
    q: '¿Cómo instalo Stella TV?',
    a: 'En celular o tablet Android descargas el APK directo desde el enlace que te enviamos por WhatsApp. En TV Box, Fire Stick, Google TV o Android TV instalas la app Downloader y usas el código de instalación que te confirmamos al activar tu plan.',
  },
  {
    q: '¿Funciona en Samsung?',
    a: 'Los Smart TV Samsung usan Tizen, que no permite instalar la app de forma nativa. Necesitas conectar un TV Box, Fire Stick o dispositivo con Google TV por HDMI — te asesoramos por WhatsApp cuál te conviene.',
  },
  {
    q: '¿Funciona en LG?',
    a: 'Igual que en Samsung: los Smart TV LG usan webOS y tampoco permiten instalación nativa. Con un TV Box, Fire Stick o Google TV conectado por HDMI, Stella TV funciona sin problema.',
  },
  {
    q: '¿Funciona en Android TV o Google TV?',
    a: 'Sí, de forma nativa. Android TV y Google TV son el entorno para el que está pensado Stella TV, junto con Chromecast con Google TV y Smart TV con Google TV integrado (Sony BRAVIA, TCL, Hisense) — todos usan el mismo método de instalación.',
  },
  {
    q: '¿Cómo uso Downloader?',
    a: 'Downloader es una app gratuita que se descarga desde la Play Store (o la Amazon Appstore en Fire Stick). Ábrela, ingresa el código de instalación que te damos por WhatsApp y descarga Stella TV automáticamente.',
  },
  {
    q: '¿Cuál es el código de instalación?',
    a: 'Te lo confirmamos por WhatsApp en el momento de activar tu plan, así siempre recibes el código vigente.',
  },
  {
    q: '¿Qué incluyen los planes?',
    a: 'Los 4 planes (1, 3, 6 y 12 meses) incluyen exactamente lo mismo: +1,000 canales, 3 pantallas, cine y series VOD, calidad Full HD, soporte 24/7 y activación inmediata. Solo cambia la duración y el ahorro.',
  },
  {
    q: '¿Cuántas pantallas puedo usar?',
    a: 'Cada cuenta incluye 3 pantallas simultáneas, en todos los planes.',
  },
  {
    q: '¿Cómo se activa?',
    a: 'Escríbenos por WhatsApp, elige tu plan, paga con Yape o Plin y recibes tus credenciales en minutos — la activación es inmediata.',
  },
  {
    q: '¿Cómo pago?',
    a: 'Aceptamos Yape y Plin. Es rápido, seguro y no necesitas tarjeta de crédito.',
  },
  {
    q: '¿Cómo recibo soporte?',
    a: 'Por WhatsApp, las 24 horas. Te ayudamos con la instalación, cambios de dispositivo o cualquier duda que tengas.',
  },
];

const productSchema = {
  name: `Plan Mensual ${STELLA.brand} Perú`,
  description: `Plan de streaming ${STELLA.brand} con más de 1,000 canales, deportes en vivo, cine de estreno y series en Full HD. Actívate en minutos pagando con Yape o Plin.`,
  price: monthly.price,
  priceCurrency: 'PEN',
  availability: 'https://schema.org/InStock',
};

const localBusiness = {
  siteName: STELLA.brand,
  telephone: `+${STELLA.whatsapp}`,
  priceRange: `${STELLA.currency} ${monthly.price} - ${STELLA.currency} ${longest.price}`,
  currenciesAccepted: 'PEN',
  paymentAccepted: 'Yape, Plin',
  areaServed: STELLA.areaServed,
};

const breadcrumb = [
  { name: 'Inicio', url: 'https://oleadatvplus.com/' },
  { name: 'Planes', url: 'https://oleadatvplus.com/#planes' },
];
---
<BaseLayout
  title={`${STELLA.brand} Perú | Fútbol y Deportes en Vivo, Cine y Series HD — Activación Inmediata desde S/${monthly.price}`}
  description={`${STELLA.brand} en Perú: +1,000 canales, fútbol y deportes en vivo, cine y series en Full HD. Activación inmediata por WhatsApp, paga con Yape o Plin desde S/${monthly.price} al mes.`}
  keywords="stella tv, stella tv peru, stella tv precio, stella tv soles, stella tv instalacion, stella tv descarga, stella tv apk android, stella tv downloader, instalar stella tv fire stick, stella tv tv box, stella tv android tv, stella tv google tv, stella tv yape, stella tv soporte whatsapp, stella tv planes, stella tv activacion, futbol en vivo peru, deportes en vivo por internet"
  canonical="https://oleadatvplus.com/"
  brand={STELLA.brand}
  whatsapp={STELLA.whatsapp}
  lang="es-PE"
  locale="es_PE"
  geoRegion="PE"
  geoPlacename="Lima, Perú"
  geoPosition="-12.0464;-77.0428"
  alternates={[
    { hreflang: 'es-PE', href: 'https://oleadatvplus.com/' },
    { hreflang: 'es-EC', href: 'https://ec.oleadatvplus.com/' },
    { hreflang: 'x-default', href: 'https://oleadatvplus.com/' },
  ]}
  faqSchema={faqItems}
  productSchema={productSchema}
  aggregateRating={{ ratingValue: STELLA.rating.value, reviewCount: STELLA.rating.count }}
  localBusiness={localBusiness}
  breadcrumb={breadcrumb}
/>

<BrandTransitionStrip previousBrand={STELLA.previousBrand} brand={STELLA.brand} />
<Navbar brand={STELLA.brand} whatsapp={STELLA.whatsapp} />

<main>
  <Hero
    brand={STELLA.brand}
    whatsapp={STELLA.whatsapp}
    currency={STELLA.currency}
    monthlyOffer={monthly.price}
    headlineTop={`${STELLA.brand} para tu hogar`}
    headlineEm="activación simple y soporte real"
    sub={`Más de 1,000 canales, cine, series y deportes en vivo en Full HD. Activa ${STELLA.brand} en minutos, paga con Yape o Plin y recibe soporte cuando lo necesites.`}
    badge={`${STELLA.brand} Perú`}
    waText={`Hola, quiero activar ${STELLA.brand}`}
  />

  <StatsBar />

  <HowItWorks whatsapp={STELLA.whatsapp} {...pageSeo.howItWorks} />

  <ContentGrid />

  <Plans
    currency={STELLA.currency}
    plans={STELLA.plans}
    whatsapp={STELLA.whatsapp}
    brand={STELLA.brand}
    features={STELLA.planFeatures}
    paymentMethods={STELLA.paymentMethods}
  />

  <Comparison
    currency={STELLA.currency}
    monthlyOffer={monthly.price}
    brand={STELLA.brand}
  />

  <Testimonials testimonials={stellaTestimonials} />

  <Devices />

  <Installation
    whatsapp={STELLA.whatsapp}
    brand={STELLA.brand}
    downloaderCode={STELLA.downloaderCode}
  />

  <FAQ items={faqItems} />

  <CTAFinal
    whatsapp={STELLA.whatsapp}
    currency={STELLA.currency}
    monthlyOffer={monthly.price}
    brand={STELLA.brand}
  />

  <InternalSeoLinks links={internalSeoLinks.home} />
</main>

<Footer brand={STELLA.brand} whatsapp={STELLA.whatsapp} />

<WhatsAppFloat whatsapp={STELLA.whatsapp} brand={STELLA.brand} />

<StickyMobileCTA
  whatsapp={STELLA.whatsapp}
  currency={STELLA.currency}
  monthlyOffer={monthly.price}
  brand={STELLA.brand}
/>
