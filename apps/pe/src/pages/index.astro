---
import BaseLayout          from '@shared/layouts/BaseLayout.astro';
import Navbar               from '@shared/components/Navbar.astro';
import Hero                  from '@shared/components/Hero.astro';
import StatsBar               from '@shared/components/StatsBar.astro';
import HowItWorks              from '@shared/components/HowItWorks.astro';
import ContentGrid              from '@shared/components/ContentGrid.astro';
import Plans                     from '@shared/components/Plans.astro';
import Comparison                 from '@shared/components/Comparison.astro';
import BeforePaying from '@shared/components/BeforePaying.astro';
import Devices                      from '@shared/components/Devices.astro';
import Downloads                     from '@shared/components/Downloads.astro';
import FAQ                            from '@shared/components/FAQ.astro';
import CTAFinal                        from '@shared/components/CTAFinal.astro';
import Footer                           from '@shared/components/Footer.astro';
import WhatsAppFloat                     from '@shared/components/WhatsAppFloat.astro';
import StickyMobileCTA                    from '@shared/components/StickyMobileCTA.astro';
import SellerNotice         from '@shared/components/SellerNotice.astro';
import InternalSeoLinks     from '../components/InternalSeoLinks.astro';
import { internalSeoLinks, seoContent } from '../seoContent';
import { STELLA } from '../stella.config';
import { PE_FOOTER_PAGES, PE_HOME_NAV, PE_INSTALL_PATH, PE_SITE_LINKS } from '../site';
import { DOWNLOADS } from '@shared/data/stella';
import { homeAlternates } from '@shared/data/sites';
import { waTag } from '@shared/lib/wa';

const pageSeo = seoContent.home;
const monthly = STELLA.plans[0];
const TAG = waTag('PE', 'HOME');
const priceFrom = `${STELLA.currency}${monthly.price}`;
const [p1, p3, p6, p12] = STELLA.plans;

const faqItems = [
  {
    q: '¿Qué es Stella TV y quién lo vende en este sitio?',
    a: 'Stella TV es un servicio de streaming por internet con más de 1,000 canales, deportes en vivo, cine y series en Full HD. En este sitio lo comercializa Oleada TV: contratas, pagas y recibes soporte por WhatsApp con nosotros.',
  },
  {
    q: '¿Cuánto cuesta Stella TV en Perú?',
    a: `1 mes ${STELLA.currency}${p1.price}, 3 meses ${STELLA.currency}${p3.price}, 6 meses ${STELLA.currency}${p6.price} (con 1 mes gratis) y 12 meses ${STELLA.currency}${p12.price} (con 2 meses gratis). Los precios están en dólares; pagas con Yape o Plin y te confirmamos el monto en soles antes de pagar.`,
  },
  {
    q: '¿Qué dispositivos son compatibles?',
    a: 'Android TV, Google TV, TV Box, Fire TV Stick, Fire TV Cube, celulares y tablets Android — es un servicio pensado para el ecosistema Android. No hay versión para iPhone ni iPad.',
  },
  {
    q: '¿Cómo instalo Stella TV?',
    a: `En celular o tablet Android descargas el APK directo (versión ${DOWNLOADS.mobile.version}) desde la sección de descargas. En TV Box, Fire TV, Google TV o Android TV instalas la app Downloader y usas el código ${DOWNLOADS.tv.downloaderCode}.`,
  },
  {
    q: '¿Funciona en Samsung?',
    a: 'Los Smart TV Samsung usan Tizen, que no permite instalar la app de forma nativa. Necesitas conectar un TV Box, Fire Stick o dispositivo con Google TV por HDMI — te asesoramos por WhatsApp cuál te conviene.',
  },
  {
    q: '¿Funciona en LG?',
    a: 'Igual que en Samsung: los Smart TV LG usan webOS y tampoco permiten instalación nativa. Con un TV Box, Fire Stick o Google TV conectado por HDMI, Stella TV funciona sin problema.',
  },
  {
    q: '¿Funciona en Android TV o Google TV?',
    a: 'Sí, de forma nativa. Android TV y Google TV son el entorno para el que está pensado Stella TV, junto con Chromecast con Google TV y Smart TV con Google TV integrado (Sony BRAVIA, TCL, Hisense) — todos usan el mismo método de instalación.',
  },
  {
    q: '¿Cómo uso Downloader?',
    a: `Downloader es una app gratuita que se descarga desde Google Play (o la Appstore de Amazon en Fire TV). Ábrela, escribe el código ${DOWNLOADS.tv.downloaderCode} y se descarga Stella TV. En el celular no hace falta: basta con el APK directo.`,
  },
  {
    q: '¿Cuál es el código de instalación de Stella TV?',
    a: `Para televisores el código Downloader vigente es ${DOWNLOADS.tv.downloaderCode}. El ${DOWNLOADS.legacyCodes.join(' / ')} es un código anterior y ya no corresponde usarlo. Para celular hay un código alternativo, ${DOWNLOADS.mobile.downloaderCode}, aunque basta con el APK directo.`,
  },
  {
    q: '¿Qué incluyen los planes?',
    a: 'Los 4 planes (1, 3, 6 y 12 meses) incluyen exactamente lo mismo: +1,000 canales, 3 pantallas, cine y series a demanda, calidad Full HD y soporte por WhatsApp. Solo cambia la duración y el ahorro.',
  },
  {
    q: '¿Cuántas pantallas puedo usar?',
    a: 'Cada cuenta incluye 3 pantallas simultáneas, en todos los planes.',
  },
  {
    q: '¿Cómo se activa?',
    a: 'Escríbenos por WhatsApp, elige tu plan, te confirmamos el monto en soles, pagas con Yape o Plin y te enviamos tus credenciales.',
  },
  {
    q: '¿Cómo pago?',
    a: 'Con Yape o Plin, sin tarjeta de crédito. Los precios se publican en dólares y antes de pagar te confirmamos por WhatsApp el monto final en soles.',
  },
  {
    q: '¿Cómo recibo soporte?',
    a: 'Por WhatsApp. Te ayudamos con la instalación, cambios de dispositivo o cualquier duda que tengas.',
  },
];

const productSchema = {
  name: `Plan Mensual ${STELLA.brand} Perú`,
  description: `Plan mensual de ${STELLA.brand} para Perú: más de 1,000 canales, deportes en vivo, cine y series en Full HD. ${priceFrom} al mes, pago con Yape o Plin. Vendido por Oleada TV.`,
  price: monthly.price,
  priceCurrency: 'USD',
  availability: 'https://schema.org/InStock',
};


---
<BaseLayout
  title={`${STELLA.brand} Perú | Fútbol y Deportes en Vivo, Cine y Series HD — Activación Inmediata desde ${priceFrom}`}
  description={`${STELLA.brand} en Perú: +1,000 canales, fútbol y deportes en vivo, cine y series en Full HD. Paga con Yape o Plin desde ${priceFrom} al mes. Código Downloader ${DOWNLOADS.tv.downloaderCode}.`}
  keywords="stella tv, stella tv peru, stella tv precio, stella tv dolares, stella tv instalacion, stella tv descarga, stella tv apk android, stella tv downloader, instalar stella tv fire stick, stella tv tv box, stella tv android tv, stella tv google tv, stella tv yape, stella tv soporte whatsapp, stella tv planes, stella tv activacion, futbol en vivo peru, deportes en vivo por internet"
  canonical="https://oleadatvplus.com/"
  country="PE"
  whatsapp={STELLA.whatsapp}
  lang="es-PE"
  locale="es_PE"
  geoRegion="PE"
  geoPlacename="Lima, Perú"
  geoPosition="-12.0464;-77.0428"
  alternates={homeAlternates('pe')}
  faqSchema={faqItems}
  productSchema={productSchema}
  organization={{ telephone: `+${STELLA.whatsapp}`, areaServed: STELLA.areaServed }}
/>

<SellerNotice country="Perú" />
<Navbar whatsapp={STELLA.whatsapp} waTag={TAG} links={PE_HOME_NAV} />

<main>
  <Hero
    brand={STELLA.brand}
    whatsapp={STELLA.whatsapp}
    waTag={TAG}
    currency={STELLA.currency}
    monthlyOffer={monthly.price}
    headlineTop={`${STELLA.brand} para tu hogar`}
    headlineEm="activación simple y soporte real"
    sub={`Más de 1,000 canales, cine, series y deportes en vivo en Full HD. Activa ${STELLA.brand} en minutos, paga con Yape o Plin y recibe soporte cuando lo necesites.`}
    badge="Oleada TV · Stella TV en Perú"
    waText={`Hola, quiero contratar ${STELLA.brand} en Perú.`}
    trustBadges={[`Desde ${priceFrom}/mes`, 'Yape y Plin', 'Sin contrato', 'Ayuda por WhatsApp']}
    microcopy="Te confirmamos el monto en soles antes de que pagues"
  />

  <StatsBar />

  <HowItWorks whatsapp={STELLA.whatsapp} {...pageSeo.howItWorks} />

  <ContentGrid />

  <Plans
    currency={STELLA.currency}
    plans={STELLA.plans}
    whatsapp={STELLA.whatsapp}
    waTag={TAG}
    brand={STELLA.brand}
    features={STELLA.planFeatures}
    paymentMethods={STELLA.paymentMethods}
    subtitle="Precios en dólares · Sin contratos · Sin permanencia"
    paymentNote={STELLA.paymentNote}
  />

  <Comparison
    currency={STELLA.currency}
    monthlyOffer={monthly.price}
    brand={STELLA.brand}
  />

  <BeforePaying whatsapp={STELLA.whatsapp} waTag={TAG} paymentText={STELLA.beforePayingText} />

  <Devices />

  <Downloads whatsapp={STELLA.whatsapp} waTag={TAG} guideHref={PE_INSTALL_PATH} />

  <FAQ items={faqItems} />

  <CTAFinal
    whatsapp={STELLA.whatsapp}
    waTag={TAG}
    currency={STELLA.currency}
    monthlyOffer={monthly.price}
    brand={STELLA.brand}
  />

  <InternalSeoLinks links={internalSeoLinks.home} />
</main>

<Footer whatsapp={STELLA.whatsapp} waTag={TAG} country="Perú" pageLinks={PE_FOOTER_PAGES} siteLinks={PE_SITE_LINKS} />

<WhatsAppFloat whatsapp={STELLA.whatsapp} waTag={TAG} brand={STELLA.brand} />

<StickyMobileCTA
  whatsapp={STELLA.whatsapp}
  waTag={TAG}
  currency={STELLA.currency}
  monthlyOffer={monthly.price}
  brand={STELLA.brand}
/>
