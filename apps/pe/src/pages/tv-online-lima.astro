---
import BaseLayout     from '@shared/layouts/BaseLayout.astro';
import Navbar         from '@shared/components/Navbar.astro';
import Hero           from '@shared/components/Hero.astro';
import StatsBar       from '@shared/components/StatsBar.astro';
import HowItWorks     from '@shared/components/HowItWorks.astro';
import Plans          from '@shared/components/Plans.astro';
import Testimonials   from '@shared/components/Testimonials.astro';
import Devices        from '@shared/components/Devices.astro';
import FAQ            from '@shared/components/FAQ.astro';
import CTAFinal       from '@shared/components/CTAFinal.astro';
import Footer         from '@shared/components/Footer.astro';
import WhatsAppFloat  from '@shared/components/WhatsAppFloat.astro';
import StickyMobileCTA from '@shared/components/StickyMobileCTA.astro';
import InternalSeoLinks from '../components/InternalSeoLinks.astro';
import { internalSeoLinks, seoContent } from '../seoContent';

const COUNTRY = {
  brand:           'Oleada TV',
  whatsapp:        '51940405911',
  currency:        'S/',
  monthlyOriginal: '15',
  monthlyOffer:    '11.99',
  annualOriginal:  '130',
  annualOffer:     '119.99',
  annualSaving:    '23.89',
  paymentMethods:  ['Yape', 'Plin'],
};

const pageSeo = seoContent.tvOnlineLima;

const faqItems = [
  {
    q: '¿Oleada TV funciona bien en Lima?',
    a: 'Sí. Lima es nuestra zona con más usuarios activos. Con cualquier proveedor de internet en Lima — WiFi o datos móviles — el servicio funciona sin problemas desde el primer día.',
  },
  {
    q: '¿Funciona en todos los distritos de Lima?',
    a: 'Sí. Lima Norte, Lima Sur, Lima Este, Lima Centro, Callao — Oleada TV funciona en todos los distritos. No hay zonas excluidas dentro de Lima.',
  },
  {
    q: '¿Cómo activo Oleada TV en Lima hoy mismo?',
    a: 'Escríbenos por WhatsApp, elige tu plan, paga con Yape o Plin, y en menos de 5 minutos tienes tus credenciales. Nuestro soporte te guía en la instalación en tu dispositivo paso a paso.',
  },
  {
    q: '¿Puedo pagar con Yape desde cualquier banco en Lima?',
    a: 'Sí. Yape funciona con BCP, Interbank, BBVA, Scotiabank y más. También aceptamos Plin (BBVA, Interbank, Scotiabank, BanBif). Solo necesitas tu celular.',
  },
  {
    q: '¿Tienen soporte en Lima o es solo por internet?',
    a: 'Nuestro soporte es 100% por WhatsApp — eso nos permite atenderte más rápido que cualquier call center. Respondemos en menos de 5 minutos en horario extendido, desde cualquier distrito de Lima.',
  },
  {
    q: '¿Cuánto tiempo tarda la activación en Lima?',
    a: 'En menos de 5 minutos tras confirmar tu pago. No hay demoras, no hay visitas técnicas, no hay esperas. Todo se hace por WhatsApp desde tu celular.',
  },
  {
    q: '¿Funciona con WiFi de casa o necesito internet especial?',
    a: 'Funciona con cualquier WiFi doméstico en Lima. Recomendamos mínimo 10 Mbps para HD. Si no sabes cuántos Mbps tienes, te ayudamos a revisarlo por WhatsApp.',
  },
  {
    q: '¿Puedo ver canales peruanos en vivo desde Lima?',
    a: 'Sí. Oleada TV incluye canales nacionales en vivo para que veas noticias, programas locales y eventos peruanos sin perderte nada.',
  },
  {
    q: '¿Qué dispositivo necesito en Lima para usar Oleada TV?',
    a: 'Un TV Box Android, Amazon Fire Stick, celular Android o tablet. Si no tienes ninguno, te asesoramos cuál comprar según tu presupuesto — hay opciones desde S/ 80 en Lima.',
  },
  {
    q: '¿Hay contrato o puedo cancelar cuando quiera?',
    a: 'Sin contrato, sin permanencia. Pagas el mes que quieres y listo. Si decides no continuar, simplemente no renuevas — sin penalidades ni trámites.',
  },
];

const productSchema = {
  name: 'Oleada TV Lima — TV Online sin Cable',
  description: 'TV online en Lima sin cable ni contratos desde S/ 11.99. Actívate hoy mismo pagando con Yape o Plin. Disponible en todos los distritos de Lima.',
  price: COUNTRY.monthlyOffer,
  priceCurrency: 'PEN',
};

const localBusiness = {
  siteName: 'Oleada TV',
  telephone: '+51940405911',
  priceRange: `S/ ${COUNTRY.monthlyOffer} - S/ ${COUNTRY.annualOffer}`,
  currenciesAccepted: 'PEN',
  paymentAccepted: 'Yape, Plin',
  areaServed: ['Lima', 'Lima Norte', 'Lima Sur', 'Lima Este', 'Callao', 'Miraflores', 'San Isidro', 'Surco', 'San Juan de Lurigancho'],
};

const breadcrumb = [
  { name: 'Inicio', url: 'https://oleadatvplus.com/' },
  { name: 'TV Online Lima', url: 'https://oleadatvplus.com/tv-online-lima/' },
];
---
<BaseLayout
  title="TV Online en Lima sin Cable — Oleada TV | Actívate con Yape en 5 minutos"
  description="TV online en Lima sin cable ni contratos desde S/ 11.99. El servicio favorito de los limeños. Paga con Yape y actívate en 5 minutos. Sin técnicos ni esperas."
  keywords="tv online lima, tv por internet lima, canales online lima, ver tv lima peru, television online lima, canales por internet lima, tv sin cable lima, ver tv en vivo lima, tv digital lima, activar tv yape lima, canales lima peru"
  canonical="https://oleadatvplus.com/tv-online-lima/"
  lang="es-PE"
  locale="es_PE"
  geoRegion="PE-LIM"
  geoPlacename="Lima, Perú"
  geoPosition="-12.0464;-77.0428"
  faqSchema={faqItems}
  productSchema={productSchema}
  localBusiness={localBusiness}
  breadcrumb={breadcrumb}
/>

<Navbar brand={COUNTRY.brand} whatsapp={COUNTRY.whatsapp} />

<main>
  <Hero
    brand={COUNTRY.brand}
    whatsapp={COUNTRY.whatsapp}
    currency={COUNTRY.currency}
    monthlyOffer={COUNTRY.monthlyOffer}
    headlineTop="TV online en Lima"
    headlineEm="actívate hoy, paga con Yape"
    sub="El servicio de TV por internet favorito de los limeños. Sin técnicos, sin visitas, sin esperar. Yapeas y en 5 minutos estás viendo."
    badge="El más popular en Lima"
    waText="Hola, quiero activar Oleada TV en Lima"
  />

  <StatsBar />
  <HowItWorks whatsapp={COUNTRY.whatsapp} {...pageSeo.howItWorks} />

  <Plans
    currency={COUNTRY.currency}
    monthlyOriginal={COUNTRY.monthlyOriginal}
    monthlyOffer={COUNTRY.monthlyOffer}
    annualOriginal={COUNTRY.annualOriginal}
    annualOffer={COUNTRY.annualOffer}
    annualSaving={COUNTRY.annualSaving}
    whatsapp={COUNTRY.whatsapp}
    paymentMethods={COUNTRY.paymentMethods}
    {...pageSeo.plans}
  />

  <Testimonials {...pageSeo.testimonials} />
  <Devices {...pageSeo.devices} />
  <FAQ items={faqItems} />

  <CTAFinal
    whatsapp={COUNTRY.whatsapp}
    currency={COUNTRY.currency}
    monthlyOffer={COUNTRY.monthlyOffer}
  />

  <InternalSeoLinks links={internalSeoLinks.tvOnlineLima} />
</main>

<Footer brand={COUNTRY.brand} whatsapp={COUNTRY.whatsapp} />
<WhatsAppFloat whatsapp={COUNTRY.whatsapp} />
<StickyMobileCTA
  whatsapp={COUNTRY.whatsapp}
  currency={COUNTRY.currency}
  monthlyOffer={COUNTRY.monthlyOffer}
/>
