---
import BaseLayout     from '@shared/layouts/BaseLayout.astro';
import Navbar         from '@shared/components/Navbar.astro';
import Hero           from '@shared/components/Hero.astro';
import StatsBar       from '@shared/components/StatsBar.astro';
import HowItWorks     from '@shared/components/HowItWorks.astro';
import Plans          from '@shared/components/Plans.astro';
import BeforePaying from '@shared/components/BeforePaying.astro';
import Devices        from '@shared/components/Devices.astro';
import Downloads      from '@shared/components/Downloads.astro';
import FAQ            from '@shared/components/FAQ.astro';
import CTAFinal       from '@shared/components/CTAFinal.astro';
import Footer         from '@shared/components/Footer.astro';
import WhatsAppFloat  from '@shared/components/WhatsAppFloat.astro';
import StickyMobileCTA from '@shared/components/StickyMobileCTA.astro';
import SellerNotice from '@shared/components/SellerNotice.astro';
import { waTag } from '@shared/lib/wa';
import { PE_FOOTER_PAGES, PE_SITE_LINKS, PE_SUBPAGE_NAV, PE_INSTALL_PATH } from '../site';
import InternalSeoLinks from '../components/InternalSeoLinks.astro';
import { internalSeoLinks, seoContent } from '../seoContent';
import { STELLA } from '../stella.config';

const pageSeo = seoContent.pagaConYape;
const monthly = STELLA.plans[0];
const TAG = waTag('PE', 'YAPE');
const priceFrom = `${STELLA.currency}${monthly.price}`;

const faqItems = [
  {
    q: '¿Cómo pago con Yape para activar mi TV?',
    a: 'Escríbenos por WhatsApp, elige tu plan y te confirmamos el monto en soles y el número de Yape. Yapeas, nos mandas la captura de pantalla y, al validar el pago, te enviamos tu acceso.',
  },
  {
    q: '¿Es seguro pagar con Yape para este servicio?',
    a: 'Sí. Yape es instantáneo y el pago queda registrado en tu app, así que siempre tienes el comprobante.',
  },
  {
    q: '¿También aceptan Plin?',
    a: 'Sí. Plin funciona exactamente igual que Yape — transfieres desde BBVA, Interbank, Scotiabank o BanBif y nos avisas por WhatsApp. El proceso es el mismo.',
  },
  {
    q: '¿Qué pasa si hago el Yape y no recibo mi acceso?',
    a: 'Escríbenos por WhatsApp con la captura del pago y lo revisamos. El acceso se envía en cuanto el pago queda validado.',
  },
  {
    q: '¿Puedo pagar mensual con Yape cada mes?',
    a: 'Sí. Cada vez que quieras renovar, simplemente yapeas el monto del plan y nos avisas. Sin tarjetas, sin cargos automáticos, sin sorpresas. Tú controlas cuándo y cuánto pagas.',
  },
  {
    q: '¿Cuánto tiempo después de yapear me activan?',
    a: 'En cuanto validamos el pago te enviamos las credenciales por el mismo WhatsApp.',
  },
  {
    q: '¿Aceptan otros métodos de pago además de Yape?',
    a: 'Sí, también aceptamos Plin. Si tienes otro método disponible, consúltanos por WhatsApp y te indicamos cómo proceder.',
  },
  {
    q: '¿Necesito compartir datos personales para pagar con Yape?',
    a: 'No. Solo compartes el número de WhatsApp al que nos escribes. El Yape lo haces tú desde tu app al número que te indicamos — sin formularios ni datos extras.',
  },
  {
    q: '¿Puedo pagar con Yape aunque sea la primera vez?',
    a: 'Sí. No hay diferencia entre clientes nuevos y recurrentes — el proceso es siempre igual. Escríbenos, confirmas el pago y listo.',
  },
  {
    q: '¿Hay algún costo adicional por pagar con Yape?',
    a: `No. Los precios se publican en dólares (desde ${priceFrom} al mes) y antes de pagar te confirmamos el monto final en soles: ese es el monto que yapeas o plineas.`,
  },
];

const productSchema = {
  name: `${STELLA.brand} — TV por Internet con Pago por Yape`,
  description: `Activa tu TV por internet pagando con Yape o Plin. En minutos tienes tu acceso. Desde ${priceFrom} al mes sin tarjetas ni contratos.`,
  price: monthly.price,
  priceCurrency: 'USD',
};


const breadcrumb = [
  { name: 'Inicio', url: 'https://oleadatvplus.com/' },
  { name: 'Paga con Yape', url: 'https://oleadatvplus.com/paga-con-yape/' },
];
---
<BaseLayout
  title={`TV por Internet con Yape en Perú — ${STELLA.brand} | Activación por WhatsApp`}
  description={`Activa tu TV por internet pagando con Yape o Plin. En minutos tienes acceso en tu TV Box, celular o tablet. Desde ${priceFrom} al mes.`}
  keywords="tv por internet yape peru, activar tv con yape, pagar tv online yape, tv yape peru, suscripcion tv yape, tv por internet plin peru, canales online yape, activar tv sin tarjeta peru, tv digital yape peru, stella tv yape"
  canonical="https://oleadatvplus.com/paga-con-yape/"
  country="PE"
  whatsapp={STELLA.whatsapp}
  lang="es-PE"
  locale="es_PE"
  geoRegion="PE"
  geoPlacename="Lima, Perú"
  geoPosition="-12.0464;-77.0428"
  faqSchema={faqItems}
  productSchema={productSchema}
  organization={{ telephone: `+${STELLA.whatsapp}`, areaServed: STELLA.areaServed }}
  breadcrumb={breadcrumb}
/>

<SellerNotice country="Perú" />
<Navbar whatsapp={STELLA.whatsapp} waTag={TAG} links={PE_SUBPAGE_NAV} />

<main>
  <Hero
    brand={STELLA.brand}
    whatsapp={STELLA.whatsapp}
    waTag={TAG}
    currency={STELLA.currency}
    monthlyOffer={monthly.price}
    headlineTop="Paga con Yape y ten tu TV"
    headlineEm="lista en minutos"
    sub={`La forma más fácil de activar ${STELLA.brand}. Yapeas o plineas el monto, nos avisas por WhatsApp, y listo — sin tarjetas, sin formularios, sin esperas.`}
    badge="Paga con Yape o Plin"
    waText={`Hola, quiero pagar con Yape y activar ${STELLA.brand}`}
  />

  <StatsBar />
  <HowItWorks whatsapp={STELLA.whatsapp} {...pageSeo.howItWorks} />

  <Plans
    currency={STELLA.currency}
    plans={STELLA.plans}
    whatsapp={STELLA.whatsapp}
    waTag={TAG}
    brand={STELLA.brand}
    features={STELLA.planFeatures}
    paymentMethods={STELLA.paymentMethods}
    paymentNote={STELLA.paymentNote}
  />

  <BeforePaying whatsapp={STELLA.whatsapp} waTag={TAG} paymentText={STELLA.beforePayingText} />
  <Devices />
  <Downloads whatsapp={STELLA.whatsapp} waTag={TAG} guideHref={PE_INSTALL_PATH} />
  <FAQ items={faqItems} />

  <CTAFinal
    whatsapp={STELLA.whatsapp}
    waTag={TAG}
    currency={STELLA.currency}
    monthlyOffer={monthly.price}
    brand={STELLA.brand}
  />

  <InternalSeoLinks links={internalSeoLinks.pagaConYape} />
</main>

<Footer whatsapp={STELLA.whatsapp} waTag={TAG} country="Perú" pageLinks={PE_FOOTER_PAGES} siteLinks={PE_SITE_LINKS} />
<WhatsAppFloat whatsapp={STELLA.whatsapp} waTag={TAG} brand={STELLA.brand} />
<StickyMobileCTA
  whatsapp={STELLA.whatsapp}
  waTag={TAG}
  currency={STELLA.currency}
  monthlyOffer={monthly.price}
  brand={STELLA.brand}
/>
