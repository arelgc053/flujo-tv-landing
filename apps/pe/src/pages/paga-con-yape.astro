---
import BaseLayout     from '@shared/layouts/BaseLayout.astro';
import Navbar         from '@shared/components/Navbar.astro';
import Hero           from '@shared/components/Hero.astro';
import StatsBar       from '@shared/components/StatsBar.astro';
import HowItWorks     from '@shared/components/HowItWorks.astro';
import Plans          from '@shared/components/Plans.astro';
import Testimonials   from '@shared/components/Testimonials.astro';
import Devices        from '@shared/components/Devices.astro';
import FAQ            from '@shared/components/FAQ.astro';
import CTAFinal       from '@shared/components/CTAFinal.astro';
import Footer         from '@shared/components/Footer.astro';
import WhatsAppFloat  from '@shared/components/WhatsAppFloat.astro';
import StickyMobileCTA from '@shared/components/StickyMobileCTA.astro';
import InternalSeoLinks from '../components/InternalSeoLinks.astro';
import { internalSeoLinks, seoContent } from '../seoContent';

const COUNTRY = {
  brand:           'Oleada TV',
  whatsapp:        '51940405911',
  currency:        'S/',
  monthlyOriginal: '15',
  monthlyOffer:    '11.99',
  annualOriginal:  '130',
  annualOffer:     '119.99',
  annualSaving:    '23.89',
  paymentMethods:  ['Yape', 'Plin'],
};

const pageSeo = seoContent.pagaConYape;

const faqItems = [
  {
    q: '¿Cómo pago con Yape para activar mi TV?',
    a: 'Escríbenos por WhatsApp, elige tu plan y te damos el número de Yape. Yapeas el monto, nos mandas el captura de pantalla, y en menos de 5 minutos tienes tu acceso activado.',
  },
  {
    q: '¿Es seguro pagar con Yape para este servicio?',
    a: 'Sí. Yape es el método de pago más usado en Perú porque es instantáneo y queda registrado. Más de 5,000 clientes nuestros pagaron con Yape sin ningún problema.',
  },
  {
    q: '¿También aceptan Plin?',
    a: 'Sí. Plin funciona exactamente igual que Yape — transfieres desde BBVA, Interbank, Scotiabank o BanBif y nos avisas por WhatsApp. El proceso es el mismo.',
  },
  {
    q: '¿Qué pasa si hago el Yape y no recibo mi acceso?',
    a: 'Eso no ocurre. Pero si por alguna razón hay demora, nuestro soporte por WhatsApp está disponible todo el día. Respondemos en menos de 5 minutos y resolvemos de inmediato. Siempre tienes respaldo.',
  },
  {
    q: '¿Puedo pagar mensual con Yape cada mes?',
    a: 'Sí. Cada mes que quieras renovar, simplemente yapeas el monto del plan y nos avisas. Sin tarjetas, sin cargos automáticos, sin sorpresas. Tú controlas cuándo y cuánto pagas.',
  },
  {
    q: '¿Cuánto tiempo después de yapear me activan?',
    a: 'En menos de 5 minutos en promedio. Nuestro equipo confirma el pago al instante y te envía las credenciales por el mismo WhatsApp. Es el proceso más rápido del mercado.',
  },
  {
    q: '¿Aceptan otros métodos de pago además de Yape?',
    a: 'Sí, también aceptamos Plin y transferencias bancarias. Si tienes otro método disponible, consúltanos por WhatsApp y te indicamos cómo proceder.',
  },
  {
    q: '¿Necesito compartir datos personales para pagar con Yape?',
    a: 'No. Solo compartes el número de WhatsApp al que nos escribes. El Yape lo haces tú desde tu app al número que te indicamos — sin formularios ni datos extras.',
  },
  {
    q: '¿Puedo pagar con Yape aunque sea la primera vez?',
    a: 'Sí. No hay diferencia entre clientes nuevos y recurrentes — el proceso es siempre igual. Escríbenos, confirmas el pago y listo.',
  },
  {
    q: '¿Hay algún costo adicional por pagar con Yape?',
    a: 'No. El precio que te damos es el precio final — S/ 11.99 al mes o S/ 119.99 al año. Yape no cobra comisión al que paga, solo al comercio, y nosotros no te trasladamos ese costo.',
  },
];

const productSchema = {
  name: 'Oleada TV — TV por Internet con Pago por Yape',
  description: 'Activa tu TV por internet pagando con Yape o Plin. En menos de 5 minutos tienes tu acceso. Desde S/ 11.99 al mes sin tarjetas ni contratos.',
  price: COUNTRY.monthlyOffer,
  priceCurrency: 'PEN',
};

const localBusiness = {
  siteName: 'Oleada TV',
  telephone: '+51940405911',
  priceRange: `S/ ${COUNTRY.monthlyOffer} - S/ ${COUNTRY.annualOffer}`,
  currenciesAccepted: 'PEN',
  paymentAccepted: 'Yape, Plin, Transferencia Bancaria',
  areaServed: ['Perú', 'Lima', 'Arequipa', 'Trujillo', 'Cusco', 'Piura'],
};

const breadcrumb = [
  { name: 'Inicio', url: 'https://oleadatvplus.com/' },
  { name: 'Paga con Yape', url: 'https://oleadatvplus.com/paga-con-yape/' },
];
---
<BaseLayout
  title="TV por Internet con Yape en Perú — Oleada TV | Actívate en 5 minutos"
  description="Activa tu TV por internet pagando con Yape o Plin. En menos de 5 minutos tienes acceso en tu TV Box, celular o tablet. Desde S/ 11.99 al mes."
  keywords="tv por internet yape peru, activar tv con yape, pagar tv online yape, tv yape peru, suscripcion tv yape, tv por internet plin peru, canales online yape, activar tv sin tarjeta peru, tv digital yape peru, oleada tv yape"
  canonical="https://oleadatvplus.com/paga-con-yape/"
  lang="es-PE"
  locale="es_PE"
  geoRegion="PE"
  geoPlacename="Lima, Perú"
  geoPosition="-12.0464;-77.0428"
  faqSchema={faqItems}
  productSchema={productSchema}
  localBusiness={localBusiness}
  breadcrumb={breadcrumb}
/>

<Navbar brand={COUNTRY.brand} whatsapp={COUNTRY.whatsapp} />

<main>
  <Hero
    brand={COUNTRY.brand}
    whatsapp={COUNTRY.whatsapp}
    currency={COUNTRY.currency}
    monthlyOffer={COUNTRY.monthlyOffer}
    headlineTop="Paga con Yape y ten tu TV"
    headlineEm="lista en 5 minutos"
    sub="La forma más fácil de activar tu TV por internet. Yapeas o plineas el monto, nos avisas por WhatsApp, y listo — sin tarjetas, sin formularios, sin esperas."
    badge="Acepta Yape y Plin al instante"
    waText="Hola, quiero pagar con Yape y activar Oleada TV"
  />

  <StatsBar />
  <HowItWorks whatsapp={COUNTRY.whatsapp} {...pageSeo.howItWorks} />

  <Plans
    currency={COUNTRY.currency}
    monthlyOriginal={COUNTRY.monthlyOriginal}
    monthlyOffer={COUNTRY.monthlyOffer}
    annualOriginal={COUNTRY.annualOriginal}
    annualOffer={COUNTRY.annualOffer}
    annualSaving={COUNTRY.annualSaving}
    whatsapp={COUNTRY.whatsapp}
    paymentMethods={COUNTRY.paymentMethods}
    {...pageSeo.plans}
  />

  <Testimonials {...pageSeo.testimonials} />
  <Devices {...pageSeo.devices} />
  <FAQ items={faqItems} />

  <CTAFinal
    whatsapp={COUNTRY.whatsapp}
    currency={COUNTRY.currency}
    monthlyOffer={COUNTRY.monthlyOffer}
  />

  <InternalSeoLinks links={internalSeoLinks.pagaConYape} />
</main>

<Footer brand={COUNTRY.brand} whatsapp={COUNTRY.whatsapp} />
<WhatsAppFloat whatsapp={COUNTRY.whatsapp} />
<StickyMobileCTA
  whatsapp={COUNTRY.whatsapp}
  currency={COUNTRY.currency}
  monthlyOffer={COUNTRY.monthlyOffer}
/>
