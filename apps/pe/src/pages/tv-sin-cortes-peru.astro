---
import BaseLayout     from '@shared/layouts/BaseLayout.astro';
import Navbar         from '@shared/components/Navbar.astro';
import Hero           from '@shared/components/Hero.astro';
import StatsBar       from '@shared/components/StatsBar.astro';
import HowItWorks     from '@shared/components/HowItWorks.astro';
import Plans          from '@shared/components/Plans.astro';
import Testimonials   from '@shared/components/Testimonials.astro';
import Devices        from '@shared/components/Devices.astro';
import FAQ            from '@shared/components/FAQ.astro';
import CTAFinal       from '@shared/components/CTAFinal.astro';
import Footer         from '@shared/components/Footer.astro';
import WhatsAppFloat  from '@shared/components/WhatsAppFloat.astro';
import StickyMobileCTA from '@shared/components/StickyMobileCTA.astro';
import InternalSeoLinks from '../components/InternalSeoLinks.astro';
import { internalSeoLinks, seoContent } from '../seoContent';

const COUNTRY = {
  brand:           'Oleada TV',
  whatsapp:        '51940405911',
  currency:        'S/',
  monthlyOriginal: '15',
  monthlyOffer:    '11.99',
  annualOriginal:  '130',
  annualOffer:     '119.99',
  annualSaving:    '23.89',
  paymentMethods:  ['Yape', 'Plin'],
};

const pageSeo = seoContent.tvSinCortesPeru;

const faqItems = [
  {
    q: '¿Por qué mi TV por internet se corta constantemente?',
    a: 'Los cortes suelen venir de servidores inestables o sobrecargados del proveedor que usas. Con Oleada TV monitoreamos nuestros servidores 24/7 y resolvemos cualquier incidencia en minutos antes de que la notes.',
  },
  {
    q: '¿Cuánto internet necesito para que no se corte la señal?',
    a: 'Recomendamos mínimo 10 Mbps para HD y 25 Mbps para 4K. Si tu internet cumple eso y el servicio sigue cortándose, el problema es el proveedor de TV, no tu internet. Oleada TV se adapta automáticamente para minimizar cortes.',
  },
  {
    q: '¿Oleada TV realmente no tiene cortes?',
    a: 'Mantenemos una disponibilidad del 99.9%. Ningún servicio puede garantizar cero incidencias, pero si algo falla nuestro soporte responde en menos de 5 minutos y lo resuelve al momento.',
  },
  {
    q: '¿Puedo cambiar de mi servicio actual a Oleada TV sin complicaciones?',
    a: 'Sí. Solo escríbenos por WhatsApp y en menos de 5 minutos tienes tus nuevas credenciales. No necesitas desinstalar nada antes — te guiamos paso a paso en tu mismo dispositivo.',
  },
  {
    q: '¿Funciona en el mismo TV Box o Fire Stick que ya tengo?',
    a: 'Sí. Oleada TV es compatible con TV Box Android, Amazon Fire Stick, celulares y tablets Android. Usas el dispositivo que ya tienes, sin comprar nada nuevo.',
  },
  {
    q: '¿Qué pasa cuando hay un partido importante y se va la señal?',
    a: 'Nuestro equipo de soporte está activo todo el día, todos los días — especialmente en fechas de eventos importantes. Si hay algún problema, escríbenos por WhatsApp y lo resolvemos antes de que terminen los primeros minutos.',
  },
  {
    q: '¿Cuánto cuesta cambiarse a Oleada TV?',
    a: `Desde S/ ${COUNTRY.monthlyOffer} al mes. Sin permanencia ni contratos — si decides que no es lo que buscas, simplemente no renuevas. Sin penalidades.`,
  },
  {
    q: '¿Puedo pagar con Yape o Plin?',
    a: 'Sí. Yape o Plin al número que te damos, nos mandas la captura por WhatsApp y en menos de 5 minutos tienes tu acceso activado.',
  },
  {
    q: '¿Cómo sé que Oleada TV es más estable que lo que uso ahora?',
    a: 'Más de 5,000 usuarios activos en todo el Perú son nuestra mejor prueba. Muchos llegaron exactamente por lo mismo que tú buscas: estabilidad y soporte real cuando algo falla.',
  },
  {
    q: '¿Funciona bien en provincia o solo en Lima?',
    a: 'En todo el Perú. Lima, Arequipa, Trujillo, Cusco, Piura, Iquitos — donde tengas internet de al menos 10 Mbps, Oleada TV funciona.',
  },
];

const productSchema = {
  name: 'Oleada TV — TV por Internet Estable sin Cortes en Perú',
  description: 'Servicio de TV por internet estable y sin cortes para Perú. Soporte 24/7 por WhatsApp. Actívate en 5 minutos pagando con Yape o Plin. Desde S/ 11.99 al mes.',
  price: COUNTRY.monthlyOffer,
  priceCurrency: 'PEN',
};

const localBusiness = {
  siteName: 'Oleada TV',
  telephone: '+51940405911',
  priceRange: `S/ ${COUNTRY.monthlyOffer} - S/ ${COUNTRY.annualOffer}`,
  currenciesAccepted: 'PEN',
  paymentAccepted: 'Yape, Plin',
  areaServed: ['Perú', 'Lima', 'Arequipa', 'Trujillo', 'Cusco', 'Piura', 'Iquitos', 'Huancayo'],
};

const breadcrumb = [
  { name: 'Inicio', url: 'https://oleadatvplus.com/' },
  { name: 'TV por Internet sin Cortes', url: 'https://oleadatvplus.com/tv-sin-cortes-peru/' },
];
---
<BaseLayout
  title="TV por Internet sin Cortes en Perú — Oleada TV | Señal Estable 24/7"
  description="¿Tu TV por internet se corta todo el tiempo? Oleada TV ofrece señal estable 24/7, soporte por WhatsApp en minutos y activación en 5 minutos pagando con Yape. Desde S/ 11.99."
  keywords="tv por internet sin cortes peru, tv online estable peru, servicio tv internet que no falla, tv por internet confiable peru, por que se corta mi tv por internet, tv por internet problemas peru, mejor servicio tv online peru, tv sin interrupciones peru, cambiar servicio tv por internet, tv online que funciona bien peru"
  canonical="https://oleadatvplus.com/tv-sin-cortes-peru/"
  lang="es-PE"
  locale="es_PE"
  geoRegion="PE"
  geoPlacename="Lima, Perú"
  geoPosition="-12.0464;-77.0428"
  faqSchema={faqItems}
  productSchema={productSchema}
  localBusiness={localBusiness}
  breadcrumb={breadcrumb}
/>

<Navbar brand={COUNTRY.brand} whatsapp={COUNTRY.whatsapp} />

<main>
  <Hero
    brand={COUNTRY.brand}
    whatsapp={COUNTRY.whatsapp}
    currency={COUNTRY.currency}
    monthlyOffer={COUNTRY.monthlyOffer}
    headlineTop="¿Tu TV por internet se corta"
    headlineEm="todo el tiempo? Prueba Oleada TV"
    sub="Señal estable 24/7, soporte por WhatsApp en minutos. Más de 5,000 usuarios en Perú ya cambiaron y no volvieron atrás."
    badge="99.9% de disponibilidad garantizada"
    waText="Hola, quiero un servicio de TV por internet sin cortes con Oleada TV"
  />

  <StatsBar />
  <HowItWorks whatsapp={COUNTRY.whatsapp} {...pageSeo.howItWorks} />

  <Plans
    currency={COUNTRY.currency}
    monthlyOriginal={COUNTRY.monthlyOriginal}
    monthlyOffer={COUNTRY.monthlyOffer}
    annualOriginal={COUNTRY.annualOriginal}
    annualOffer={COUNTRY.annualOffer}
    annualSaving={COUNTRY.annualSaving}
    whatsapp={COUNTRY.whatsapp}
    paymentMethods={COUNTRY.paymentMethods}
    {...pageSeo.plans}
  />

  <Testimonials {...pageSeo.testimonials} />
  <Devices {...pageSeo.devices} />
  <FAQ items={faqItems} />

  <CTAFinal
    whatsapp={COUNTRY.whatsapp}
    currency={COUNTRY.currency}
    monthlyOffer={COUNTRY.monthlyOffer}
  />

  <InternalSeoLinks links={internalSeoLinks.tvSinCortesPeru} />
</main>

<Footer brand={COUNTRY.brand} whatsapp={COUNTRY.whatsapp} />
<WhatsAppFloat whatsapp={COUNTRY.whatsapp} />
<StickyMobileCTA
  whatsapp={COUNTRY.whatsapp}
  currency={COUNTRY.currency}
  monthlyOffer={COUNTRY.monthlyOffer}
/>
