---
import BaseLayout     from '@shared/layouts/BaseLayout.astro';
import Navbar         from '@shared/components/Navbar.astro';
import Hero           from '@shared/components/Hero.astro';
import StatsBar       from '@shared/components/StatsBar.astro';
import HowItWorks     from '@shared/components/HowItWorks.astro';
import Plans          from '@shared/components/Plans.astro';
import BeforePaying from '@shared/components/BeforePaying.astro';
import Devices        from '@shared/components/Devices.astro';
import Downloads      from '@shared/components/Downloads.astro';
import FAQ            from '@shared/components/FAQ.astro';
import CTAFinal       from '@shared/components/CTAFinal.astro';
import Footer         from '@shared/components/Footer.astro';
import WhatsAppFloat  from '@shared/components/WhatsAppFloat.astro';
import StickyMobileCTA from '@shared/components/StickyMobileCTA.astro';
import SellerNotice from '@shared/components/SellerNotice.astro';
import { waTag } from '@shared/lib/wa';
import { PE_FOOTER_PAGES, PE_SITE_LINKS, PE_SUBPAGE_NAV, PE_INSTALL_PATH } from '../site';
import InternalSeoLinks from '../components/InternalSeoLinks.astro';
import { internalSeoLinks, seoContent } from '../seoContent';
import { STELLA } from '../stella.config';

const pageSeo = seoContent.tvSinCortesPeru;
const monthly = STELLA.plans[0];
const TAG = waTag('PE', 'TV-SIN-CORTES');
const priceFrom = `${STELLA.currency}${monthly.price}`;

const faqItems = [
  {
    q: '¿Por qué mi TV por internet se corta constantemente?',
    a: 'Los cortes suelen venir del WiFi de la casa, del equipo o de servidores saturados del proveedor. Si notas cortes con Stella TV, escríbenos por WhatsApp y revisamos contigo la conexión, el dispositivo y el servicio.',
  },
  {
    q: '¿Cuánto internet necesito para que no se corte la señal?',
    a: 'Recomendamos mínimo 10 Mbps para HD y 25 Mbps para 4K. Si tu internet cumple eso y el servicio sigue cortándose, el problema es el proveedor de TV, no tu internet.',
  },
  {
    q: '¿Stella TV realmente no tiene cortes?',
    a: 'Ningún servicio por internet puede garantizar cero cortes: la estabilidad también depende de tu conexión y de tu equipo. Lo que sí hacemos es revisar contigo el WiFi y el dispositivo antes de activar, y atenderte por WhatsApp si algo falla.',
  },
  {
    q: '¿Puedo cambiar de mi servicio actual a Stella TV sin complicaciones?',
    a: 'Sí. Solo escríbenos por WhatsApp y en minutos tienes tus nuevas credenciales. No necesitas desinstalar nada antes — te guiamos paso a paso en tu mismo dispositivo.',
  },
  {
    q: '¿Funciona en el mismo TV Box o Fire Stick que ya tengo?',
    a: 'Sí. Stella TV es compatible con TV Box, Fire Stick, Google TV, Android TV, celulares y tablets Android. Usas el dispositivo que ya tienes, sin comprar nada nuevo.',
  },
  {
    q: '¿Qué pasa cuando hay un partido importante y se va la señal?',
    a: 'Escríbenos por WhatsApp y revisamos contigo la conexión, el equipo y el servicio. Si tienes un evento importante, te recomendamos probar la señal con anticipación.',
  },
  {
    q: '¿Cuánto cuesta cambiarse a Stella TV?',
    a: `Desde ${priceFrom} al mes. Sin permanencia ni contratos — si decides que no es lo que buscas, simplemente no renuevas. Sin penalidades.`,
  },
  {
    q: '¿Puedo pagar con Yape o Plin?',
    a: 'Sí. Yape o Plin al número que te damos, nos mandas la captura por WhatsApp y en minutos tienes tu acceso activado.',
  },
  {
    q: '¿Cómo sé que Stella TV es más estable que lo que uso ahora?',
    a: 'La mejor forma es revisarlo antes de pagar: por WhatsApp verificamos contigo tu velocidad de internet y tu equipo, para saber si tu conexión alcanza para HD (recomendamos 10 Mbps) o 4K (25 Mbps).',
  },
  {
    q: '¿Funciona bien en provincia o solo en Lima?',
    a: 'En todo el Perú. Lima, Arequipa, Trujillo, Cusco, Piura, Iquitos — donde tengas internet de al menos 10 Mbps, Stella TV funciona.',
  },
];

const productSchema = {
  name: `${STELLA.brand} — TV por internet en Perú`,
  description: `TV por internet para Perú con soporte por WhatsApp para revisar conexión y equipo. Pago con Yape o Plin. Desde ${priceFrom} al mes.`,
  price: monthly.price,
  priceCurrency: 'USD',
};


const breadcrumb = [
  { name: 'Inicio', url: 'https://oleadatvplus.com/' },
  { name: 'TV por Internet sin Cortes', url: 'https://oleadatvplus.com/tv-sin-cortes-peru/' },
];
---
<BaseLayout
  title={`TV por Internet sin Cortes en Perú — ${STELLA.brand} | Cómo Evitar Cortes`}
  description={`¿Tu TV por internet se corta todo el tiempo? Velocidad recomendada, consejos de WiFi y soporte por WhatsApp con ${STELLA.brand}. Paga con Yape o Plin desde ${priceFrom}.`}
  keywords="tv por internet sin cortes peru, tv online estable peru, servicio tv internet que no falla, tv por internet confiable peru, por que se corta mi tv por internet, tv por internet problemas peru, mejor servicio tv online peru, tv sin interrupciones peru, cambiar servicio tv por internet, stella tv peru"
  canonical="https://oleadatvplus.com/tv-sin-cortes-peru/"
  country="PE"
  whatsapp={STELLA.whatsapp}
  lang="es-PE"
  locale="es_PE"
  geoRegion="PE"
  geoPlacename="Lima, Perú"
  geoPosition="-12.0464;-77.0428"
  faqSchema={faqItems}
  productSchema={productSchema}
  organization={{ telephone: `+${STELLA.whatsapp}`, areaServed: STELLA.areaServed }}
  breadcrumb={breadcrumb}
/>

<SellerNotice country="Perú" />
<Navbar whatsapp={STELLA.whatsapp} waTag={TAG} links={PE_SUBPAGE_NAV} />

<main>
  <Hero
    brand={STELLA.brand}
    whatsapp={STELLA.whatsapp}
    waTag={TAG}
    currency={STELLA.currency}
    monthlyOffer={monthly.price}
    headlineTop="¿Tu TV por internet se corta"
    headlineEm={`todo el tiempo? Prueba ${STELLA.brand}`}
    sub="Antes de activar revisamos contigo tu WiFi y tu equipo, y si notas cortes te ayudamos por WhatsApp."
    badge="Soporte por WhatsApp si algo falla"
    waText={`Hola, quiero un servicio de TV por internet sin cortes con ${STELLA.brand}`}
  />

  <StatsBar />
  <HowItWorks whatsapp={STELLA.whatsapp} {...pageSeo.howItWorks} />

  <Plans
    currency={STELLA.currency}
    plans={STELLA.plans}
    whatsapp={STELLA.whatsapp}
    waTag={TAG}
    brand={STELLA.brand}
    features={STELLA.planFeatures}
    paymentMethods={STELLA.paymentMethods}
    paymentNote={STELLA.paymentNote}
  />

  <BeforePaying whatsapp={STELLA.whatsapp} waTag={TAG} paymentText={STELLA.beforePayingText} />
  <Devices />
  <Downloads whatsapp={STELLA.whatsapp} waTag={TAG} guideHref={PE_INSTALL_PATH} />
  <FAQ items={faqItems} />

  <CTAFinal
    whatsapp={STELLA.whatsapp}
    waTag={TAG}
    currency={STELLA.currency}
    monthlyOffer={monthly.price}
    brand={STELLA.brand}
  />

  <InternalSeoLinks links={internalSeoLinks.tvSinCortesPeru} />
</main>

<Footer whatsapp={STELLA.whatsapp} waTag={TAG} country="Perú" pageLinks={PE_FOOTER_PAGES} siteLinks={PE_SITE_LINKS} />
<WhatsAppFloat whatsapp={STELLA.whatsapp} waTag={TAG} brand={STELLA.brand} />
<StickyMobileCTA
  whatsapp={STELLA.whatsapp}
  waTag={TAG}
  currency={STELLA.currency}
  monthlyOffer={monthly.price}
  brand={STELLA.brand}
/>
