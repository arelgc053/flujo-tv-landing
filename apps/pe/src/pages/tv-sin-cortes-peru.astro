---
import BaseLayout     from '@shared/layouts/BaseLayout.astro';
import Navbar         from '@shared/components/Navbar.astro';
import Hero           from '@shared/components/Hero.astro';
import StatsBar       from '@shared/components/StatsBar.astro';
import HowItWorks     from '@shared/components/HowItWorks.astro';
import Plans          from '@shared/components/Plans.astro';
import Testimonials   from '@shared/components/Testimonials.astro';
import Devices        from '@shared/components/Devices.astro';
import Installation   from '@shared/components/Installation.astro';
import FAQ            from '@shared/components/FAQ.astro';
import CTAFinal       from '@shared/components/CTAFinal.astro';
import Footer         from '@shared/components/Footer.astro';
import WhatsAppFloat  from '@shared/components/WhatsAppFloat.astro';
import StickyMobileCTA from '@shared/components/StickyMobileCTA.astro';
import BrandTransitionStrip from '../components/BrandTransitionStrip.astro';
import InternalSeoLinks from '../components/InternalSeoLinks.astro';
import { internalSeoLinks, seoContent, stellaTestimonials } from '../seoContent';
import { STELLA } from '../stella.config';

const pageSeo = seoContent.tvSinCortesPeru;
const monthly = STELLA.plans[0];
const longest = STELLA.plans[STELLA.plans.length - 1];

const faqItems = [
  {
    q: '¿Por qué mi TV por internet se corta constantemente?',
    a: 'Los cortes suelen venir de servidores inestables o sobrecargados del proveedor que usas. Con Stella TV monitoreamos nuestros servidores 24/7 y resolvemos cualquier incidencia en minutos antes de que la notes.',
  },
  {
    q: '¿Cuánto internet necesito para que no se corte la señal?',
    a: 'Recomendamos mínimo 10 Mbps para HD y 25 Mbps para 4K. Si tu internet cumple eso y el servicio sigue cortándose, el problema es el proveedor de TV, no tu internet.',
  },
  {
    q: '¿Stella TV realmente no tiene cortes?',
    a: 'Mantenemos una disponibilidad del 99.9%. Ningún servicio puede garantizar cero incidencias, pero si algo falla nuestro soporte responde en minutos y lo resuelve al momento.',
  },
  {
    q: '¿Puedo cambiar de mi servicio actual a Stella TV sin complicaciones?',
    a: 'Sí. Solo escríbenos por WhatsApp y en minutos tienes tus nuevas credenciales. No necesitas desinstalar nada antes — te guiamos paso a paso en tu mismo dispositivo.',
  },
  {
    q: '¿Funciona en el mismo TV Box o Fire Stick que ya tengo?',
    a: 'Sí. Stella TV es compatible con TV Box, Fire Stick, Google TV, Android TV, celulares y tablets Android. Usas el dispositivo que ya tienes, sin comprar nada nuevo.',
  },
  {
    q: '¿Qué pasa cuando hay un partido importante y se va la señal?',
    a: 'Nuestro equipo de soporte está activo todo el día, todos los días — especialmente en fechas de eventos importantes. Si hay algún problema, escríbenos por WhatsApp y lo resolvemos antes de que terminen los primeros minutos.',
  },
  {
    q: '¿Cuánto cuesta cambiarse a Stella TV?',
    a: `Desde S/ ${monthly.price} al mes. Sin permanencia ni contratos — si decides que no es lo que buscas, simplemente no renuevas. Sin penalidades.`,
  },
  {
    q: '¿Puedo pagar con Yape o Plin?',
    a: 'Sí. Yape o Plin al número que te damos, nos mandas la captura por WhatsApp y en minutos tienes tu acceso activado.',
  },
  {
    q: '¿Cómo sé que Stella TV es más estable que lo que uso ahora?',
    a: 'Más de 5,000 clientes activos son nuestra mejor prueba. Muchos llegaron exactamente por lo mismo que tú buscas: estabilidad y soporte real cuando algo falla.',
  },
  {
    q: '¿Funciona bien en provincia o solo en Lima?',
    a: 'En todo el Perú. Lima, Arequipa, Trujillo, Cusco, Piura, Iquitos — donde tengas internet de al menos 10 Mbps, Stella TV funciona.',
  },
];

const productSchema = {
  name: `${STELLA.brand} — TV por Internet Estable sin Cortes en Perú`,
  description: `Servicio de TV por internet estable y sin cortes para Perú. Soporte 24/7 por WhatsApp. Actívate en minutos pagando con Yape o Plin. Desde S/ ${monthly.price} al mes.`,
  price: monthly.price,
  priceCurrency: 'PEN',
};

const localBusiness = {
  siteName: STELLA.brand,
  telephone: `+${STELLA.whatsapp}`,
  priceRange: `S/ ${monthly.price} - S/ ${longest.price}`,
  currenciesAccepted: 'PEN',
  paymentAccepted: 'Yape, Plin',
  areaServed: ['Perú', 'Lima', 'Arequipa', 'Trujillo', 'Cusco', 'Piura', 'Iquitos', 'Huancayo'],
};

const breadcrumb = [
  { name: 'Inicio', url: 'https://oleadatvplus.com/' },
  { name: 'TV por Internet sin Cortes', url: 'https://oleadatvplus.com/tv-sin-cortes-peru/' },
];
---
<BaseLayout
  title={`TV por Internet sin Cortes en Perú — ${STELLA.brand} | Señal Estable 24/7`}
  description={`¿Tu TV por internet se corta todo el tiempo? ${STELLA.brand} ofrece señal estable 24/7, soporte por WhatsApp y activación en minutos pagando con Yape. Desde S/ ${monthly.price}.`}
  keywords="tv por internet sin cortes peru, tv online estable peru, servicio tv internet que no falla, tv por internet confiable peru, por que se corta mi tv por internet, tv por internet problemas peru, mejor servicio tv online peru, tv sin interrupciones peru, cambiar servicio tv por internet, stella tv peru"
  canonical="https://oleadatvplus.com/tv-sin-cortes-peru/"
  brand={STELLA.brand}
  whatsapp={STELLA.whatsapp}
  lang="es-PE"
  locale="es_PE"
  geoRegion="PE"
  geoPlacename="Lima, Perú"
  geoPosition="-12.0464;-77.0428"
  faqSchema={faqItems}
  productSchema={productSchema}
  aggregateRating={{ ratingValue: STELLA.rating.value, reviewCount: STELLA.rating.count }}
  localBusiness={localBusiness}
  breadcrumb={breadcrumb}
/>

<BrandTransitionStrip previousBrand={STELLA.previousBrand} brand={STELLA.brand} />
<Navbar brand={STELLA.brand} whatsapp={STELLA.whatsapp} />

<main>
  <Hero
    brand={STELLA.brand}
    whatsapp={STELLA.whatsapp}
    currency={STELLA.currency}
    monthlyOffer={monthly.price}
    headlineTop="¿Tu TV por internet se corta"
    headlineEm={`todo el tiempo? Prueba ${STELLA.brand}`}
    sub="Señal estable 24/7, soporte por WhatsApp en minutos. Miles de usuarios en Perú ya cambiaron y no volvieron atrás."
    badge="99.9% de disponibilidad"
    waText={`Hola, quiero un servicio de TV por internet sin cortes con ${STELLA.brand}`}
  />

  <StatsBar />
  <HowItWorks whatsapp={STELLA.whatsapp} {...pageSeo.howItWorks} />

  <Plans
    currency={STELLA.currency}
    plans={STELLA.plans}
    whatsapp={STELLA.whatsapp}
    brand={STELLA.brand}
    features={STELLA.planFeatures}
    paymentMethods={STELLA.paymentMethods}
  />

  <Testimonials testimonials={stellaTestimonials} />
  <Devices />
  <Installation whatsapp={STELLA.whatsapp} brand={STELLA.brand} downloaderCode={STELLA.downloaderCode} />
  <FAQ items={faqItems} />

  <CTAFinal
    whatsapp={STELLA.whatsapp}
    currency={STELLA.currency}
    monthlyOffer={monthly.price}
    brand={STELLA.brand}
  />

  <InternalSeoLinks links={internalSeoLinks.tvSinCortesPeru} />
</main>

<Footer brand={STELLA.brand} whatsapp={STELLA.whatsapp} />
<WhatsAppFloat whatsapp={STELLA.whatsapp} brand={STELLA.brand} />
<StickyMobileCTA
  whatsapp={STELLA.whatsapp}
  currency={STELLA.currency}
  monthlyOffer={monthly.price}
  brand={STELLA.brand}
/>
