---
// Intención: precio / planes de Stella TV en Argentina (consultas observadas:
// "stella tv precio argentina", "stella tv precio"). Página comercial: la
// meta es la conversación de WhatsApp, no el tiempo en página.
import '../styles/tokens.css';
import BaseLayout      from '@shared/layouts/BaseLayout.astro';
import Navbar          from '@shared/components/Navbar.astro';
import SellerNotice    from '@shared/components/SellerNotice.astro';
import PageIntro       from '@shared/components/PageIntro.astro';
import Plans           from '@shared/components/Plans.astro';
import FAQ             from '@shared/components/FAQ.astro';
import RelatedGuides   from '@shared/components/RelatedGuides.astro';
import CTAFinal        from '@shared/components/CTAFinal.astro';
import Footer          from '@shared/components/Footer.astro';
import WhatsAppFloat   from '@shared/components/WhatsAppFloat.astro';
import StickyMobileCTA from '@shared/components/StickyMobileCTA.astro';
import { STELLA_AR } from '../stella.config';
import { AR_FOOTER_PAGES, AR_SITE_LINKS } from '../site';
import { USD_PLANS, effectiveMonthly, totalMonths } from '@shared/data/stella';
import { waTag } from '@shared/lib/wa';

const TAG = waTag('AR', 'PRECIOS');
const CANONICAL = 'https://ar.oleadatvplus.com/precio-stella-tv';
const C = STELLA_AR.currency;
const [p1, p3, p6, p12] = USD_PLANS;
const fmt = (n: string) => n.replace('.', ',');

const rows = USD_PLANS.map((p, i) => ({
  label: STELLA_AR.plans[i].label,
  price: `${C}${p.price}`,
  months: p.bonusMonths ? `${totalMonths(p)} (${p.months} + ${p.bonusMonths} gratis)` : String(p.months),
  perMonth: `${C}${fmt(effectiveMonthly(p))}`,
}));

const faqItems = [
  {
    q: '¿Cuánto cuesta Stella TV por mes en Argentina?',
    a: `El plan mensual sale ${C}${p1.price}. Con los planes largos el mes sale menos: el de 6 meses (${C}${p6.price}, con 1 mes gratis) equivale a ${C}${fmt(effectiveMonthly(p6))} por mes y el de 12 meses (${C}${p12.price}, con 2 meses gratis) a ${C}${fmt(effectiveMonthly(p12))}.`,
  },
  {
    q: '¿Por qué el precio está en dólares si pago en pesos?',
    a: 'Publicamos el precio en dólares, igual en todos los países donde Oleada TV vende Stella TV. Pagás con medios locales y, antes de pagar, te confirmamos por WhatsApp el importe final en pesos.',
  },
  {
    q: '¿Qué medios de pago aceptan en Argentina?',
    a: 'Mercado Pago (con dinero en cuenta, QR o tarjeta) o transferencia bancaria CVU/CBU desde cualquier banco o billetera virtual. Te pasamos los datos por WhatsApp junto con el importe en pesos.',
  },
  {
    q: '¿Todos los planes incluyen lo mismo?',
    a: `Sí: ${STELLA_AR.planFeatures.join(', ').toLowerCase()}. Solo cambia la duración y, por los meses gratis, cuánto sale cada mes.`,
  },
  {
    q: '¿Cómo funcionan los meses gratis?',
    a: `El plan de 6 meses suma 1 mes sin cargo (${totalMonths(p6)} meses en total) y el de 12 meses suma 2 (${totalMonths(p12)} meses en total).`,
  },
  {
    q: '¿Hay débito automático o permanencia?',
    a: 'No. Pagás el plan que elegís y renovás solo cuando querés, escribiéndonos por WhatsApp.',
  },
];

const steps = [
  { title: 'Elegís el plan', desc: 'Tocás el botón del plan y se abre WhatsApp con el mensaje listo.' },
  { title: 'Te confirmamos el importe', desc: 'Te decimos el importe final en pesos y te pasamos los datos de Mercado Pago o de transferencia.' },
  { title: 'Pagás y nos mandás el comprobante', desc: 'Lo validamos por el mismo chat.' },
  { title: 'Recibís el acceso', desc: 'Te mandamos tus datos y te ayudamos a instalar Stella TV en tu equipo.' },
];

const guides = [
  { href: '/instalar-stella-tv', title: 'Cómo instalar Stella TV', desc: 'Código Downloader vigente, APK y paso a paso por dispositivo.' },
  { href: '/', title: 'Stella TV en Argentina', desc: 'Contenido, dispositivos compatibles y preguntas frecuentes.' },
];
---
<BaseLayout
  title={`Precio de Stella TV en Argentina: planes desde ${C}${p1.price} y pago en pesos`}
  description={`Cuánto cuesta Stella TV en Argentina: 1 mes ${C}${p1.price}, 3 meses ${C}${p3.price}, 6 meses ${C}${p6.price} (+1 gratis) y 12 meses ${C}${p12.price} (+2 gratis). Pagás con Mercado Pago o transferencia.`}
  preloadHero={false}
  canonical={CANONICAL}
  country="AR"
  whatsapp={STELLA_AR.whatsapp}
  lang="es-AR"
  locale="es_AR"
  geoRegion="AR"
  geoPlacename="Argentina"
  faqSchema={faqItems}
  productSchema={{
    name: 'Stella TV — plan mensual (Argentina)',
    description: `Plan mensual de Stella TV para Argentina, ${C}${p1.price} por mes. Pago con Mercado Pago o transferencia. Vendido por Oleada TV.`,
    price: String(p1.price),
    priceCurrency: 'USD',
  }}
  breadcrumb={[
    { name: 'Inicio', url: 'https://ar.oleadatvplus.com/' },
    { name: 'Precio de Stella TV', url: CANONICAL },
  ]}
/>

<SellerNotice country="Argentina" voseo />
<Navbar
  whatsapp={STELLA_AR.whatsapp}
  waTag={TAG}
  links={[
    { href: '#tabla', label: 'Tabla' },
    { href: '#planes', label: 'Planes' },
    { href: '#pago', label: 'Cómo pagar' },
    { href: '/instalar-stella-tv', label: 'Instalar' },
    { href: '/', label: 'Inicio' },
  ]}
/>

<main>
  <PageIntro
    eyebrow="Precios actualizados"
    title="Precio de Stella TV"
    titleEm="en Argentina"
    intro="Cuatro planes con el mismo contenido: cambia la duración y cuánto sale cada mes. Los precios están en dólares y pagás con medios locales; el importe en pesos te lo confirmamos antes de pagar."
    facts={[
      { label: '1 mes', value: `${C}${p1.price}` },
      { label: '3 meses', value: `${C}${p3.price}` },
      { label: '6 meses (+1)', value: `${C}${p6.price}` },
      { label: '12 meses (+2)', value: `${C}${p12.price}` },
    ]}
    whatsapp={STELLA_AR.whatsapp}
    waTag={TAG}
    waText="Hola, quiero saber el importe en pesos de Stella TV."
    ctaLabel="Consultar importe en pesos"
    secondaryHref="#planes"
    secondaryLabel="Ver los planes"
  />

  <section class="pt" id="tabla" aria-labelledby="pt-title">
    <div class="inner pt-inner">
      <h2 id="pt-title" class="section-title reveal">Cuánto sale <em>cada mes</em></h2>
      <div class="pt-wrap reveal">
        <table class="pt-table">
          <caption>Planes de Stella TV en Argentina (precios en dólares estadounidenses)</caption>
          <thead>
            <tr><th scope="col">Plan</th><th scope="col">Precio</th><th scope="col">Meses de servicio</th><th scope="col">Equivale por mes</th></tr>
          </thead>
          <tbody>
            {rows.map(r => (
              <tr><th scope="row">{r.label}</th><td>{r.price}</td><td>{r.months}</td><td>{r.perMonth}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="pt-note reveal">"Equivale por mes" divide el precio por los meses de servicio, contando los meses gratis.</p>
    </div>
  </section>

  <Plans
    currency={C}
    plans={STELLA_AR.plans}
    whatsapp={STELLA_AR.whatsapp}
    waTag={TAG}
    brand={STELLA_AR.brand}
    features={STELLA_AR.planFeatures}
    paymentMethods={STELLA_AR.paymentMethods}
    title="Elegí tu <em>plan</em>"
    subtitle="Mismo contenido en los 4 · Sin permanencia"
    paymentNote={STELLA_AR.paymentNote}
  />

  <section class="pp" id="pago" aria-labelledby="pp-title">
    <div class="inner pp-inner">
      <h2 id="pp-title" class="section-title reveal">Cómo pagás <em>desde Argentina</em></h2>
      <ol class="pp-steps">
        {steps.map((s, i) => (
          <li class="reveal">
            <span class="pp-num" aria-hidden="true">{i + 1}</span>
            <div><strong>{s.title}</strong><p>{s.desc}</p></div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <FAQ items={faqItems} />

  <RelatedGuides guides={guides} title="Seguí <em>leyendo</em>" />

  <CTAFinal
    whatsapp={STELLA_AR.whatsapp}
    waTag={TAG}
    currency={C}
    monthlyOffer={String(p1.price)}
    title="¿Querés saber el importe en pesos?"
    waText="Hola, quiero saber el importe en pesos de Stella TV."
    sub="Te lo confirmamos por WhatsApp antes de que pagues"
  />
</main>

<Footer
  whatsapp={STELLA_AR.whatsapp}
  waTag={TAG}
  country="Argentina"
  sectionLinks={[
    { href: '#tabla', label: 'Tabla de precios' },
    { href: '#planes', label: 'Planes' },
    { href: '#pago', label: 'Cómo pagar' },
    { href: '#faq', label: 'Preguntas frecuentes' },
  ]}
  pageLinks={[{ href: '/', label: 'Inicio' }, ...AR_FOOTER_PAGES.filter(l => l.href !== '/precio-stella-tv')]}
  siteLinks={AR_SITE_LINKS}
/>

<WhatsAppFloat whatsapp={STELLA_AR.whatsapp} waTag={TAG} />

<StickyMobileCTA
  whatsapp={STELLA_AR.whatsapp}
  waTag={TAG}
  currency={C}
  monthlyOffer={String(p1.price)}
  waText="Hola, quiero contratar Stella TV en Argentina."
/>

<style>
  .pt, .pp { padding: clamp(56px, 8vw, 96px) 20px; text-align: center; }
  .pp { background: var(--bg2); }
  .pt-inner, .pp-inner { max-width: 820px; }
  .pt-wrap { overflow-x: auto; -webkit-overflow-scrolling: touch; border-radius: var(--radius-lg, 18px); border: 1px solid var(--glass-border, rgba(255,255,255,0.08)); }
  .pt-table { width: 100%; border-collapse: collapse; min-width: 480px; text-align: left; }
  .pt-table caption { caption-side: bottom; padding: 10px 14px; font-size: 0.8rem; color: var(--text-muted); text-align: left; }
  .pt-table th, .pt-table td { padding: 14px 16px; border-bottom: 1px solid var(--border); font-size: 0.95rem; }
  .pt-table thead th { font-size: 0.74rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--text-muted); background: rgba(255,255,255,0.03); }
  .pt-table tbody th { color: #fff; font-weight: 700; }
  .pt-table td { color: var(--text-muted); }
  .pt-table td:nth-child(2), .pt-table td:last-child { color: #fff; font-weight: 700; }
  .pt-note { font-size: 0.82rem; color: var(--text-muted); margin-top: 12px; }
  @media (max-width: 560px) {
    .pt-table { min-width: 0; }
    .pt-table th, .pt-table td { padding: 11px 8px; font-size: 0.84rem; }
    .pt-table thead th { font-size: 0.64rem; letter-spacing: 0.04em; }
  }
  .pp-steps { list-style: none; margin: 0 auto; padding: 0; display: grid; gap: 14px; text-align: left; }
  .pp-steps li { display: flex; gap: 14px; align-items: flex-start; border: 1px solid var(--glass-border, rgba(255,255,255,0.08)); border-radius: var(--radius-lg, 18px); padding: 16px 18px; background: var(--glass-bg, rgba(255,255,255,0.03)); }
  .pp-num { flex-shrink: 0; width: 30px; height: 30px; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: var(--orange-soft); border: 1px solid var(--orange-border); color: var(--orange); font-weight: 800; }
  .pp-steps strong { color: #fff; }
  .pp-steps p { margin: 4px 0 0; color: var(--text-muted); line-height: 1.6; font-size: 0.92rem; }
</style>
