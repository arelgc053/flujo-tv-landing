---
import '../styles/tokens.css';
import BaseLayout        from '@shared/layouts/BaseLayout.astro';
import Navbar             from '@shared/components/Navbar.astro';
import Hero                from '@shared/components/Hero.astro';
import StatsBar              from '@shared/components/StatsBar.astro';
import HowItWorks              from '@shared/components/HowItWorks.astro';
import Plans                     from '@shared/components/Plans.astro';
import Comparison                 from '@shared/components/Comparison.astro';
import Devices                      from '@shared/components/Devices.astro';
import Downloads                     from '@shared/components/Downloads.astro';
import FAQ                            from '@shared/components/FAQ.astro';
import CTAFinal                        from '@shared/components/CTAFinal.astro';
import Footer                           from '@shared/components/Footer.astro';
import WhatsAppFloat                     from '@shared/components/WhatsAppFloat.astro';
import StickyMobileCTA                    from '@shared/components/StickyMobileCTA.astro';
import SellerNotice                        from '@shared/components/SellerNotice.astro';
import RelatedGuides                        from '@shared/components/RelatedGuides.astro';
import BeforePaying        from '@shared/components/BeforePaying.astro';
import ContentCategories   from '../components/ContentCategories.astro';
import { STELLA_AR } from '../stella.config';
import { AR_DEVICES, AR_DEVICES_NOTE, AR_FOOTER_PAGES, AR_SITE_LINKS } from '../site';
import { DOWNLOADS } from '@shared/data/stella';
import { homeAlternates } from '@shared/data/sites';
import { waTag } from '@shared/lib/wa';

const TAG = waTag('AR', 'HOME');
const monthly = STELLA_AR.plans[0];
const priceFrom = `${STELLA_AR.currency}${monthly.price}`;
const [p1, p3, p6, p12] = STELLA_AR.plans;

const PAYMENT_ICONS: Record<string, string> = {
  'Mercado Pago': `<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12V7H5a2 2 0 0 1 0-4h14v4"/><path d="M3 5v14a2 2 0 0 0 2 2h16v-5"/><path d="M18 12a2 2 0 0 0 0 4h4v-4Z"/></svg>`,
  'Transferencia (CVU/CBU)': `<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="3" y1="21" x2="21" y2="21"/><line x1="5" y1="21" x2="5" y2="10"/><line x1="9" y1="21" x2="9" y2="10"/><line x1="15" y1="21" x2="15" y2="10"/><line x1="19" y1="21" x2="19" y2="10"/><polygon points="12 2 21 8 3 8"/></svg>`,
};
const paymentMethodsWithIcons = STELLA_AR.paymentMethods.map(label => ({ label, icon: PAYMENT_ICONS[label] }));

const comparisonRows = [
  { label: 'Precio mensual',   service: `Desde ${priceFrom}`, cable: 'Según operador y paquete' },
  { label: 'Medios de pago',   service: 'Mercado Pago o transferencia', cable: 'Factura mensual' },
  { label: 'Contrato mínimo',  service: 'Sin permanencia', cable: 'Suele exigir permanencia' },
  { label: 'Instalación',      service: 'Por WhatsApp, sin técnico', cable: 'Visita técnica' },
  { label: 'Dispositivos',     service: 'TV, celular y tablet Android', cable: 'Decodificador en la TV' },
  { label: 'Activación',       service: 'El mismo día', cable: 'Según agenda del técnico' },
  { label: 'Soporte',          service: 'Por WhatsApp', cable: 'Call center' },
];

const howItWorksSteps = [
  { step: '01', title: 'Elegí tu plan', desc: 'Escribinos por WhatsApp, contanos qué dispositivo usás y te recomendamos el plan y la forma de instalarlo.' },
  { step: '02', title: 'Pagá con medios locales', desc: 'Te confirmamos el importe final en pesos y pagás con Mercado Pago o transferencia (CVU/CBU).' },
  { step: '03', title: 'Empezá a ver', desc: 'Te mandamos tus datos de acceso y te acompañamos hasta dejar Stella TV andando en tu tele o celular.' },
];

const faqItems = [
  {
    q: '¿Qué es Stella TV y quién lo vende en este sitio?',
    a: 'Stella TV es un servicio de streaming con más de 1,000 canales en vivo, deportes, cine y series. En este sitio lo comercializa Oleada TV: contratás, pagás y recibís soporte por WhatsApp con nosotros.',
  },
  {
    q: '¿Cuánto cuesta Stella TV en Argentina?',
    a: `1 mes ${STELLA_AR.currency}${p1.price}, 3 meses ${STELLA_AR.currency}${p3.price}, 6 meses ${STELLA_AR.currency}${p6.price} (con 1 mes gratis) y 12 meses ${STELLA_AR.currency}${p12.price} (con 2 meses gratis). Los cuatro planes incluyen exactamente lo mismo; solo cambia la duración.`,
  },
  {
    q: '¿Puedo pagar en pesos?',
    a: 'Sí. Los precios se publican en dólares estadounidenses, pero pagás en pesos con Mercado Pago (dinero en cuenta, QR o tarjeta) o por transferencia CVU/CBU. Antes de pagar te confirmamos por WhatsApp el importe final.',
  },
  {
    q: '¿Cuál es el código Downloader de Stella TV?',
    a: `Para televisores (Android TV, Google TV, Fire TV y TV Box) el código vigente es ${DOWNLOADS.tv.downloaderCode}. El ${DOWNLOADS.legacyCodes.join(' / ')} es un código anterior y ya no corresponde usarlo.`,
  },
  {
    q: '¿Cómo descargo Stella TV en el celular?',
    a: `Con el APK directo para Android (versión ${DOWNLOADS.mobile.version}) de la sección de descargas. No hace falta Downloader; si lo preferís, el código alternativo es ${DOWNLOADS.mobile.downloaderCode}.`,
  },
  {
    q: '¿Funciona en Android TV, Google TV o Fire TV?',
    a: 'Sí. Se instala con la app Downloader y el código de TV en Android TV, Google TV (incluido Chromecast con Google TV), Fire TV Stick, Fire TV Cube y TV Box Android.',
  },
  {
    q: '¿Funciona en Smart TV Samsung o LG?',
    a: 'Los Smart TV Samsung (Tizen) y LG (webOS) no permiten instalar la app de forma nativa. Necesitás conectar un Fire TV, un TV Box o un dispositivo con Google TV por HDMI; te asesoramos por WhatsApp sobre cuál te conviene.',
  },
  {
    q: '¿Funciona en iPhone o iPad?',
    a: 'No. Stella TV es para Android: no hay versión para iPhone ni iPad.',
  },
  {
    q: '¿Cuántas pantallas puedo usar a la vez?',
    a: 'Cada cuenta incluye 3 pantallas simultáneas, en todos los planes.',
  },
  {
    q: '¿Hay contrato o permanencia?',
    a: 'No. Elegís el plan que prefieras, sin permanencia, y renovás solo cuando quieras.',
  },
  {
    q: '¿Cuánto tarda la activación?',
    a: 'Después de confirmar el pago te mandamos tus datos de acceso por WhatsApp. Si es tu primera vez, te acompañamos hasta dejar la app andando.',
  },
];

const productSchema = {
  name: 'Stella TV — plan mensual (Argentina)',
  description: `Plan mensual de Stella TV para Argentina: más de 1,000 canales en vivo, deportes, cine y series. ${priceFrom} por mes; pago con medios locales. Vendido por Oleada TV.`,
  price: monthly.price,
  priceCurrency: 'USD',
};

const guides = [
  { href: '/instalar-stella-tv', title: 'Cómo instalar Stella TV', desc: 'Paso a paso para Android TV, Google TV, Fire TV, TV Box y celular, con los códigos vigentes.' },
  { href: '/precio-stella-tv', title: 'Precios de Stella TV en Argentina', desc: 'Los 4 planes en dólares, cuánto sale por mes cada uno y cómo pagar en pesos.' },
];
---
<BaseLayout
  title={`Stella TV Argentina desde ${priceFrom}/mes: planes, instalación y código`}
  description={`Contratá Stella TV en Argentina con Oleada TV: desde ${priceFrom}/mes, pagás con Mercado Pago o transferencia, APK y código Downloader ${DOWNLOADS.tv.downloaderCode}. Soporte por WhatsApp.`}
  canonical="https://ar.oleadatvplus.com/"
  country="AR"
  whatsapp={STELLA_AR.whatsapp}
  lang="es-AR"
  locale="es_AR"
  geoRegion="AR"
  geoPlacename="Argentina"
  alternates={homeAlternates('ar')}
  faqSchema={faqItems}
  productSchema={productSchema}
  organization={{ telephone: `+${STELLA_AR.whatsapp}`, areaServed: STELLA_AR.areaServed }}
/>

<SellerNotice country="Argentina" voseo />
<Navbar
  whatsapp={STELLA_AR.whatsapp}
  waTag={TAG}
  links={[
    { href: '#planes', label: 'Planes' },
    { href: '#descargas', label: 'Descargas' },
    { href: '/instalar-stella-tv', label: 'Instalar' },
    { href: '/precio-stella-tv', label: 'Precios' },
    { href: '#faq', label: 'Preguntas' },
  ]}
/>

<main>
  <Hero
    brand={STELLA_AR.brand}
    whatsapp={STELLA_AR.whatsapp}
    waTag={TAG}
    currency={STELLA_AR.currency}
    monthlyOffer={monthly.price}
    headlineTop="Stella TV en Argentina"
    headlineEm={`planes desde ${priceFrom} por mes`}
    sub="Más de 1,000 canales, deportes en vivo, cine y series en Full HD. Pagás en pesos con Mercado Pago o transferencia y te ayudamos por WhatsApp a dejarlo andando en tu tele o celular."
    badge="Oleada TV · Stella TV en Argentina"
    waText="Hola, quiero contratar Stella TV en Argentina."
    microcopy="Te confirmamos el importe en pesos antes de que pagues"
    trustBadges={[`Desde ${priceFrom}/mes`, 'Mercado Pago', 'Sin contrato', 'Ayuda por WhatsApp']}
  />

  <StatsBar />

  <HowItWorks subtitle="Tres pasos y arrancás hoy mismo" steps={howItWorksSteps} />

  <ContentCategories />

  <Plans
    currency={STELLA_AR.currency}
    plans={STELLA_AR.plans}
    whatsapp={STELLA_AR.whatsapp}
    waTag={TAG}
    brand={STELLA_AR.brand}
    features={STELLA_AR.planFeatures}
    paymentMethods={paymentMethodsWithIcons}
    title="Elegí tu <em>plan</em>"
    subtitle="Precios en dólares · Sin contratos · Sin permanencia"
    note="Los 4 planes incluyen el mismo contenido — solo cambia la duración."
    paymentNote={STELLA_AR.paymentNote}
  />

  <Comparison
    currency={STELLA_AR.currency}
    monthlyOffer={monthly.price}
    brand={STELLA_AR.brand}
    rows={comparisonRows}
  />

  <BeforePaying whatsapp={STELLA_AR.whatsapp} waTag={TAG} voseo paymentText={STELLA_AR.beforePayingText} />

  <Devices
    subtitle="Para el ecosistema Android — una cuenta, el dispositivo que elijas"
    devices={AR_DEVICES}
    note={AR_DEVICES_NOTE}
  />

  <Downloads whatsapp={STELLA_AR.whatsapp} waTag={TAG} voseo guideHref="/instalar-stella-tv" />

  <FAQ items={faqItems} />

  <RelatedGuides guides={guides} title="Guías para <em>Argentina</em>" />

  <CTAFinal
    whatsapp={STELLA_AR.whatsapp}
    waTag={TAG}
    currency={STELLA_AR.currency}
    monthlyOffer={monthly.price}
    brand={STELLA_AR.brand}
    waText="Hola, quiero contratar Stella TV en Argentina."
    sub="Te respondemos por WhatsApp y te confirmamos el importe en pesos"
  />
</main>

<Footer
  whatsapp={STELLA_AR.whatsapp}
  waTag={TAG}
  country="Argentina"
  pageLinks={AR_FOOTER_PAGES}
  siteLinks={AR_SITE_LINKS}
/>

<WhatsAppFloat whatsapp={STELLA_AR.whatsapp} waTag={TAG} brand={STELLA_AR.brand} />

<StickyMobileCTA
  whatsapp={STELLA_AR.whatsapp}
  waTag={TAG}
  currency={STELLA_AR.currency}
  monthlyOffer={monthly.price}
  brand={STELLA_AR.brand}
  waText="Hola, quiero contratar Stella TV en Argentina."
/>
