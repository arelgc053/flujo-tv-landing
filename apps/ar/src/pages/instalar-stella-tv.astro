---
// Intención: descargar / instalar / código de Stella TV (consultas observadas en
// Search Console: "8821026", "stella tv apk", "descargar stella tv").
import '../styles/tokens.css';
import BaseLayout      from '@shared/layouts/BaseLayout.astro';
import Navbar          from '@shared/components/Navbar.astro';
import SellerNotice    from '@shared/components/SellerNotice.astro';
import PageIntro       from '@shared/components/PageIntro.astro';
import Downloads       from '@shared/components/Downloads.astro';
import InstallGuide    from '@shared/components/InstallGuide.astro';
import FAQ             from '@shared/components/FAQ.astro';
import RelatedGuides   from '@shared/components/RelatedGuides.astro';
import CTAFinal        from '@shared/components/CTAFinal.astro';
import Footer          from '@shared/components/Footer.astro';
import WhatsAppFloat   from '@shared/components/WhatsAppFloat.astro';
import StickyMobileCTA from '@shared/components/StickyMobileCTA.astro';
import { STELLA_AR } from '../stella.config';
import { AR_FOOTER_PAGES, AR_SITE_LINKS } from '../site';
import { DOWNLOADS } from '@shared/data/stella';
import { installAlternates } from '@shared/data/sites';
import { waTag } from '@shared/lib/wa';

const TAG = waTag('AR', 'INSTALAR');
const CANONICAL = 'https://ar.oleadatvplus.com/instalar-stella-tv';
const priceFrom = `${STELLA_AR.currency}${STELLA_AR.plans[0].price}`;
const { tv, mobile, legacyCodes, updatedLabel } = DOWNLOADS;

const faqItems = [
  {
    q: '¿Cuál es el código de Stella TV para Downloader?',
    a: `El código vigente para televisores es ${tv.downloaderCode} (Stella TV ${tv.version}). Para el celular hay un código alternativo, ${mobile.downloaderCode}, pero ahí alcanza con el APK directo.`,
  },
  {
    q: `¿Qué pasó con el código ${legacyCodes[0]}?`,
    a: `Es un código anterior que descargaba una versión vieja de la app. Hoy corresponde usar ${tv.downloaderCode} en televisores.`,
  },
  {
    q: '¿La app de Stella TV es gratis?',
    a: `La descarga es gratuita, pero para ver los canales necesitás un plan activo. Los planes arrancan en ${priceFrom} por mes y los contratás por WhatsApp con Oleada TV.`,
  },
  {
    q: '¿Necesito Downloader en el celular?',
    a: `No. En celulares y tablets Android descargás el APK directo (versión ${mobile.version}) y lo instalás como cualquier archivo.`,
  },
  {
    q: '¿Se puede instalar en Smart TV Samsung o LG?',
    a: 'No de forma nativa: Tizen (Samsung) y webOS (LG) no permiten instalar el APK. La solución es conectar por HDMI un Fire TV, un Google TV o un TV Box Android.',
  },
  {
    q: '¿Hay Stella TV para iPhone?',
    a: 'No. Stella TV funciona en Android (celular, tablet, Android TV, Google TV, Fire TV y TV Box). No hay versión para iPhone ni iPad.',
  },
  {
    q: '¿Cómo actualizo Stella TV?',
    a: 'Instalá la versión nueva con el código o el APK vigente de esta página; mantenemos la fecha de actualización arriba. Si la instalación falla, desinstalá la versión vieja y volvé a instalar.',
  },
];

const guides = [
  { href: '/', title: 'Stella TV en Argentina', desc: 'Planes, dispositivos compatibles y cómo contratar con Oleada TV.' },
  { href: '/precio-stella-tv', title: 'Precios en Argentina', desc: 'Los 4 planes en dólares y cómo pagar en pesos con Mercado Pago o transferencia.' },
];
---
<BaseLayout
  title={`Descargar e instalar Stella TV: código ${tv.downloaderCode} y APK actualizado`}
  description={`Instala Stella TV en Fire TV, Google TV, Android TV, TV Box y celular. Código Downloader vigente ${tv.downloaderCode} (reemplaza al ${legacyCodes[0]}) y APK ${tv.version} / ${mobile.version}.`}
  preloadHero={false}
  canonical={CANONICAL}
  country="AR"
  whatsapp={STELLA_AR.whatsapp}
  lang="es-AR"
  locale="es_AR"
  geoRegion="AR"
  geoPlacename="Argentina"
  alternates={installAlternates()}
  faqSchema={faqItems}
  breadcrumb={[
    { name: 'Inicio', url: 'https://ar.oleadatvplus.com/' },
    { name: 'Instalar Stella TV', url: CANONICAL },
  ]}
/>

<SellerNotice country="Argentina" voseo />
<Navbar
  whatsapp={STELLA_AR.whatsapp}
  waTag={TAG}
  links={[
    { href: '#descargas', label: 'Descargas' },
    { href: '#guia', label: 'Paso a paso' },
    { href: '#problemas', label: 'Problemas' },
    { href: '/precio-stella-tv', label: 'Precios' },
    { href: '/', label: 'Inicio' },
  ]}
/>

<main>
  <PageIntro
    eyebrow="Guía de instalación"
    title="Cómo descargar e instalar"
    titleEm="Stella TV"
    intro={`Código Downloader vigente, APK para TV y para celular, y el paso a paso para Fire TV, Google TV, Android TV y TV Box. Si ya tenés tu plan, en unos minutos lo dejás andando; si te trabás, te ayudamos por WhatsApp.`}
    updated={updatedLabel}
    facts={[
      { label: 'Código para TV', value: tv.downloaderCode },
      { label: 'Versión TV', value: tv.version },
      { label: 'Versión celular', value: mobile.version },
    ]}
    whatsapp={STELLA_AR.whatsapp}
    waTag={TAG}
    waText="Hola, quiero contratar Stella TV y que me ayuden a instalarlo."
    ctaLabel="Contratar y recibir ayuda"
    secondaryHref="#descargas"
    secondaryLabel="Ir a las descargas"
  />

  <Downloads
    whatsapp={STELLA_AR.whatsapp}
    waTag={TAG}
    voseo
    title="Descargas y <em>códigos actualizados</em>"
  />

  <InstallGuide whatsapp={STELLA_AR.whatsapp} waTag={TAG} voseo />

  <FAQ items={faqItems} />

  <RelatedGuides guides={guides} title="Seguí <em>leyendo</em>" />

  <CTAFinal
    whatsapp={STELLA_AR.whatsapp}
    waTag={TAG}
    currency={STELLA_AR.currency}
    monthlyOffer={STELLA_AR.plans[0].price}
    title="¿Todavía no tenés plan?"
    waText="Hola, quiero contratar Stella TV en Argentina."
    sub="Te confirmamos el importe en pesos y te ayudamos con la instalación"
  />
</main>

<Footer
  whatsapp={STELLA_AR.whatsapp}
  waTag={TAG}
  country="Argentina"
  sectionLinks={[
    { href: '#descargas', label: 'Descargas' },
    { href: '#guia', label: 'Paso a paso por equipo' },
    { href: '#problemas', label: 'Problemas frecuentes' },
    { href: '#faq', label: 'Preguntas frecuentes' },
  ]}
  pageLinks={[{ href: '/', label: 'Inicio' }, ...AR_FOOTER_PAGES.filter(l => l.href !== '/instalar-stella-tv')]}
  siteLinks={AR_SITE_LINKS}
/>

<WhatsAppFloat whatsapp={STELLA_AR.whatsapp} waTag={TAG} waText="Hola, necesito ayuda para instalar Stella TV." />

<StickyMobileCTA
  whatsapp={STELLA_AR.whatsapp}
  waTag={TAG}
  currency={STELLA_AR.currency}
  monthlyOffer={STELLA_AR.plans[0].price}
  waText="Hola, quiero contratar Stella TV en Argentina."
/>
