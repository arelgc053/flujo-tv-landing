---
// Todavía no hay reseñas públicas verificadas de clientes de Argentina — mismo
// criterio honesto aplicado en Ecuador/Perú para no fabricar nombres ni
// ciudades. En vez de dejar la sección vacía (mala señal de confianza), se
// referencia el historial real y verificado de la marca en otros países
// (4.8/5, +120 reseñas — confirmado por el cliente en Google para EC/PE) sin
// hacerlo pasar como propio de Argentina, y se invita a ser de los primeros.
interface Props {
  whatsapp: string;
  brand: string;
}
const { whatsapp, brand } = Astro.props;
const waLink = `https://wa.me/${whatsapp}?text=${encodeURIComponent(`Hola, quiero probar ${brand} en Argentina`)}`;
---
<section class="testimonials" id="testimonios">
  <div class="inner">
    <h2 class="section-title reveal">Recién <em>llegamos a Argentina</em></h2>
    <p class="section-sub reveal">Todavía no tenemos reseñas públicas de clientes argentinos — preferimos decirlo así antes que inventarlas</p>

    <div class="pending-testi reveal">
      <div class="pending-testi-icon" aria-hidden="true">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
      </div>
      <p class="pending-testi-text">
        <strong>{brand}</strong> ya tiene reseñas verificadas en Perú y Ecuador —
        <strong>4.8/5 con más de 120 reseñas</strong> confirmadas en Google.
        En Argentina recién estamos empezando, así que todavía no hay testimonios
        locales que mostrarte. Preferimos ser honestos con eso antes que mostrarte
        nombres inventados.
      </p>
      <p class="pending-testi-cta-text">¿Querés ser de los primeros en probarlo y contarnos tu experiencia?</p>
      <a href={waLink} target="_blank" rel="noopener noreferrer" class="btn-wa">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        Probarlo por WhatsApp
      </a>
    </div>
  </div>
</section>

<style>
  .pending-testi {
    max-width: 640px;
    margin: 0 auto;
    background: var(--glass-bg);
    backdrop-filter: var(--glass-blur);
    -webkit-backdrop-filter: var(--glass-blur);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-xl);
    padding: 42px 36px;
    text-align: center;
  }
  .pending-testi-icon {
    width: 58px;
    height: 58px;
    margin: 0 auto 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--orange);
    background: var(--orange-soft);
    border: 1px solid var(--orange-border);
    border-radius: 16px;
  }
  .pending-testi-text {
    font-size: 0.94rem;
    color: var(--text-muted);
    line-height: 1.72;
    margin-bottom: 24px;
  }
  .pending-testi-text strong { color: #fff; }
  .pending-testi-cta-text {
    font-size: 0.86rem;
    color: rgba(255,255,255,0.7);
    margin-bottom: 16px;
    font-weight: 600;
  }
  @media (max-width: 480px) {
    .pending-testi { padding: 32px 22px; }
  }
</style>
