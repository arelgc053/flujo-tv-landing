---
interface Props {
  testimonials?: {
    initials: string;
    gradient: string;
    name: string;
    city: string;
    plan: string;
    text: string;
  }[];
}

const defaultTestimonials = [
  { initials:'RT', gradient:'linear-gradient(135deg,#FF4500,#d93a00)',      name:'Rodrigo Tafur',     city:'Lima Norte',         plan:'Plan Anual',    text:'Causa, llevo casi un año con Oleada TV y no me ha fallado ni una vez. Lo instalé al toque en el TV Box y el soporte por WhatsApp me resolvió todo en minutos. Ya les pasé la voz a mis patas del barrio.' },
  { initials:'MV', gradient:'linear-gradient(135deg,#7B2FBE,#5B21B6)',      name:'Mónica Vásquez',    city:'Arequipa',            plan:'Plan Mensual',  text:'Antes me cobraban un platal por el cable y apenas había canales decentes pe. Ahora pago poquísimo y tengo de todo sin cortes. El soporte me atendió al toque y sin ningún roche. Bravazo.' },
  { initials:'JQ', gradient:'linear-gradient(135deg,#0ea5e9,#0284c7)',      name:'Javier Quispe',     city:'Trujillo',            plan:'Plan Anual',    text:'Los partidos en vivo se ven de la, sin lageos ni nada. Ya les recomendé a toda mi familia y a los del laburo. El precio está bacán pe, no hay drama. Fijo que lo renuevo cada año.' },
  { initials:'PM', gradient:'linear-gradient(135deg,#10b981,#059669)',      name:'Paola Mendoza',     city:'Cusco',               plan:'Plan Mensual',  text:'Yapié y en menos de cinco minutos ya estaba viendo mis series. Pensé que iba a ser complicado pero fue seco y frío. No esperaba que fuera tan fácil, re bacán el servicio pe.' },
  { initials:'LH', gradient:'linear-gradient(135deg,#f59e0b,#d97706)',      name:'Luis Huanca',       city:'Piura',               plan:'Plan Anual',    text:'Lo tengo en el Fire Stick y jala perfecto, ni un solo problema. El equipo siempre está mosca para cualquier consulta y responden al toque. Vale cada sol causa, no lo cambiaría.' },
  { initials:'XF', gradient:'linear-gradient(135deg,#ec4899,#db2777)',      name:'Ximena Flores',     city:'Lima — San Isidro',   plan:'Plan Anual',    text:'Al principio estaba palteada porque no sabía si era confiable, pero yapié y al toque me llegaron mis claves. Ya llevo cinco meses sin ningún problema. Está de la, fijo lo renuevo.' },
  { initials:'CB', gradient:'linear-gradient(135deg,#06b6d4,#0891b2)',      name:'Carlos Berrios',    city:'Iquitos',             plan:'Plan Mensual',  text:'Por acá en Iquitos no había opciones buenas pe, todo caro o pésimo. Con Oleada TV tengo de todo sin pagar los precios abusivos del cable. Bravazo el servicio causa, lo recomiendo.' },
  { initials:'SR', gradient:'linear-gradient(135deg,#8b5cf6,#7c3aed)',      name:'Sandra Ríos',       city:'Huancayo',            plan:'Plan Anual',    text:'Mis hijos ven sus series y yo los partidos sin jalarnos los cabellos por el precio pe. El soporte siempre está cuando uno los necesita. De lo mejor que he contratado para el jato.' },
];

const { testimonials = defaultTestimonials } = Astro.props;
---
<section class="testimonials" id="testimonios">
  <div class="inner">
    <h2 class="section-title reveal">Lo que dicen <em>nuestros clientes</em></h2>
    <p class="section-sub reveal">Más de 5,000 usuarios activos en todo el Perú</p>

    <div class="testi-grid">
      {testimonials.map(t => (
        <article class="testi-card reveal">
          <div class="testi-header">
            <div class="testi-avatar" style={`background:${t.gradient};`} aria-hidden="true">{t.initials}</div>
            <div>
              <p class="testi-name">{t.name}</p>
              <p class="testi-city">{t.city}</p>
            </div>
          </div>
          <div class="testi-stars" aria-label="5 estrellas">
            {Array.from({length:5}).map(() => (
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
              </svg>
            ))}
          </div>
          <span class="testi-plan">{t.plan}</span>
          <p class="testi-text">"{t.text}"</p>
        </article>
      ))}
    </div>
  </div>
</section>
