---
interface Props {
  title?: string;
  subtitle?: string;
  testimonials?: {
    initials: string;
    gradient: string;
    name: string;
    city: string;
    plan: string;
    text: string;
  }[];
}

const defaultTestimonials = [
  { initials:'RT', gradient:'linear-gradient(135deg,#FF4500,#d93a00)', name:'Ricardo Tapia',   city:'Quito Norte',    plan:'Plan Anual',   text:'Llevo casi un año con Oleada TV y no me ha fallado ni una vez. Lo instalé sin problema en el TV Box y el soporte por WhatsApp me resolvió todo en minutos. Ya les conté a todos mis amigos y están encantados.' },
  { initials:'MV', gradient:'linear-gradient(135deg,#7B2FBE,#5B21B6)', name:'Mónica Villacís', city:'Guayaquil',      plan:'Plan Mensual', text:'Antes pagaba demasiado por el cable y los canales eran muy limitados. Ahora pago muy poco y tengo de todo sin interrupciones. El soporte me atendió enseguida y sin ningún inconveniente. Excelente servicio.' },
  { initials:'JQ', gradient:'linear-gradient(135deg,#0ea5e9,#0284c7)', name:'Javier Quiroz',   city:'Cuenca',         plan:'Plan Anual',   text:'Los partidos en vivo se ven muy bien, sin cortes ni nada. Ya les recomendé a toda mi familia y a los del trabajo. El precio es muy accesible, no hay de qué quejarse. Seguro lo renuevo cada año.' },
  { initials:'PM', gradient:'linear-gradient(135deg,#10b981,#059669)', name:'Paola Morales',   city:'Ambato',         plan:'Plan Mensual', text:'Hice la transferencia y en menos de cinco minutos ya estaba viendo mis series. Pensé que iba a ser complicado pero fue muy sencillo. No esperaba que fuera tan fácil de activar, muy buen servicio.' },
  { initials:'LH', gradient:'linear-gradient(135deg,#f59e0b,#d97706)', name:'Luis Herrera',    city:'Manta',          plan:'Plan Anual',   text:'Lo tengo en el Fire Stick y funciona perfecto, ni un solo problema. El equipo siempre está disponible para cualquier consulta y responden muy rápido. Vale cada centavo, no lo cambiaría por nada.' },
  { initials:'XF', gradient:'linear-gradient(135deg,#ec4899,#db2777)', name:'Ximena Freire',   city:'Quito — Cumbayá',plan:'Plan Anual',   text:'Al principio dudaba porque no sabía si era confiable, pero hice el pago y enseguida me llegaron mis credenciales. Ya llevo cinco meses sin ningún problema. Muy satisfecha, definitivamente lo renuevo.' },
  { initials:'CB', gradient:'linear-gradient(135deg,#06b6d4,#0891b2)', name:'Carlos Benítez',  city:'Santo Domingo',  plan:'Plan Mensual', text:'Por acá no había opciones buenas, todo caro o de mala calidad. Con Oleada TV tengo de todo sin pagar los precios exagerados del cable. Excelente servicio, lo recomiendo a todo el mundo sin pensarlo.' },
  { initials:'SR', gradient:'linear-gradient(135deg,#8b5cf6,#7c3aed)', name:'Sandra Romero',   city:'Loja',           plan:'Plan Anual',   text:'Mis hijos ven sus series y yo los partidos sin discutir por el precio. El soporte siempre está cuando uno lo necesita. De lo mejor que he contratado para el hogar, muy recomendado.' },
];

const {
  title = 'Lo que dicen <em>nuestros clientes</em>',
  subtitle = 'Más de 5,000 usuarios activos en todo el Ecuador',
  testimonials = defaultTestimonials,
} = Astro.props;
---
<section class="testimonials" id="testimonios">
  <div class="inner">
    <h2 class="section-title reveal" set:html={title}></h2>
    <p class="section-sub reveal">{subtitle}</p>

    <div class="testi-grid">
      {testimonials.map(t => (
        <article class="testi-card reveal">
          <div class="testi-header">
            <div class="testi-avatar" style={`background:${t.gradient};`} aria-hidden="true">{t.initials}</div>
            <div>
              <p class="testi-name">{t.name}</p>
              <p class="testi-city">{t.city}</p>
            </div>
          </div>
          <div class="testi-stars" aria-label="5 estrellas">
            {Array.from({length:5}).map(() => (
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
              </svg>
            ))}
          </div>
          <span class="testi-plan">{t.plan}</span>
          <p class="testi-text">"{t.text}"</p>
        </article>
      ))}
    </div>
  </div>
</section>
