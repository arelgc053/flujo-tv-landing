---
interface Props {
  title?: string;
  subtitle?: string;
  testimonials?: {
    initials: string;
    gradient: string;
    name: string;
    city: string;
    plan: string;
    text: string;
  }[];
}

// Fallback genérico — en la práctica cada página (PE y EC) pasa su propio array
// `testimonials`, así que este default no se renderiza. Se mantiene sin nombres,
// ciudades ni cifras reales para no dar la impresión de un testimonio verificado.
const defaultTestimonials = [
  { initials:'?', gradient:'linear-gradient(135deg,#7B2FBE,#5B21B6)', name:'Cliente',   city:'—',  plan:'—', text:'Testimonio pendiente de configurar para esta página.' },
];

const {
  title = 'Lo que dicen <em>nuestros clientes</em>',
  subtitle = 'Historias reales de quienes ya lo usan',
  testimonials = defaultTestimonials,
} = Astro.props;
---
<section class="testimonials" id="testimonios">
  <div class="inner">
    <h2 class="section-title reveal" set:html={title}></h2>
    <p class="section-sub reveal">{subtitle}</p>

    <div class="testi-grid">
      {testimonials.map(t => (
        <article class="testi-card reveal">
          <div class="testi-header">
            <div class="testi-avatar" style={`background:${t.gradient};`} aria-hidden="true">{t.initials}</div>
            <div>
              <p class="testi-name">{t.name}</p>
              <p class="testi-city">{t.city}</p>
            </div>
          </div>
          <div class="testi-stars" aria-label="5 estrellas">
            {Array.from({length:5}).map(() => (
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
              </svg>
            ))}
          </div>
          <span class="testi-plan">{t.plan}</span>
          <p class="testi-text">"{t.text}"</p>
        </article>
      ))}
    </div>
  </div>
</section>
