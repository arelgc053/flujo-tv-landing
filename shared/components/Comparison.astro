---
interface Props { currency: string; monthlyOffer: string; brand?: string; }
const { currency, monthlyOffer, brand = 'Nosotros' } = Astro.props;

const rows = [
  { label: 'Precio mensual',     service: `${currency} ${monthlyOffer}`, cable: 'Desde S/ 80', ok: true },
  { label: 'Contrato mínimo',    service: 'Sin permanencia',  cable: '12 a 24 meses',       ok: true },
  { label: 'Instalación',        service: 'Online, inmediata', cable: 'Técnico en casa',    ok: true },
  { label: 'Dispositivos',       service: 'TV, celular, tablet', cable: 'Solo TV principal', ok: true },
  { label: 'Método de pago',     service: 'Yape / Plin',      cable: 'Factura mensual fija', ok: true },
  { label: 'Activación',         service: 'En 5 minutos',     cable: '3 a 5 días hábiles',  ok: true },
  { label: 'Soporte',            service: 'WhatsApp 24/7',    cable: 'Call center limitado', ok: true },
];

const yes = `<svg class="icon-yes" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>`;
const no  = `<svg class="icon-no"  width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>`;
---
<section class="comparison" id="comparativa">
  <div class="inner">
    <h2 class="section-title reveal">Por qué elegir <em>{brand}</em></h2>
    <p class="section-sub reveal">Compara y decide tú mismo</p>

    <div class="compare-table reveal" role="table" aria-label={`Comparativa ${brand} vs Cable`}>
      <div class="compare-head" role="row">
        <div role="columnheader">Característica</div>
        <div role="columnheader">{brand}</div>
        <div role="columnheader">Cable Tradicional</div>
      </div>
      {rows.map(row => (
        <div class="compare-row" role="row">
          <div role="cell">{row.label}</div>
          <div role="cell"><Fragment set:html={yes} />{row.service}</div>
          <div role="cell"><Fragment set:html={no}  />{row.cable}</div>
        </div>
      ))}
    </div>
  </div>
</section>
