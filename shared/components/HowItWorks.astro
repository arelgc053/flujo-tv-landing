---
const steps = [
  {
    step: '01',
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>`,
    title: 'Elige tu plan',
    desc: 'Escríbenos por WhatsApp, elige el plan que más te conviene y te asesoramos sin ningún compromiso.',
  },
  {
    step: '02',
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="4" width="22" height="16" rx="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>`,
    title: 'Paga con Yape o Plin',
    desc: 'Transfiere en segundos desde tu celular. Aceptamos Yape, Plin y transferencias bancarias. 100% seguro.',
  },
  {
    step: '03',
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="5 3 19 12 5 21 5 3"/></svg>`,
    title: 'Empieza a disfrutar',
    desc: 'Recibe tu acceso al instante. Nuestro equipo te guía paso a paso en la instalación en menos de 5 minutos.',
  },
];
---
<section class="how" id="ventajas">
  <div class="inner">
    <h2 class="section-title reveal">Así de <em>simple</em> funciona</h2>
    <p class="section-sub reveal">Tres pasos y estás disfrutando hoy mismo</p>

    <div class="how-grid">
      {steps.map(s => (
        <div class="how-card reveal" data-step={s.step}>
          <div class="how-icon" aria-hidden="true">
            <Fragment set:html={s.icon} />
          </div>
          <h4>{s.title}</h4>
          <p>{s.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>
