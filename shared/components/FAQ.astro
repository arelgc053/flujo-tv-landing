---
interface Props {
  items?: { q: string; a: string }[];
}

// Fallback genérico — en la práctica cada página (PE y EC) pasa su propio array
// `items`, así que este default no se renderiza. Se mantiene sin nombre de marca
// para que ningún caller futuro muestre contenido de otro país o marca por error.
const defaultItems = [
  {
    q: '¿Qué necesito para activar mi servicio?',
    a: 'Solo necesitas un dispositivo Android (TV Box, celular, tablet o Fire Stick) y conexión a internet. Tras confirmar tu pago te enviamos tus credenciales de acceso en minutos.',
  },
  {
    q: '¿Cuánto tiempo tarda la activación?',
    a: 'La activación es prácticamente inmediata. En promedio, los clientes reciben sus credenciales en menos de 5 minutos tras confirmar el pago.',
  },
  {
    q: '¿Hay contratos o permanencia?',
    a: 'No. Puedes elegir el plan que prefieras sin ningún compromiso de permanencia. Renuevas cuando tú decides.',
  },
  {
    q: '¿Qué pasa si tengo problemas técnicos?',
    a: 'Contamos con soporte técnico por WhatsApp disponible todos los días.',
  },
];

const { items = defaultItems } = Astro.props;
---
<section class="faq" id="faq">
  <div class="inner">
    <h2 class="section-title reveal">Preguntas <em>frecuentes</em></h2>
    <p class="section-sub reveal">Todo lo que necesitas saber antes de activar</p>

    <div class="faq-list">
      {items.map((item, i) => (
        <details class="faq-item reveal" name="faq-group">
          <summary class="faq-question" aria-expanded="false">
            <span class="faq-num">0{i + 1}</span>
            <span>{item.q}</span>
            <svg class="faq-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
          </summary>
          <p class="faq-answer">{item.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLDetailsElement>('.faq-item').forEach(details => {
    details.addEventListener('toggle', () => {
      const summary = details.querySelector('summary');
      if (summary) summary.setAttribute('aria-expanded', details.open ? 'true' : 'false');
    });
  });
</script>
