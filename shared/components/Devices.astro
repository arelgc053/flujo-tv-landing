---
interface Device {
  icon?: string;
  title: string;
  desc: string;
}

interface Props {
  title?: string;
  subtitle?: string;
  devices?: Device[];
  note?: string;
}

const devices = [
  {
    icon:`<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>`,
    title:'Android TV / TV Box',
    desc:'Compatible con cualquier dispositivo Android TV o TV Box. Instalación asistida por WhatsApp.',
  },
  {
    icon:`<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="2" width="14" height="20" rx="2"/><line x1="12" y1="18" x2="12.01" y2="18"/></svg>`,
    title:'Celulares Android',
    desc:'Lleva todo el contenido en tu bolsillo. Compatible con todos los smartphones Android.',
  },
  {
    icon:`<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="2" width="16" height="20" rx="2"/><line x1="12" y1="18" x2="12.01" y2="18"/></svg>`,
    title:'Tablets Android',
    desc:'Disfruta en pantalla grande. Ideal para el hogar, la cocina o los viajes.',
  },
  {
    icon:`<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="15" rx="2"/><polyline points="17 2 12 7 7 2"/></svg>`,
    title:'Amazon Fire Stick',
    desc:'Instala con el código Downloader de Oleada TV en segundos. Transforma tu TV al instante.',
  },
];

const {
  title = 'Compatible con <em>tus dispositivos</em>',
  subtitle = 'Una cuenta, el dispositivo que tú elijas',
  devices: customDevices = devices,
  note = 'Para Smart TV Samsung o LG antiguo se requiere TV Box externo. Nuestro equipo te asesora.',
} = Astro.props;
---
<section class="devices" id="dispositivos">
  <div class="inner">
    <h2 class="section-title reveal" set:html={title}></h2>
    <p class="section-sub reveal">{subtitle}</p>

    <div class="devices-grid">
      {customDevices.map((d, i) => (
        <div class="device-card reveal">
          <div class="device-icon" aria-hidden="true">
            <Fragment set:html={d.icon ?? devices[i]?.icon ?? devices[0].icon} />
          </div>
          <h4>{d.title}</h4>
          <p>{d.desc}</p>
        </div>
      ))}
    </div>

    <p class="plans-note reveal" style="margin-top:2rem;">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
      {note}
    </p>
  </div>
</section>
