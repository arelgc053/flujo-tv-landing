---
import '@shared/styles/global.css';
import ClickTracking from '../components/ClickTracking.astro';
import { PRODUCT_NAME, SELLER_NAME } from '../data/stella';

// Identidades (nov 2026):
//   - El SITIO y la ORGANIZACIÓN son Oleada TV (quien vende y atiende).
//   - El PRODUCTO es Stella TV (Product.brand), vendido por Oleada TV (Offer.seller).
// Así el sitio no se presenta como la web oficial de Stella.
//
// Sin aggregateRating: las calificaciones de Google Maps/terceros no se pueden
// marcar en el propio sitio (política de fragmentos de reseña de Google).
// Sin LocalBusiness: no hay dirección física publicada, que ese tipo requiere.

interface ProductSchema {
  name: string;
  description: string;
  price: string;
  priceCurrency: string;
  availability?: string;
}

interface OrganizationInfo {
  telephone: string;
  areaServed: string[];
  paymentAccepted?: string;
}

interface Props {
  title: string;
  description: string;
  keywords?: string;
  canonical: string;
  /** Nombre del producto (para compatibilidad con llamadas existentes). */
  brand?: string;
  siteName?: string;
  country: 'PE' | 'AR' | 'EC';
  whatsapp?: string;
  themeColor?: string;
  lang?: string;
  locale?: string;
  geoRegion?: string;
  geoPlacename?: string;
  geoPosition?: string;
  alternates?: { hreflang: string; href: string }[];
  faqSchema?: { q: string; a: string }[];
  productSchema?: ProductSchema | null;
  organization?: OrganizationInfo | null;
  breadcrumb?: { name: string; url: string }[];
  noindex?: boolean;
  /** false en páginas sin hero de imagen (evita descargar una imagen que no se usa). */
  preloadHero?: boolean;
}

const {
  title,
  description,
  keywords,
  canonical,
  brand = PRODUCT_NAME,
  siteName = SELLER_NAME,
  country,
  whatsapp,
  themeColor = '#FF4500',
  lang = 'es',
  locale = 'es_PE',
  geoRegion = 'PE',
  geoPlacename,
  geoPosition,
  alternates = [],
  faqSchema = [],
  productSchema = null,
  organization = null,
  breadcrumb = [],
  noindex = false,
  preloadHero = true,
} = Astro.props;

const siteRoot = new URL('/', Astro.site).href;
const ogImage = new URL('/img/og-oleada.png', Astro.site).href;
const OG_IMAGE_WIDTH = 1200;
const OG_IMAGE_HEIGHT = 630;
// Imagen del producto (logo de Stella TV) — solo para el Product, no para la identidad del sitio.
const productImage = new URL('/img/og-image.png', Astro.site).href;
const sellerLogo = new URL('/img/oleada-180.png', Astro.site).href;
const telephone = organization?.telephone ?? (whatsapp ? `+${whatsapp}` : undefined);

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: siteName,
  url: siteRoot,
  inLanguage: lang,
};

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: siteName,
  url: siteRoot,
  logo: sellerLogo,
  description: `${siteName} comercializa ${PRODUCT_NAME}: contratación, pago y soporte por WhatsApp.`,
  ...(organization && {
    areaServed: organization.areaServed.map(name => ({ '@type': 'AdministrativeArea', name })),
  }),
  ...(telephone && {
    contactPoint: {
      '@type': 'ContactPoint',
      telephone,
      contactType: 'sales',
      availableLanguage: 'Spanish',
    },
  }),
};

const faqSchemaFull = faqSchema.length > 0
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqSchema.map(({ q, a }) => ({
        '@type': 'Question',
        name: q,
        acceptedAnswer: { '@type': 'Answer', text: a },
      })),
    }
  : null;

const productSchemaFull = productSchema
  ? {
      '@context': 'https://schema.org',
      '@type': 'Product',
      name: productSchema.name,
      description: productSchema.description,
      image: productImage,
      brand: { '@type': 'Brand', name: brand },
      offers: {
        '@type': 'Offer',
        url: canonical,
        priceCurrency: productSchema.priceCurrency,
        price: productSchema.price,
        availability: productSchema.availability ?? 'https://schema.org/InStock',
        seller: { '@type': 'Organization', name: siteName, url: siteRoot },
      },
    }
  : null;

const breadcrumbSchema = breadcrumb.length > 0
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: breadcrumb.map((item, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: item.name,
        item: item.url,
      })),
    }
  : null;
---
<!DOCTYPE html>
<html lang={lang} data-country={country}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'} />
  <meta name="author" content={siteName} />
  <meta name="theme-color" content={themeColor} />
  <title>{title}</title>
  <meta name="description" content={description} />
  {keywords && <meta name="keywords" content={keywords} />}
  <link rel="canonical" href={canonical} />
  {alternates.map(a => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}

  <!-- Geo -->
  <meta name="geo.region" content={geoRegion} />
  {geoPlacename && <meta name="geo.placename" content={geoPlacename} />}
  {geoPosition && <meta name="geo.position" content={geoPosition} />}

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content={String(OG_IMAGE_WIDTH)} />
  <meta property="og:image:height" content={String(OG_IMAGE_HEIGHT)} />
  <meta property="og:image:alt" content={`${siteName} — ${PRODUCT_NAME}`} />
  <meta property="og:locale" content={locale} />
  <meta property="og:site_name" content={siteName} />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <!-- Favicon (identidad Oleada TV) -->
  <link rel="icon" type="image/png" sizes="32x32" href="/img/oleada-32.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/img/oleada-180.png" />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@400;600;700;900&family=Barlow:wght@400;500;600&display=swap" rel="stylesheet" />

  <!-- Hero preload: variante liviana en móvil (LCP). Solo en páginas con hero de imagen. -->
  {preloadHero && <link rel="preload" as="image" href="/img/hero-m.webp" media="(max-width: 768px)" fetchpriority="high" />}
  {preloadHero && <link rel="preload" as="image" href="/img/hero.webp" media="(min-width: 769px)" fetchpriority="high" />}

  <!-- Schema.org -->
  <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
  {faqSchemaFull && (
    <script type="application/ld+json" set:html={JSON.stringify(faqSchemaFull)} />
  )}
  {productSchemaFull && (
    <script type="application/ld+json" set:html={JSON.stringify(productSchemaFull)} />
  )}
  {breadcrumbSchema && (
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  )}
</head>
<body>
  <slot />

  <ClickTracking country={country} />

  <script>
    // Scroll reveal
    const revealEls = document.querySelectorAll<HTMLElement>('.reveal');
    const observer = new IntersectionObserver(
      (entries) => entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('visible'); observer.unobserve(e.target); } }),
      { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
    );
    revealEls.forEach(el => observer.observe(el));

    // WhatsApp float button visibility
    const waFloat = document.querySelector<HTMLElement>('.wa-float');
    if (waFloat) {
      window.addEventListener('scroll', () => {
        waFloat.classList.toggle('show', window.scrollY > 400);
      }, { passive: true });
    }
  </script>
</body>
</html>
