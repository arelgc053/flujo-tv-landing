---
import '@shared/styles/global.css';

interface Props {
  title: string;
  description: string;
  keywords: string;
  canonical: string;
  lang?: string;
  locale?: string;
  geoRegion?: string;
  faqSchema?: { q: string; a: string }[];
}

const {
  title,
  description,
  keywords,
  canonical,
  lang = 'es-PE',
  locale = 'es_PE',
  geoRegion = 'PE',
  faqSchema = [],
} = Astro.props;

const ogImage = new URL('/img/hero.webp', Astro.site).href;
const logoUrl  = new URL('/img/logo.png', Astro.site).href;

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Oleada TV',
  url: canonical,
  logo: logoUrl,
  description: 'Plataforma de entretenimiento digital premium. Deportes en vivo, cine y series en HD y 4K para Latinoamérica.',
  contactPoint: {
    '@type': 'ContactPoint',
    telephone: '+51940405911',
    contactType: 'customer service',
    availableLanguage: 'Spanish',
  },
};

const faqSchemaFull = faqSchema.length > 0
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqSchema.map(({ q, a }) => ({
        '@type': 'Question',
        name: q,
        acceptedAnswer: { '@type': 'Answer', text: a },
      })),
    }
  : null;
---
<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="index, follow" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="keywords" content={keywords} />
  <link rel="canonical" href={canonical} />
  <meta name="geo.region" content={geoRegion} />
  <meta name="language" content="Spanish" />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:locale" content={locale} />
  <meta property="og:site_name" content="Oleada TV" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <!-- Favicon -->
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="apple-touch-icon" href="/favicon.png" />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@400;600;700;900&family=Barlow:wght@400;500;600&display=swap" rel="stylesheet" />

  <!-- Hero preload -->
  <link rel="preload" as="image" href="/img/hero.webp" fetchpriority="high" />

  <!-- Schema.org -->
  <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
  {faqSchemaFull && (
    <script type="application/ld+json" set:html={JSON.stringify(faqSchemaFull)} />
  )}
</head>
<body>
  <slot />

  <script>
    // Scroll reveal
    const revealEls = document.querySelectorAll<HTMLElement>('.reveal');
    const observer = new IntersectionObserver(
      (entries) => entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('visible'); observer.unobserve(e.target); } }),
      { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
    );
    revealEls.forEach(el => observer.observe(el));

    // WhatsApp float button visibility
    const waFloat = document.querySelector<HTMLElement>('.wa-float');
    if (waFloat) {
      window.addEventListener('scroll', () => {
        waFloat.classList.toggle('show', window.scrollY > 400);
      }, { passive: true });
    }
  </script>
</body>
</html>
